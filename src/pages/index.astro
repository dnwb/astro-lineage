---
import ProductBoundary from "../copy/product-boundary.md";
import { loadCanonicalContent } from "../../scripts/content-loader.mjs";
import { projectVisibleLearningPaths } from "../../scripts/reader-projection.mjs";
import { loadSiteConfig } from "../lib/site-config";
import "../styles/global.css";

const site = loadSiteConfig();
const snapshot = await loadCanonicalContent("content");
const learningPaths = projectVisibleLearningPaths(snapshot);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="A scientific reading and knowledge-navigation system for high-energy transient astrophysics."
    />
    <title>{site.title}</title>
  </head>
  <body>
    <main>
      <p class="eyebrow">{site.eyebrow}</p>
      <h1>{site.title}</h1>
      <ProductBoundary />
      <p><a class="browse-link" href="/papers">Browse the curated Papers</a></p>
      <section>
        <h2>Learning Paths</h2>
        {learningPaths.length === 0 ? (
          <p class="empty-state">No Learning Paths are visible in the curated reading radar yet.</p>
        ) : (
          <ul class="paper-list">
            {learningPaths.map((path) => (
              <li><a href={`/learning-paths/${path.path_id}/`}>{path.title ?? path.path_id}</a></li>
            ))}
          </ul>
        )}
      </section>
      <p class="status">Implementation frontier: repository foundation.</p>
    </main>
  </body>
</html>
