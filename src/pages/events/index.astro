  }
  .cal-cell {
    aspect-ratio: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-radius: 0.4rem;
    text-decoration: none;
    position: relative;
    padding: 0.2rem;
    box-sizing: border-box;
  }
  .cal-cell-empty {
    visibility: hidden;
  }
  .cal-cell-idle {
    background: #ffffff;
    border: 1px solid #f1f5f9;
    color: #94a3b8;
  }
  .day-num {
    font-size: 0.8rem;
    font-family: ui-monospace, monospace;
  }
  .cal-cell-active {
    background: #eff6ff;
    border: 1.5px solid #3b82f6;
    color: #1d4ed8;
    box-shadow: 0 1px 3px rgba(59, 130, 246, 0.2);
    cursor: pointer;
    transition: transform 0.15s ease, background 0.15s ease;
  }
  .cal-cell-active:hover {
    transform: translateY(-2px);
    background: #dbeafe;
    border-color: #2563eb;
  }
  .day-num-active {
    font-size: 0.85rem;
    font-weight: 800;
    font-family: ui-monospace, monospace;
    color: #1e3a8a;
  }
  .cal-active-badge {
    font-size: 0.65rem;
    font-weight: 700;
    color: #2563eb;
    margin-top: -0.1rem;
  }
  .cal-dots-row {
    display: flex;
    gap: 0.15rem;
    margin-top: 0.15rem;
  }
  .cal-mini-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
  }

  /* Calendar Cell Hover Popover */
  .cal-cell-popover {
    display: none;
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
    background: #0f172a;
    color: #f8fafc;
    border: 1px solid #334155;
    border-radius: 0.5rem;
    padding: 0.5rem 0.65rem;
    box-shadow: 0 10px 25px -3px rgba(0, 0, 0, 0.4);
    z-index: 100;
    pointer-events: none;
    white-space: nowrap;
    min-width: 130px;
    max-width: 240px;
    text-align: left;
  }
  .cal-cell-popover::after {
    content: "";
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    border-width: 5px;
    border-style: solid;
    border-color: #0f172a transparent transparent transparent;
  }
  .cal-cell-active:hover .cal-cell-popover {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .popover-title {
    font-size: 0.72rem;
    color: #94a3b8;
    border-bottom: 1px solid #334155;
    padding-bottom: 0.25rem;
    margin-bottom: 0.1rem;
    font-weight: 700;
  }
  .popover-event-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .popover-event-item {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.76rem;
  }
  .popover-type-badge {
    font-size: 0.65rem;
    font-weight: 700;
    padding: 0.05rem 0.3rem;
    border-radius: 0.2rem;
  }
  .popover-event-name {
    font-weight: 700;
    color: #ffffff;
    font-size: 0.78rem;
  }

  /* Calendar Hot Events Fold */
  .calendar-hot-events-section {
    margin: 1.5rem 0 2rem;
  }
  .calendar-hot-events-fold {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 0.75rem;
    overflow: hidden;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.03);
    transition: border-color 0.15s ease;
  }
  .calendar-hot-events-fold[open] {
    border-color: #cbd5e1;
  }
  .calendar-hot-events-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.85rem 1.25rem;
    cursor: pointer;
    background: #f8fafc;
    user-select: none;
    font-weight: 700;
    color: #1e293b;
    transition: background 0.15s ease;
  }
  .calendar-hot-events-summary:hover {
    background: #f1f5f9;
  }
  .summary-left {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .summary-icon {
    font-size: 1.1rem;
  }
  .summary-title {
    font-size: 0.95rem;
    font-weight: 700;
  }
  .summary-hint {
    font-size: 0.78rem;
    color: #64748b;
  }
  .calendar-hot-events-body {
    padding: 1.25rem;
    border-top: 1px solid #e2e8f0;
    background: #ffffff;
  }
  .hot-events-note {
    font-size: 0.82rem;
    color: #64748b;
    margin: 0 0 1rem;
  }
  .agent-events-list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .agent-event-row {
    display: flex;
    gap: 1rem;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 0.5rem;
    padding: 1rem;
    align-items: flex-start;
  }
  .event-rank {
    font-size: 1.25rem;
    font-weight: 800;
    color: #94a3b8;
    min-width: 2rem;
    line-height: 1.2;
  }
  .event-info {
    flex-grow: 1;
    min-width: 0;
  }
  .event-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-bottom: 0.3rem;
  }
  .event-id {
    font-size: 1.05rem;
    font-weight: 700;
    color: #0f172a;
  }
  .event-heat {
    font-size: 0.82rem;
    font-weight: 700;
    color: #ea580c;
  }
  .event-papers-count {
    font-size: 0.78rem;
    color: #64748b;
  }
  .event-meta {
    font-size: 0.78rem;
    color: #64748b;
    margin-bottom: 0.6rem;
  }
  .event-papers {
    margin: 0;
    padding-left: 1.2rem;
    font-size: 0.85rem;
  }
  .event-papers li {
    margin-bottom: 0.3rem;
    line-height: 1.45;
  }
  .p-title {
    margin-left: 0.35rem;
    color: #334155;
  }

  /* Timeline Axis Header */
  .timeline-axis-header {
    margin-bottom: 1.75rem;
  }
  .axis-kicker {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #2563eb;
  }
  .timeline-axis-header h2 {
    margin: 0.25rem 0 0.4rem;
    font-size: 1.35rem;
    font-weight: 800;
    color: #0f172a;
  }
  .timeline-axis-header p {
    margin: 0;
    font-size: 0.9rem;
    color: #64748b;
  }

  /* Chronological Timeline Track & Spine */
  .timeline-track {
    position: relative;
    padding-left: 2.25rem;
  }
  .timeline-track::before {
    content: "";
    position: absolute;
    left: 0.75rem;
    top: 0.5rem;
    bottom: 1rem;
    width: 3px;
    background: linear-gradient(180deg, #3b82f6 0%, #60a5fa 35%, #93c5fd 70%, #cbd5e1 100%);
    border-radius: 2px;
  }

  /* Timeline Station */
  .timeline-station {
    position: relative;
    margin-bottom: 2.5rem;
  }
  .station-marker-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  @keyframes pulse-ring {
    0% { box-shadow: 0 0 0 0 rgba(37, 99, 235, 0.45); }
    70% { box-shadow: 0 0 0 8px rgba(37, 99, 235, 0); }
    100% { box-shadow: 0 0 0 0 rgba(37, 99, 235, 0); }
  }
  @keyframes pulse-ring-purple {
    0% { box-shadow: 0 0 0 0 rgba(124, 58, 237, 0.45); }
    70% { box-shadow: 0 0 0 8px rgba(124, 58, 237, 0); }
    100% { box-shadow: 0 0 0 0 rgba(124, 58, 237, 0); }
  }
  @keyframes cardFadeIn {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .station-pulse-node {
    position: absolute;
    left: calc(-2.25rem + 0.75rem - 7px);
    width: 17px;
    height: 17px;
    border-radius: 50%;
    background: #2563eb;
    border: 3px solid #ffffff;
    box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.25);
    animation: pulse-ring 2.5s infinite cubic-bezier(0.4, 0, 0.6, 1);
  }
  .node-epoch {
    background: #7c3aed;
    animation: pulse-ring-purple 2.5s infinite cubic-bezier(0.4, 0, 0.6, 1);
  }
  .station-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.35rem 0.85rem;
    background: #eff6ff;
    border: 1px solid #bfdbfe;
    border-radius: 9999px;
    flex-wrap: wrap;
  }
  .badge-epoch {
    background: #f5f3ff;
    border-color: #ddd6fe;
  }
  .station-bjt-date {
    font-size: 0.88rem;
    font-weight: 700;
    color: #1e3a8a;
  }
  .station-epoch-title {
    font-size: 0.92rem;
    font-weight: 800;
    color: #5b21b6;
  }
  .epoch-badge-pill {
    font-size: 0.72rem;
    font-weight: 700;
    color: #7c3aed;
    background: #ffffff;
    padding: 0.08rem 0.4rem;
    border-radius: 0.25rem;
    border: 1px solid #c4b5fd;
  }
  .epoch-desc-lead {
    margin: -0.35rem 0 1rem 0;
    font-size: 0.85rem;
    color: #64748b;
  }
  .station-us-date {
    font-size: 0.78rem;
    color: #64748b;
  }
  .station-count-pill {
    font-size: 0.75rem;
    font-weight: 600;
    color: #166534;
    background: #dcfce7;
    padding: 0.08rem 0.45rem;
    border-radius: 9999px;
  }

  /* Station Cards Stream */
  .station-cards-stream {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .timeline-event-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 0.75rem;
    padding: 1.35rem 1.5rem;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.03);
    position: relative;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .timeline-event-card:hover {
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.06);
    transform: translateY(-1px);
  }

  .card-top-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 0.65rem;
  }
  .card-id-cluster {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
  }
  .card-event-name {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 800;
    color: #0f172a;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: -0.01em;
  }
  .card-epoch-pill {
    font-size: 0.78rem;
    font-weight: 600;
    font-family: ui-monospace, monospace;
    color: #0369a1;
    background: #f0f9ff;
    border: 1px solid #bae6fd;
    padding: 0.15rem 0.5rem;
    border-radius: 0.3rem;
  }
  .card-metrics-cluster {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .metric-heat-chip {
    font-size: 0.82rem;
    font-weight: 700;
    color: #c2410c;
    background: #fff7ed;
    border: 1px solid #fed7aa;
    padding: 0.15rem 0.5rem;
    border-radius: 0.35rem;
  }
  .metric-papers-chip {
    font-size: 0.8rem;
    font-weight: 600;
    color: #475569;
    background: #f1f5f9;
    padding: 0.15rem 0.5rem;
    border-radius: 0.35rem;
  }

  .event-type-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.55rem;
    font-size: 0.75rem;
    font-weight: 700;
    border-radius: 0.35rem;
    letter-spacing: 0.04em;
  }
  .badge-gw { background: #e0e7ff; color: #3730a3; }
  .badge-grb { background: #fee2e2; color: #991b1b; }
  .badge-sn { background: #fef3c7; color: #92400e; }
  .badge-frb { background: #dbeafe; color: #1e40af; }
  .badge-at { background: #fae8ff; color: #86198f; }
  .badge-other { background: #f1f5f9; color: #475569; }

  /* Narrative */
  .card-narrative-block {
    margin-bottom: 1rem;
  }
  .card-headline {
    margin: 0 0 0.35rem;
    font-size: 1.02rem;
    font-weight: 700;
    color: #1e293b;
    line-height: 1.45;
  }
  .card-narrative-text {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.6;
    color: #475569;
  }

  /* Paper List */
  .card-papers-stream {
    border-top: 1px solid #f1f5f9;
    padding-top: 0.85rem;
  }
  .stream-label {
    font-size: 0.78rem;
    font-weight: 700;
    color: #64748b;
    margin-bottom: 0.5rem;
  }
  .station-paper-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .station-paper-item {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 0.5rem;
    padding: 0.75rem 1rem;
  }
  .paper-item-top {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    flex-wrap: wrap;
    margin-bottom: 0.3rem;
  }
  .priority-badge {
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.08rem 0.35rem;
    border-radius: 0.2rem;
    flex-shrink: 0;
  }
  .pill-must-read { background: #fee2e2; color: #b91c1c; }
  .pill-worth-knowing { background: #fef3c7; color: #b45309; }
  .pill-skim { background: #f1f5f9; color: #64748b; }

  .paper-title-anchor {
    font-size: 0.88rem;
    font-weight: 700;
    color: #1e3a8a;
    text-decoration: none;
    line-height: 1.4;
  }
  .paper-title-anchor:hover {
    text-decoration: underline;
    color: #2563eb;
  }
  .paper-arxiv-id {
    color: #2563eb;
  }
  .paper-date-pill {
    font-size: 0.75rem;
    color: #64748b;
  }
  .paper-bluf-row {
    margin: 0 0 0.45rem;
    font-size: 0.86rem;
    line-height: 1.65;
    color: #334155;
    background: #ffffff;
    padding: 0.5rem 0.85rem;
    border-radius: 0.35rem;
    border: 1px solid #e2e8f0;
    border-left: 3.5px solid #2563eb;
  }
  .bluf-key {
    color: #1d4ed8;
  }
  .paper-links-bar {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    font-size: 0.78rem;
  }
  .link-radar-deep {
    font-weight: 600;
    color: #166534;
    text-decoration: none;
  }
  .link-radar-deep:hover {
    text-decoration: underline;
  }
  .link-arxiv-origin {
    color: #64748b;
    text-decoration: none;
  }
  .link-arxiv-origin:hover {
    color: #2563eb;
    text-decoration: underline;
  }

  /* Responsive */
  @media (max-width: 860px) {
    .month-split-container {
      grid-template-columns: 1fr;
    }
    .calendar-side-pane {
      position: static;
    }
  }
  @media (max-width: 640px) {
    .timeline-track {
      padding-left: 1.75rem;
    }
    .timeline-track::before {
      left: 0.5rem;
    }
    .station-pulse-node {
      left: calc(-1.75rem + 0.5rem - 7px);
    }
  }

  /* Dark mode */
  :global(:is([data-theme="dark"], body:has(#site-theme-toggle:checked))) .controls-card {
    background: #1e293b;
    border-color: #334155;
  }
  :global(:is([data-theme="dark"], body:has(#site-theme-toggle:checked))) .control-label {
    color: #cbd5e1;
  }
  :global(:is([data-theme="dark"], body:has(#site-theme-toggle:checked))) .view-pill,
  :global(:is([data-theme="dark"], body:has(#site-theme-toggle:checked))) .cat-pill {
    background: #0f172a;
    border-color: #334155;
    color: #cbd5e1;
  }
  :global(:is([data-theme="dark"], body:has(#site-theme-toggle:checked))) .calendar-matrix-section {
