---
import ReadingProse from "../../components/ReadingProse.astro";
import { loadCanonicalContent } from "../../../scripts/content-loader.mjs";
import { projectResearchLineForReader } from "../../../scripts/reader-projection.mjs";
import "../../styles/global.css";

type AnyRecord = Record<string, any>;
type ResearchLineBundle = { id: string; line: AnyRecord };

export async function getStaticPaths() {
  const snapshot = await loadCanonicalContent(new URL("../../../content/", import.meta.url));
  const visibleLines = (snapshot.researchLines as ResearchLineBundle[]).filter(
    (line) => line.line.reader_state === "visible",
  );
  return visibleLines.map((line) => ({ params: { id: line.id }, props: { lineId: line.id } }));
}

const { lineId } = Astro.props;
const snapshot = await loadCanonicalContent(new URL("../../../content/", import.meta.url));
const researchLine = projectResearchLineForReader(snapshot, lineId) as AnyRecord | null;
if (!researchLine) {
  throw new Error(`Visible Research Line not found: ${lineId}`);
}

const memberships = (researchLine.memberships ?? []) as AnyRecord[];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={researchLine.scientific_question} />
    <title>{researchLine.title} · High-Energy Transient Reading Radar</title>
  </head>
  <body>
    <main class="site-shell reader-page">
      <p class="eyebrow"><a href="/">High-Energy Transient Reading Radar</a> · Research Line</p>
      <header class="reader-header">
        <p class="record-label">Research Line ID: {lineId}</p>
        <h1>{researchLine.title}</h1>
        <p class="reader-deck">{researchLine.scientific_question}</p>
      </header>

      <section class="panel reader-view" aria-labelledby="line-reader-view-heading">
        <p class="section-kicker">Inspection layer 1</p>
        <h2 id="line-reader-view-heading">Reader View</h2>
        <ReadingProse source={String(researchLine.reading ?? "")} />
      </section>

      <section class="panel" aria-labelledby="physical-structure-heading">
        <p class="section-kicker">Scientific structure</p>
        <h2 id="physical-structure-heading">Physical Structure</h2>
        <ul class="compact-list">
          {(researchLine.physical_structure ?? []).map((item: string) => <li>{item}</li>)}
        </ul>
      </section>

      <section class="panel" aria-labelledby="line-works-heading">
        <p class="section-kicker">Editorial context</p>
        <h2 id="line-works-heading">Works in this Research Line</h2>
        <ul class="paper-index">
          {memberships.map((membership: AnyRecord) => (
            <li class="paper-index-item">
              <a class="paper-title" href={`/papers/${membership.work_id}/`}>{membership.work?.title ?? membership.work_id}</a>
              <small>{membership.reading_roles?.join(", ") ?? ""}{membership.editorial_anchor ? " · Editorial Anchor" : ""}</small>
              {membership.reason ? <span>{membership.reason}</span> : null}
            </li>
          ))}
        </ul>
      </section>
    </main>
  </body>
</html>
