---
import { loadCanonicalContent } from "../../../scripts/content-loader.mjs";
import { readEditorialIndex } from "../../../scripts/editorial-index.mjs";
import {
  projectResearchLineForReader,
  projectWorkForReader,
} from "../../../scripts/reader-projection.mjs";
import "../../styles/global.css";

type AnyRecord = Record<string, any>;
type WorkBundle = { id: string; files: AnyRecord };

export async function getStaticPaths() {
  const snapshot = await loadCanonicalContent(new URL("../../../content/", import.meta.url));
  const visibleWorks = (snapshot.works as WorkBundle[]).filter(
    (work) => work.files["work.yaml"]?.reader_state === "visible",
  );
  return visibleWorks.map((work) => ({ params: { workId: work.id }, props: { workId: work.id } }));
}

const { workId } = Astro.props;
const snapshot = await loadCanonicalContent(new URL("../../../content/", import.meta.url));
const work = projectWorkForReader(snapshot, workId) as AnyRecord | null;
if (!work) {
  throw new Error(`Visible Work not found: ${workId}`);
}

const versions = work.versions ?? [];
const bibliographicSources = (work.bibliographic_sources ?? []) as AnyRecord[];
const bibliographicSourcesById = new Map(
  bibliographicSources
    .filter((source: AnyRecord) => typeof source?.id === "string")
    .map((source: AnyRecord) => [source.id, source]),
);
const publicationRelations = work.publication_relations ?? [];
const preferredVersion = versions.find(
  (version: AnyRecord) => version.id === work.preferred_version_id,
);
const statements = work.statements ?? [];
const physicalAccount = work.physical_account ?? { stages: [], links: [] };
const reviewedLinks = physicalAccount.links ?? [];
const scientificEdges = (work.scientific_edges ?? []) as AnyRecord[];
const outboundEdges = scientificEdges.filter((edge) => edge.source_work_id === workId);
const inboundEdges = scientificEdges.filter((edge) => edge.target_work_id === workId);
const evidenceRecords = (work.evidence ?? []) as AnyRecord[];
const evidenceById = new Map(
  evidenceRecords
    .filter((evidence: AnyRecord) => typeof evidence?.id === "string")
    .map((evidence: AnyRecord) => [evidence.id, evidence]),
);
const reverseIndex = await readEditorialIndex() as Record<string, AnyRecord[]>;
const lineMemberships = (reverseIndex[workId] ?? []).map((membership) => ({
  ...membership,
  line: projectResearchLineForReader(snapshot, membership.line_id),
}));
const readingParagraphs = String(work.reading ?? "")
  .replace(/^---\r?\n[\s\S]*?\r?\n---\r?\n/u, "")
  .trim()
  .split(/\r?\n\s*\r?\n/u)
  .map((paragraph) => paragraph.replace(/^#+\s+/u, "").replace(/\r?\n/gu, " "))
  .filter(Boolean);

function describeLocator(locator: AnyRecord | undefined) {
  if (!locator?.type) {
    return "locator unavailable";
  }
  const parts = [String(locator.type)];
  for (const key of ["section", "equation", "table", "figure", "paragraph"]) {
    if (locator[key] !== undefined) {
      parts.push(`${key} ${locator[key]}`);
    }
  }
  if (locator.page !== undefined) {
    parts.push(`page ${locator.page}`);
  }
  return parts.join("; ");
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={`Scientific Reader View for ${preferredVersion?.title ?? workId}.`} />
    <title>{preferredVersion?.title ?? workId} · High-Energy Transient Reading Radar</title>
  </head>
  <body>
    <main>
      <p class="eyebrow"><a href="/papers">Papers</a></p>
      <h1>{preferredVersion?.title ?? workId}</h1>

      <section>
        <h2>Preferred Version</h2>
        <p>{preferredVersion?.authors?.map((author: AnyRecord) => author.display_name).join(", ")} ({preferredVersion?.release_date?.value})</p>
        <p>
          {preferredVersion?.journal?.name} {preferredVersion?.journal?.volume}, {preferredVersion?.journal?.first_page}.
          {preferredVersion?.doi ? ` DOI: ${preferredVersion.doi}.` : ""}
        </p>
        <p>{work.preferred_version?.reason}</p>
        <ul>
          {(preferredVersion?.access_urls ?? []).map((access: AnyRecord) => (
            <li><a href={access.url}>{access.kind}</a></li>
          ))}
        </ul>
      </section>

      <section>
        <h2>Reader View</h2>
        {readingParagraphs.map((paragraph) => <p>{paragraph}</p>)}
      </section>

      <section>
        <h2>Physics Ontology</h2>
        <dl>
          {(work.annotations ?? []).map((annotation: AnyRecord) => (
            <>
              <dt>{annotation.axis}</dt>
              <dd>
                {annotation.assessment?.state}
                {(annotation.assessment?.values ?? []).length > 0
                  ? `: ${annotation.assessment.values.map((value: AnyRecord) => value.term_id).join(", ")}`
                  : ""}
                {annotation.interpretive_risk ? `; risk: ${annotation.interpretive_risk}` : ""}
                {annotation.reason ? `; ${annotation.reason}` : ""}
              </dd>
            </>
          ))}
        </dl>
      </section>

      <section>
        <h2>Methods</h2>
        <ul>
          {(work.method_annotations ?? []).map((annotation: AnyRecord) => (
            <li>
              {annotation.technique_id} ({annotation.basis})
              {annotation.reason ? ` — ${annotation.reason}` : ""}
            </li>
          ))}
        </ul>
      </section>

      <section>
        <h2>Scientific Statements</h2>
        <ul>
          {statements.map((statement: AnyRecord) => (
            <li>
              <strong>{statement.kind}</strong>: {statement.canonical_text}
              {statement.reason ? ` — ${statement.reason}` : ""}
            </li>
          ))}
        </ul>
      </section>

      <section>
        <h2>Physical Account</h2>
        <ol>
          {(physicalAccount.stages ?? []).map((stage: AnyRecord) => <li>{stage.label}</li>)}
        </ol>
        <ul>
          {reviewedLinks.map((link: AnyRecord) => (
            <li>{link.source_stage_id} <strong>{link.relation}</strong> {link.target_stage_id}: {link.reason}</li>
          ))}
        </ul>
      </section>

      <section>
        <h2>Research Lines</h2>
        <ul>
          {lineMemberships.map((membership: AnyRecord) => (
            <li>
              <a href={`/research-lines/${membership.line_id}/`}>{membership.line?.title}</a>
              {membership.editorial_anchor ? " — Editorial Anchor" : ""}
              {` (${membership.reading_roles.join(", ")})`}
            </li>
          ))}
        </ul>
      </section>

      <section>
        <h2>Scientific Edges</h2>
        {scientificEdges.length === 0 ? (
          <p>No reviewed reader-visible Scientific Edges are stored for this Work.</p>
        ) : (
          <>
            <h3>Outbound assertions</h3>
            {outboundEdges.length === 0 ? (
              <p>No outbound assertions.</p>
            ) : (
              <ul>
                {outboundEdges.map((edge: AnyRecord) => (
                  <li>
                    {workId} <strong>{edge.relation}</strong>
                    <a href={`/papers/${edge.target_work_id}/`}> {edge.target_work_id}</a>
                    {edge.disposition ? ` — Disposition: ${edge.disposition}` : ""}
                    {edge.reason ? ` — ${edge.reason}` : ""}
                  </li>
                ))}
              </ul>
            )}
            <h3>Inbound assertions</h3>
            {inboundEdges.length === 0 ? (
              <p>No inbound assertions.</p>
            ) : (
              <ul>
                {inboundEdges.map((edge: AnyRecord) => (
                  <li>
                    <a href={`/papers/${edge.source_work_id}/`}>{edge.source_work_id}</a>
                    <strong> {edge.relation}</strong> {workId}
                    {edge.disposition ? ` — Disposition: ${edge.disposition}` : ""}
                    {edge.reason ? ` — ${edge.reason}` : ""}
                  </li>
                ))}
              </ul>
            )}
          </>
        )}
      </section>

      <details>
        <summary>Provenance Detail</summary>
        <h3>Versions</h3>
        <ul>
          {versions.map((version: AnyRecord) => (
            <li>
              <strong>{version.kind}</strong>: {version.title} ({version.id}); release date {version.release_date?.value}
              {version.arxiv_id ? `; arXiv ${version.arxiv_id}v${version.arxiv_revision}` : ""}
              {version.doi ? `; DOI ${version.doi}` : ""}
              {version.journal?.name ? `; ${version.journal.name} ${version.journal.volume ?? ""}, ${version.journal.first_page ?? ""}` : ""}
            </li>
          ))}
        </ul>
        <h3>Publication Relations</h3>
        {publicationRelations.length === 0 ? (
          <p>No reviewed Publication Relations are stored for this Work.</p>
        ) : (
          <ul>
            {publicationRelations.map((relation: AnyRecord) => {
              const sources = (relation.bibliographic_source_ids ?? [])
                .map((sourceId: string) => bibliographicSourcesById.get(sourceId))
                .filter((source: AnyRecord | undefined): source is AnyRecord => source !== undefined);
              return (
                <li>
                  {relation.source_version_id} <strong>{relation.relation}</strong> {relation.target_version_id}
                  {relation.basis ? ` (${relation.basis})` : ""}: {relation.reason}
                  <ul>
                    <li>
                      Bibliographic Provenance:
                      {sources.length === 0 ? " unavailable" : ""}
                      {sources.map((source: AnyRecord) => (
                        <span> {source.id} ({source.provider}, {source.record_id}, retrieved {source.retrieved_at}){source.source_url ? <> — <a href={source.source_url}>source</a></> : ""}</span>
                      ))}
                    </li>
                  </ul>
                </li>
              );
            })}
          </ul>
        )}
        <h3>Scientific Edges</h3>
        {scientificEdges.length === 0 ? (
          <p>No reviewed reader-visible Scientific Edges are stored for this Work.</p>
        ) : (
          <ul>
            {scientificEdges.map((edge: AnyRecord) => (
              <li>
                <strong>{edge.id}</strong>: {edge.source_work_id} <strong>{edge.relation}</strong> {edge.target_work_id}
                {edge.basis ? `; basis ${edge.basis}` : ""}
                {edge.disposition ? `; disposition ${edge.disposition}` : ""}
                {edge.reason ? `; ${edge.reason}` : ""}
                {edge.review_context?.status
                  ? `; ${edge.review_context.status} by ${edge.review_context.reviewer_actor_id} at ${edge.review_context.reviewed_at}`
                  : ""}
                <ul>
                  {(edge.evidence_ids ?? []).map((evidenceId: string) => {
                    const evidence = evidenceById.get(evidenceId);
                    return evidence ? (
                      <li>
                        <strong>{evidence.id}</strong>
                        {evidence.work_id ? ` (Work ${evidence.work_id})` : ""}
                        {` — ${evidence.version_id}; ${describeLocator(evidence.locator)}: “${evidence.excerpt}”`}
                        {evidence.source_url ? <> — <a href={evidence.source_url}>source</a></> : ""}
                      </li>
                    ) : (
                      <li>{evidenceId} — Evidence unavailable</li>
                    );
                  })}
                </ul>
              </li>
            ))}
          </ul>
        )}
        <h3>Evidence</h3>
        <ul>
          {evidenceRecords.map((evidence: AnyRecord) => (
            <li>
              <strong>{evidence.id}</strong>
              {evidence.work_id ? ` (Work ${evidence.work_id})` : ""}
              {` — ${evidence.version_id}; ${describeLocator(evidence.locator)}: “${evidence.excerpt}”`}
              {evidence.source_url ? <> — <a href={evidence.source_url}>source</a></> : ""}
              {evidence.review_context?.status
                ? `; ${evidence.review_context.status} by ${evidence.review_context.reviewer_actor_id} at ${evidence.review_context.reviewed_at}`
                : ""}
            </li>
          ))}
        </ul>
      </details>
    </main>
  </body>
</html>
