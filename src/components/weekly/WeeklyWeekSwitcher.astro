---
import archiveManifest from "../../data/arxiv-archives/manifest.json";

interface Props {
  currentWeek: string;
}

const { currentWeek } = Astro.props;

const allWeeks = (archiveManifest as any).weeks || [];
const latestWeekId = (archiveManifest as any).latest_week_id || (allWeeks[0]?.week_id ?? "");
---

<nav class="aihot-date-ribbon" aria-label="学术周报周期快速切换">
  <div class="ribbon-inner">
    <div class="ribbon-brand-tag">
      <span class="ribbon-icon">🗓️</span>
      <span class="ribbon-title">周期速选</span>
    </div>

    <!-- Scrollable Weeks Track (AI HOT style) -->
    <div class="ribbon-track-wrap">
      <div class="ribbon-pills-track">
        {allWeeks.map((w: any) => {
          const isCurrent = w.week_id === currentWeek;
          const isLatest = w.week_id === latestWeekId;
          const targetUrl = isLatest ? "/arxiv-weekly/" : `/arxiv-weekly/${w.week_id}/`;
          const rangeLabel = w.date_range ? w.date_range.split(" ~ ")[0]?.slice(5) : "";
          const paperCount = w.statistics?.total_analyzed ?? w.top_picks_count ?? 0;
          return (
            <a
              class={`date-pill ${isCurrent ? "active" : ""} ${isLatest ? "pill-latest" : ""}`}
              href={targetUrl}
              title={`切换至 ${w.week_id} (${w.date_range}) 学术脉络综述`}
              aria-current={isCurrent ? "page" : undefined}
            >
              {isLatest && <span class="pill-fire-badge">最新</span>}
              <strong class="pill-date">{w.week_id}</strong>
              {rangeLabel && <span class="pill-weekday">{rangeLabel}</span>}
              <span class="pill-count">{paperCount}篇</span>
            </a>
          );
        })}
      </div>
    </div>

    <!-- Pure HTML Dropdown for All Historical Weeks (Zero Script) -->
    <details class="ribbon-archive-details">
      <summary class="ribbon-archive-summary" title="展开更多历史周报">
        <span>全部往期 ({allWeeks.length})</span>
        <span class="summary-caret">▾</span>
      </summary>
      <div class="ribbon-archive-dropdown-menu">
        <div class="dropdown-header">
          <span>历史自然周学术脉络归档</span>
          <a class="dropdown-all-link" href="/arxiv-archives/">查看全局存档库 →</a>
        </div>
        <div class="dropdown-grid">
          {allWeeks.map((w: any) => {
            const isCurrent = w.week_id === currentWeek;
            const isLatest = w.week_id === latestWeekId;
            const targetUrl = isLatest ? "/arxiv-weekly/" : `/arxiv-weekly/${w.week_id}/`;
            const mustCount = w.statistics?.must_read_count ?? 0;
            const totalCount = w.statistics?.total_analyzed ?? 0;
            return (
              <a
                class={`dropdown-day-item ${isCurrent ? "active" : ""}`}
                href={targetUrl}
              >
                <div class="day-item-left">
                  <span class="day-item-date">{w.week_id}</span>
                  <span class="day-item-weekday">{w.date_range}</span>
                </div>
                <div class="day-item-right">
                  {mustCount > 0 && <span class="badge-must">{mustCount}必读</span>}
                  <span class="badge-total">{totalCount}篇</span>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </details>
  </div>
</nav>

<style>
  .aihot-date-ribbon {
    margin: 1.25rem 0 1.5rem 0;
    padding: 0.6rem 0.85rem;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03);
  }
  :global([data-theme="dark"]) .aihot-date-ribbon {
    background: #0f172a;
    border-color: #334155;
  }
  .ribbon-inner {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .ribbon-brand-tag {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: #475569;
    white-space: nowrap;
    padding-right: 0.5rem;
    border-right: 1px solid #e2e8f0;
  }
  :global([data-theme="dark"]) .ribbon-brand-tag {
    color: #cbd5e1;
    border-right-color: #334155;
  }
  .ribbon-icon {
    font-size: 1rem;
  }
  .ribbon-title {
    letter-spacing: -0.01em;
  }
  .ribbon-track-wrap {
    flex: 1 1 auto;
    overflow-x: auto;
    scrollbar-width: thin;
    padding-bottom: 2px;
  }
  .ribbon-track-wrap::-webkit-scrollbar {
    height: 4px;
  }
  .ribbon-track-wrap::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 2px;
  }
  :global([data-theme="dark"]) .ribbon-track-wrap::-webkit-scrollbar-thumb {
    background: #475569;
  }
  .ribbon-pills-track {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }
  .date-pill {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.28rem 0.65rem;
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    font-size: 0.8rem;
    color: #334155;
    text-decoration: none;
    white-space: nowrap;
    transition: all 0.15s ease;
  }
  :global([data-theme="dark"]) .date-pill {
    background: #1e293b;
    border-color: #475569;
    color: #e2e8f0;
  }
  .date-pill:hover {
    background: #f1f5f9;
    border-color: #94a3b8;
    color: #0f172a;
    transform: translateY(-1px);
  }
  :global([data-theme="dark"]) .date-pill:hover {
    background: #334155;
    border-color: #64748b;
    color: #f8fafc;
  }
  .date-pill.active {
    background: #2563eb;
    border-color: #1d4ed8;
    color: #ffffff;
    font-weight: 600;
    box-shadow: 0 2px 4px rgba(37, 99, 235, 0.2);
  }
  :global([data-theme="dark"]) .date-pill.active {
    background: #3b82f6;
    border-color: #2563eb;
    color: #ffffff;
  }
  .pill-fire-badge {
    font-size: 0.65rem;
    font-weight: 700;
    padding: 0.05rem 0.25rem;
    background: #ef4444;
    color: #ffffff;
    border-radius: 3px;
    letter-spacing: 0.02em;
  }
  .date-pill.active .pill-fire-badge {
    background: #ffffff;
    color: #ef4444;
  }
  .pill-date {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.82rem;
  }
  .pill-weekday {
    font-size: 0.75rem;
    opacity: 0.8;
  }
  .pill-count {
    font-size: 0.72rem;
    padding: 0.05rem 0.3rem;
    background: #e2e8f0;
    border-radius: 4px;
    color: #475569;
  }
  :global([data-theme="dark"]) .pill-count {
    background: #334155;
    color: #cbd5e1;
  }
  .date-pill.active .pill-count {
    background: rgba(255, 255, 255, 0.25);
    color: #ffffff;
  }

  /* Details Dropdown Menu */
  .ribbon-archive-details {
    position: relative;
    display: inline-block;
  }
  .ribbon-archive-summary {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.28rem 0.65rem;
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 600;
    color: #475569;
    cursor: pointer;
    user-select: none;
    list-style: none;
    transition: all 0.15s ease;
  }
  :global([data-theme="dark"]) .ribbon-archive-summary {
    background: #1e293b;
    border-color: #475569;
    color: #cbd5e1;
  }
  .ribbon-archive-summary::-webkit-details-marker {
    display: none;
  }
  .ribbon-archive-summary:hover {
    background: #f1f5f9;
    border-color: #94a3b8;
    color: #0f172a;
  }
  :global([data-theme="dark"]) .ribbon-archive-summary:hover {
    background: #334155;
    color: #f8fafc;
  }
  .summary-caret {
    font-size: 0.75rem;
    color: #94a3b8;
    transition: transform 0.15s ease;
  }
  .ribbon-archive-details[open] .summary-caret {
    transform: rotate(180deg);
  }
  .ribbon-archive-dropdown-menu {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    z-index: 50;
    min-width: 320px;
    max-width: 90vw;
    max-height: 420px;
    overflow-y: auto;
    padding: 0.6rem;
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
  }
  :global([data-theme="dark"]) .ribbon-archive-dropdown-menu {
    background: #1e293b;
    border-color: #334155;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5);
  }
  .dropdown-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.3rem 0.4rem 0.5rem 0.4rem;
    font-size: 0.75rem;
    font-weight: 700;
    color: #64748b;
    border-bottom: 1px solid #e2e8f0;
    margin-bottom: 0.4rem;
  }
  :global([data-theme="dark"]) .dropdown-header {
    color: #94a3b8;
    border-bottom-color: #334155;
  }
  .dropdown-all-link {
    color: #2563eb;
    text-decoration: none;
    font-weight: 600;
  }
  .dropdown-all-link:hover {
    text-decoration: underline;
  }
  :global([data-theme="dark"]) .dropdown-all-link {
    color: #60a5fa;
  }
  .dropdown-grid {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .dropdown-day-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.4rem 0.55rem;
    border-radius: 5px;
    text-decoration: none;
    color: #334155;
    font-size: 0.8rem;
    transition: background 0.12s ease;
  }
  :global([data-theme="dark"]) .dropdown-day-item {
    color: #e2e8f0;
  }
  .dropdown-day-item:hover {
    background: #f1f5f9;
  }
  :global([data-theme="dark"]) .dropdown-day-item:hover {
    background: #334155;
  }
  .dropdown-day-item.active {
    background: #eff6ff;
    color: #1d4ed8;
    font-weight: 600;
  }
  :global([data-theme="dark"]) .dropdown-day-item.active {
    background: #1e3a8a33;
    color: #93c5fd;
  }
  .day-item-left {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }
  .day-item-date {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-weight: 600;
  }
  .day-item-weekday {
    font-size: 0.72rem;
    color: #64748b;
  }
  :global([data-theme="dark"]) .day-item-weekday {
    color: #94a3b8;
  }
  .day-item-right {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }
  .badge-must {
    font-size: 0.68rem;
    font-weight: 700;
    padding: 0.05rem 0.3rem;
    background: #fef2f2;
    color: #dc2626;
    border-radius: 3px;
  }
  :global([data-theme="dark"]) .badge-must {
    background: #450a0a;
    color: #f87171;
  }
  .badge-total {
    font-size: 0.72rem;
    color: #64748b;
  }
  :global([data-theme="dark"]) .badge-total {
    color: #94a3b8;
  }
</style>
