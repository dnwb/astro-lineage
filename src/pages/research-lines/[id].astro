---
import ReadingProse from "../../components/ReadingProse.astro";
import { loadCanonicalContent } from "../../../scripts/content-loader.mjs";
import {
  projectResearchLineForReader,
  projectVisibleSnapshot,
} from "../../../scripts/reader-projection.mjs";
import { workReaderPath } from "../../lib/reader-routes";
import {
  localizedLineQuestion,
  localizedLineTitle,
  localizedMembershipReason,
  localizedRole,
  localizedWorkTitle,
} from "../../lib/reader-localization";
import { loadSiteConfig } from "../../lib/site-config";
import SiteNav from "../../components/SiteNav.astro";
import "../../styles/global.css";

type AnyRecord = Record<string, any>;
type ResearchLineBundle = { id: string; slug: string; line: AnyRecord };

export async function getStaticPaths() {
  const snapshot = await loadCanonicalContent(new URL("../../../content/", import.meta.url));
  const projected = projectVisibleSnapshot(snapshot) as { research_lines?: AnyRecord[] };
  const projectedLineIds = new Set(
    (projected.research_lines ?? [])
      .map((line) => line.line_id)
      .filter((lineId): lineId is string => typeof lineId === "string"),
  );
  // Projection supplies the publication boundary; the canonical bundle is
  // consulted only to resolve an approved identity to its filesystem slug.
  const visibleLines = (snapshot.researchLines as ResearchLineBundle[])
    .filter((line) => projectedLineIds.has(line.id));
  return visibleLines.map((line) => ({ params: { id: line.slug }, props: { lineId: line.id } }));
}

const { lineId } = Astro.props;
const site = loadSiteConfig();
const snapshot = await loadCanonicalContent(new URL("../../../content/", import.meta.url));
const researchLine = projectResearchLineForReader(snapshot, lineId) as AnyRecord | null;
if (!researchLine) {
  throw new Error(`Visible Research Line not found: ${lineId}`);
}

const memberships = (researchLine.memberships ?? []) as AnyRecord[];

function workAuthors(membership: AnyRecord) {
  return (membership.work?.authors ?? [])
    .map((author: AnyRecord) => author.display_name)
    .filter(Boolean)
    .join(", ");
}

function workYear(membership: AnyRecord) {
  const value = membership.work?.release_date?.value;
  return typeof value === "string" && /^\d{4}/u.test(value) ? value.slice(0, 4) : "";
}
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={researchLine.scientific_question} />
    <title>{localizedLineTitle(lineId, researchLine.title)} · {site.title}</title>
  </head>
  <body>
    <main class="site-shell reader-page">
      <SiteNav />
      <p class="eyebrow"><a href="/research-lines/">研究方向</a> · 研究方向详情</p>
      <header class="reader-header">
        <h1>{localizedLineTitle(lineId, researchLine.title)}</h1>
        <p class="original-title" lang="en">英文标题：{researchLine.title}</p>
        <p class="section-kicker">科学问题</p>
        <p class="reader-deck">{localizedLineQuestion(lineId, researchLine.scientific_question)}</p>
        <p class="language-english" lang="en">English question: {researchLine.scientific_question}</p>
      </header>

      <section class="panel reader-view" aria-labelledby="line-reader-view-heading">
        <h2 id="line-reader-view-heading">为什么这个方向重要</h2>
        <ReadingProse source={String(researchLine.reading ?? "")} localizationKey={lineId} />
      </section>

      <section class="panel" aria-labelledby="line-works-heading">
        <h2 id="line-works-heading">该研究方向中的论文</h2>
        {memberships.length === 0 ? (
          <p class="empty-state">该研究方向暂时没有关联的、经过审核且可见的论文。</p>
        ) : (
          <ol class="paper-index">
            {memberships.map((membership: AnyRecord) => (
              <li class="paper-index-item">
                <article>
                  <h3>
                    <a class="paper-title" href={workReaderPath(snapshot, membership.work_id)}>
                      {localizedWorkTitle(membership.work_id, membership.work?.title ?? membership.work_id)}
                    </a>
                  </h3>
                  <p class="original-title" lang="en">英文原题：{membership.work?.title ?? membership.work_id}</p>
                  {workAuthors(membership) || workYear(membership) ? (
                    <p class="paper-meta">
                      {workAuthors(membership)}{workAuthors(membership) && workYear(membership) ? " · " : ""}{workYear(membership)}
                    </p>
                  ) : null}
                  <p class="record-label">
                    阅读角色：{membership.reading_roles?.map(localizedRole).join("、") ?? "无"}
                    {membership.editorial_anchor ? " · 该方向的编辑锚点" : ""}
                  </p>
                  {membership.reason ? (
                    <>
                      <p>{localizedMembershipReason(membership.id, membership.reason)}</p>
                      <p class="language-english" lang="en">English note: {membership.reason}</p>
                    </>
                  ) : null}
                  <p><a class="browse-link" href={workReaderPath(snapshot, membership.work_id)}>阅读论文</a></p>
                </article>
              </li>
            ))}
          </ol>
        )}
      </section>
    </main>
  </body>
</html>
