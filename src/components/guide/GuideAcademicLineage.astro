---
import ReaderText from "../ReaderText.astro";

type AnyRecord = Record<string, any>;

interface Props {
  arxivId: string;
  revision: number;
  lineage: AnyRecord;
  visibleWorkLinks: Record<string, { href: string; title: string }>;
  prerequisites?: AnyRecord[];
  researchProgress?: string;
  citationLeads?: string[];
}

const {
  arxivId,
  revision,
  lineage = {},
  visibleWorkLinks = {},
  prerequisites = [],
  researchProgress,
  citationLeads = [],
} = Astro.props;

const relationLabels: Record<string, string> = {
  builds_on: "建立在其上",
  extends: "扩展",
  tests: "检验",
  constrains: "约束",
  challenges: "挑战",
  replaces_assumption: "替代假设",
  corrects: "修正",
};

const lineageStatusLabels: Record<string, string> = {
  candidate: "候选关系",
  no_match: "无匹配",
};

const validPrerequisites = Array.isArray(prerequisites)
  ? prerequisites.filter((p: AnyRecord) => visibleWorkLinks[p.work_id])
  : [];

const lineageCandidates = Array.isArray(lineage.candidates)
  ? lineage.candidates.filter((c: AnyRecord) => visibleWorkLinks[c.target_work_id])
  : [];

const lineageChecks = Array.isArray(lineage.unresolved_checks) ? lineage.unresolved_checks : [];
const hasProgress = Boolean(researchProgress && researchProgress.trim() !== "");
const hasCitations = Array.isArray(citationLeads) && citationLeads.length > 0;
---

<div class="guide-module-panel guide-academic-lineage">
  <div class="module-header">
    <span class="module-icon">🔗</span>
    <h4 class="module-title">
      <span class="language-primary">学术脉络、进展比较与前置建议</span>
      <span class="language-english" lang="en">Lineage, Context & Progress</span>
    </h4>
  </div>

  <div class="module-content">
    {validPrerequisites.length > 0 && (
      <div class="guide-field-block">
        <div class="guide-lead-row">
          <span class="guide-tag tag-prereq">📚 阅读前置建议</span>
        </div>
        <ul class="guide-link-list">
          {validPrerequisites.map((p: AnyRecord) => (
            <li>
              <a class="prereq-link" href={visibleWorkLinks[p.work_id].href}>
                📖 {visibleWorkLinks[p.work_id].title}
              </a>
              <span class="prereq-reason">：{p.reason}</span>
            </li>
          ))}
        </ul>
      </div>
    )}

    <div class="guide-field-block">
      <div class="guide-lead-row">
        <span class="guide-tag tag-lineage">🔗 组内学术脉络</span>
        <span class="lineage-status-badge status-{lineage.status || 'pending'}">
          {lineage.status === "no_match" ? "无组内匹配" : lineageStatusLabels[lineage.status] ?? "待审核"}
        </span>
      </div>
      {lineage.reason && (
        <p class="lineage-reason-text">
          <ReaderText text={lineage.reason} />
        </p>
      )}

      {lineageCandidates.length > 0 && (
        <ul class="guide-candidate-list">
          {lineageCandidates.map((c: AnyRecord) => (
            <li class="candidate-item">
              <div class="candidate-relation-row">
                <span class="candidate-arrow">arXiv:{arxivId}v{revision}</span>
                <span class="relation-badge">{relationLabels[c.relation] ?? c.relation}</span>
                <a class="candidate-work-link" href={visibleWorkLinks[c.target_work_id].href}>
                  {visibleWorkLinks[c.target_work_id].title}
                </a>
              </div>
              <div class="candidate-delta">
                <strong>演进差异：</strong>{c.delta}
                {c.support && <span class="candidate-support">（依据位置：{c.support}）</span>}
              </div>
              {c.unresolved_checks?.length > 0 && (
                <div class="candidate-unresolved">
                  <span>待核查：{c.unresolved_checks.join("、")}</span>
                </div>
              )}
            </li>
          ))}
        </ul>
      )}

      {lineageChecks.length > 0 && (
        <div class="lineage-checks-box">
          <span class="sub-label">关系核查待办：</span>
          <ul class="guide-sub-list">
            {lineageChecks.map((check: string) => (
              <li><ReaderText text={check} /></li>
            ))}
          </ul>
        </div>
      )}
    </div>

    {hasProgress && (
      <div class="guide-field-block">
        <div class="guide-lead-row">
          <span class="guide-tag tag-progress">📈 进展比较</span>
        </div>
        <div class="claim-body-text">
          <ReaderText text={researchProgress!} />
        </div>
      </div>
    )}

    {hasCitations && (
      <div class="guide-field-block">
        <div class="guide-lead-row">
          <span class="guide-tag tag-citation">🔍 引用线索</span>
        </div>
        <ul class="guide-bullet-list">
          {citationLeads.map((item: string) => (
            <li><ReaderText text={item} /></li>
          ))}
        </ul>
      </div>
    )}
  </div>
</div>

<style>
  .guide-module-panel {
    background: var(--bg-surface, #ffffff);
    border: 1px solid var(--border-color, #e2e8f0);
    border-radius: 0.45rem;
    overflow: hidden;
  }
  :global([data-theme="dark"]) .guide-module-panel {
    background: #1e293b;
    border-color: #334155;
  }
  .module-header {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.75rem;
    background: #f8fafc;
    border-bottom: 1px solid var(--border-color, #e2e8f0);
  }
  :global([data-theme="dark"]) .module-header {
    background: #0f172a;
    border-bottom-color: #334155;
  }
  .module-icon {
    font-size: 0.95rem;
  }
  .module-title {
    margin: 0;
    font-size: 0.86rem;
    font-weight: 700;
    color: var(--text-heading, #0f172a);
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }
  :global([data-theme="dark"]) .module-title {
    color: #f8fafc;
  }
  .module-content {
    padding: 0.55rem 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .guide-field-block {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .guide-lead-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    line-height: 1.45;
  }
  .guide-tag {
    display: inline-flex;
    align-items: center;
    padding: 0.08rem 0.4rem;
    font-size: 0.72rem;
    font-weight: 700;
    border-radius: 0.25rem;
    letter-spacing: 0.02em;
    flex-shrink: 0;
  }
  .tag-prereq {
    background: #fef3c7;
    color: #92400e;
    border: 1px solid #fde68a;
  }
  .tag-lineage {
    background: #ecfeff;
    color: #0e7490;
    border: 1px solid #a5f3fc;
  }
  .tag-progress {
    background: #f0fdf4;
    color: #15803d;
    border: 1px solid #bbf7d0;
  }
  .tag-citation {
    background: #f1f5f9;
    color: #475569;
    border: 1px solid #cbd5e1;
  }
  :global([data-theme="dark"]) .tag-prereq {
    background: #78350f;
    color: #fef3c7;
    border-color: #b45309;
  }
  :global([data-theme="dark"]) .tag-lineage {
    background: #164e63;
    color: #a5f3fc;
    border-color: #0891b2;
  }
  :global([data-theme="dark"]) .tag-progress {
    background: #14532d;
    color: #86efac;
    border-color: #16a34a;
  }
  :global([data-theme="dark"]) .tag-citation {
    background: #1e293b;
    color: #cbd5e1;
    border-color: #475569;
  }
  .lineage-status-badge {
    font-size: 0.7rem;
    padding: 0.06rem 0.35rem;
    border-radius: 9999px;
    background: #f1f5f9;
    color: #64748b;
  }
  .status-candidate {
    background: #dbeafe;
    color: #1e40af;
  }
  :global([data-theme="dark"]) .status-candidate {
    background: #1e3a5f;
    color: #93c5fd;
  }
  .claim-body-text {
    font-size: 0.84rem;
    line-height: 1.55;
    color: var(--text-body, #475569);
    padding-left: 0.5rem;
    border-left: 2px solid var(--border-color, #e2e8f0);
    margin-top: 0.15rem;
  }
  :global([data-theme="dark"]) .claim-body-text {
    color: #94a3b8;
    border-left-color: #334155;
  }
  .lineage-reason-text {
    margin: 0.15rem 0 0.25rem;
    font-size: 0.84rem;
    line-height: 1.5;
    color: var(--text-body, #334155);
  }
  :global([data-theme="dark"]) .lineage-reason-text {
    color: #cbd5e1;
  }
  .guide-link-list,
  .guide-bullet-list {
    margin: 0.15rem 0 0.15rem 0.5rem;
    padding-left: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-size: 0.84rem;
    line-height: 1.5;
  }
  .prereq-link {
    font-weight: 600;
    color: var(--link-color, #2563eb);
    text-decoration: none;
  }
  .prereq-link:hover {
    text-decoration: underline;
  }
  .prereq-reason {
    color: var(--text-secondary, #64748b);
  }
  .guide-candidate-list {
    list-style: none;
    padding: 0;
    margin: 0.25rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .candidate-item {
    background: #ffffff;
    border: 1px solid var(--border-color, #e2e8f0);
    border-radius: 0.3rem;
    padding: 0.35rem 0.5rem;
  }
  :global([data-theme="dark"]) .candidate-item {
    background: #1e293b;
    border-color: #334155;
  }
  .candidate-relation-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.82rem;
    font-weight: 500;
  }
  .candidate-arrow {
    font-family: ui-monospace, monospace;
    font-size: 0.78rem;
    color: var(--text-secondary, #64748b);
  }
  .relation-badge {
    display: inline-block;
    padding: 0.06rem 0.3rem;
    font-size: 0.68rem;
    font-weight: 700;
    background: #e0e7ff;
    color: #4338ca;
    border-radius: 0.2rem;
  }
  :global([data-theme="dark"]) .relation-badge {
    background: #312e81;
    color: #c7d2fe;
  }
  .candidate-work-link {
    font-weight: 600;
    color: var(--link-color, #2563eb);
    text-decoration: none;
  }
  .candidate-work-link:hover {
    text-decoration: underline;
  }
  .candidate-delta {
    margin-top: 0.15rem;
    font-size: 0.8rem;
    color: var(--text-body, #334155);
  }
  :global([data-theme="dark"]) .candidate-delta {
    color: #cbd5e1;
  }
  .candidate-support {
    color: var(--text-secondary, #64748b);
    font-size: 0.76rem;
  }
  .candidate-unresolved {
    margin-top: 0.15rem;
    font-size: 0.76rem;
    color: #b45309;
  }
  :global([data-theme="dark"]) .candidate-unresolved {
    color: #fcd34d;
  }
  .lineage-checks-box {
    margin-top: 0.25rem;
    padding: 0.25rem 0.45rem;
    background: #fffbeb;
    border-left: 3px solid #f59e0b;
    border-radius: 0 0.2rem 0.2rem 0;
    font-size: 0.78rem;
  }
  :global([data-theme="dark"]) .lineage-checks-box {
    background: #451a03;
    border-left-color: #d97706;
  }
  .sub-label {
    font-weight: 600;
    color: #92400e;
  }
  :global([data-theme="dark"]) .sub-label {
    color: #fde68a;
  }
  .guide-sub-list {
    margin: 0.15rem 0 0;
    padding-left: 1rem;
    color: #78350f;
  }
  :global([data-theme="dark"]) .guide-sub-list {
    color: #fef3c7;
  }
</style>
