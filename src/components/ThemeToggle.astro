---
// src/components/ThemeToggle.astro
---

<button
  id="theme-toggle"
  class="theme-toggle"
  type="button"
  aria-label="切换深色/浅色模式"
  title="切换主题 (Dark / Light)"
>
  <span class="theme-icon-sun" aria-hidden="true">☀️</span>
  <span class="theme-icon-moon" aria-hidden="true">🌙</span>
</button>

<script is:inline>
  (function () {
    const storageKey = "astrolineage-theme";
    const toggle = document.getElementById("theme-toggle");

    function getPreferredTheme() {
      const saved = localStorage.getItem(storageKey);
      if (saved === "dark" || saved === "light") return saved;
      return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
    }

    function applyTheme(theme) {
      document.documentElement.setAttribute("data-theme", theme);
      if (toggle) {
        toggle.setAttribute("aria-label", theme === "dark" ? "切换为浅色模式" : "切换为深色模式");
      }
    }

    // Apply immediately to prevent flash
    const current = getPreferredTheme();
    applyTheme(current);

    if (toggle) {
      toggle.addEventListener("click", () => {
        const active = document.documentElement.getAttribute("data-theme") || "light";
        const next = active === "dark" ? "light" : "dark";
        localStorage.setItem(storageKey, next);
        applyTheme(next);
      });
    }
  })();
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    margin-left: 0.5rem;
    border: 1px solid var(--border-color, #b6b4aa);
    border-radius: 9999px;
    background: var(--card-bg, #ffffff);
    color: var(--text-color, #172033);
    cursor: pointer;
    transition: all 0.2s ease;
    font-size: 0.95rem;
  }
  .theme-toggle:hover {
    border-color: #60a5fa;
    transform: scale(1.05);
  }
  .theme-toggle:focus-visible {
    outline: 2px solid #2563eb;
    outline-offset: 2px;
  }
  :global([data-theme="dark"]) .theme-icon-sun {
    display: inline;
  }
  :global([data-theme="dark"]) .theme-icon-moon {
    display: none;
  }
  :global(:not([data-theme="dark"])) .theme-icon-sun {
    display: none;
  }
  :global(:not([data-theme="dark"])) .theme-icon-moon {
    display: inline;
  }
</style>
