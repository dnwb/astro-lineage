---
import ReadingProse from "../../components/ReadingProse.astro";
import { loadCanonicalContent } from "../../../scripts/content-loader.mjs";
import { parseReadingMarkdown } from "../../../scripts/reader-markdown.mjs";
import { projectBaselineSnapshot } from "../../../scripts/reader-projection.mjs";
import { workReaderPath } from "../../lib/reader-routes";
import {
  localizedPathTitle,
  localizedPathTransition,
  localizedWorkTitle,
} from "../../lib/reader-localization";
import { loadSiteConfig } from "../../lib/site-config";
import SiteNav from "../../components/SiteNav.astro";
import "../../styles/global.css";

type AnyRecord = Record<string, any>;
type LearningPathBundle = { id: string; slug: string; path: AnyRecord };

export async function getStaticPaths() {
  const snapshot = await loadCanonicalContent(new URL("../../../content/", import.meta.url));
  const projected = projectBaselineSnapshot(snapshot) as { learning_paths?: AnyRecord[] };
  const projectedPathIds = new Set(
    (projected.learning_paths ?? [])
      .map((path) => path.path_id)
      .filter((pathId): pathId is string => typeof pathId === "string"),
  );
  return (snapshot.learningPaths as LearningPathBundle[])
    .filter((path) => projectedPathIds.has(path.id))
    .map((path) => ({ params: { id: path.slug }, props: { pathId: path.id } }));
}

const { pathId } = Astro.props;
const site = loadSiteConfig();
const snapshot = await loadCanonicalContent(new URL("../../../content/", import.meta.url));
const baselineReader = projectBaselineSnapshot(snapshot) as { learning_paths?: AnyRecord[]; works?: AnyRecord[] };
const learningPath = baselineReader.learning_paths?.find((path) => path.path_id === pathId) ?? null;
if (!learningPath) {
  throw new Error(`Baseline Learning Path not found: ${pathId}`);
}
const isCandidate = learningPath.reader_status === "candidate";

const entries = (learningPath.entries ?? []) as AnyRecord[];
const transitions = (learningPath.transitions ?? []) as AnyRecord[];
const steps = entries.map((entry, index) => {
  const nextEntry = entries[index + 1];
  const transition = nextEntry
    ? transitions.find((candidate) =>
      candidate.source_work_id === entry.work_id &&
      candidate.target_work_id === nextEntry.work_id)
    : null;
  return { entry, transition };
});

function workTitle(entry: AnyRecord) {
  return entry.work?.title ?? entry.work_id;
}

function workAuthors(entry: AnyRecord) {
  return (entry.work?.authors ?? [])
    .map((author: AnyRecord) => author.display_name)
    .filter(Boolean)
    .join(", ");
}

function workDate(entry: AnyRecord) {
  return entry.work?.release_date?.value ?? "Unknown year";
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content={`Learning Path: ${learningPath.title ?? pathId}`}
    />
    <title>{learningPath.title ?? pathId} · {site.title}</title>
  </head>
  <body>
    <main class="site-shell reader-page">
      <SiteNav />
      <p class="eyebrow"><a href="/learning-paths/">Learning Paths</a> · Learning Path Detail</p>
      <header class="reader-header">
        {isCandidate ? <p class="reader-note"><span class="tag">Candidate Path</span> This path organizes baseline literature and is pending formal review.</p> : null}
        <p class="record-label">Learning Path ID: {pathId}</p>
        <h1>{learningPath.title ?? pathId}</h1>
        <p class="reader-deck">{isCandidate ? "This is a candidate reading sequence organizing baseline literature. Transition reasons provide pedagogical context pending review." : "This is an ordered and verified reading sequence. Transition reasons provide pedagogical context for the path."}</p>
      </header>

      <section class="panel reader-view" aria-labelledby="path-reader-view-heading">
        <p class="section-kicker">Pedagogical Overview</p>
        <h2 id="path-reader-view-heading">Overview</h2>
        <ReadingProse source={String(learningPath.reading ?? "")} localizationKey={pathId} />
      </section>

      <section class="panel" aria-labelledby="reading-sequence-heading">
        <p class="section-kicker">Ordered Pedagogy</p>
        <h2 id="reading-sequence-heading">Reading Order</h2>
        <ol class="path-sequence">
          {steps.map(({ entry, transition }, index) => (
            <li class="path-step">
              <span class="step-number">{index + 1}</span>
              <div>
                <h3>{workTitle(entry)}</h3>
                <p class="step-meta">{workAuthors(entry) || "Unknown author"} · {workDate(entry)} · Preferred version: {entry.work?.preferred_version_id ?? "unavailable"}</p>
                <p><a class="browse-link" href={workReaderPath(snapshot, entry.work_id)}>Read paper →</a></p>
                {transition ? (
                  <p class="transition-reason"><strong>Why Next:</strong> {transition.reason}</p>
                ) : null}
              </div>
            </li>
          ))}
        </ol>
      </section>

      <details class="panel provenance-detail">
        <summary>Provenance &amp; Review Details</summary>
        <h2>Path Review</h2>
        <p>
          <span class="tag">{learningPath.review_context?.status === "reviewed" ? "Reviewed" : "Unreviewed"}</span>
          {learningPath.review_context?.reviewer_actor_id
            ? `, reviewer ${learningPath.review_context.reviewer_actor_id}`
            : ""}
          {learningPath.review_context?.reviewed_at
            ? `, at ${learningPath.review_context.reviewed_at}`
            : ""}
        </p>
        <h3>Pedagogical Transition</h3>
        <ul class="compact-list">
          {transitions.map((transition: AnyRecord) => (
            <li>
              {transition.source_work_id} <strong>→</strong> {transition.target_work_id}：{localizedPathTransition(transition.source_work_id, transition.target_work_id, transition.reason)}
            </li>
          ))}
        </ul>
      </details>
    </main>
  </body>
</html>
