---
import ReadingProse from "../../components/ReadingProse.astro";
import { loadCanonicalContent } from "../../../scripts/content-loader.mjs";
import {
  parseReadingDocument,
  parseReadingMarkdown,
  requiredReadingSection,
  whyThisWorkMatters,
} from "../../../scripts/reader-markdown.mjs";
import {
  projectBaselineSnapshot,
  projectWorkForReader,
} from "../../../scripts/reader-projection.mjs";
import { researchLineReaderPath, workReaderPath } from "../../lib/reader-routes";
import {
  localizedAccessKind,
  localizedEdgeReason,
  localizedLineTitle,
  localizedLocatorType,
  localizedRelation,
  localizedReviewStatus,
  localizedRole,
  localizedWorkTitle,
} from "../../lib/reader-localization";
import { loadSiteConfig } from "../../lib/site-config";
import {
  formatAuthorList,
  formatSystemTime,
  formatScientificEpoch,
  formatWorkBibTeX,
  formatVersionPinnedLocator,
  getBibliographicUrl,
  getBibliographicSourceName,
  detectContestedClaims,
  getHighEnergyConventions,
  projectMechanismDAG,
  partitionScientificEdges,
} from "../../domain/academic-domain.mjs";
import { renderInlineScientificMarkdownWithMath } from "../../domain/scientific-text/index.mjs";
import SiteNav from "../../components/SiteNav.astro";
import MechanismDAGStream from "../../components/MechanismDAGStream.astro";
import EvidenceLedger from "../../components/EvidenceLedger.astro";
import "../../styles/global.css";

type AnyRecord = Record<string, any>;
type WorkBundle = { id: string; slug: string; files: AnyRecord };

export async function getStaticPaths() {
  const snapshot = await loadCanonicalContent(new URL("../../../content/", import.meta.url));
  const projected = projectBaselineSnapshot(snapshot) as { works?: AnyRecord[] };
  const projectedWorkIds = new Set(
    (projected.works ?? [])
      .map((work) => work.work_id)
      .filter((workId): workId is string => typeof workId === "string"),
  );
  // Projection supplies the publication boundary; the canonical bundle is
  // consulted only to resolve the approved Work identity to its filesystem
  // slug for Astro's static route.
  const readerWorks = (snapshot.works as WorkBundle[]).filter((work) => projectedWorkIds.has(work.id));
  return readerWorks.map((work) => ({ params: { workId: work.slug }, props: { workId: work.id } }));
}

const { workId } = Astro.props;
const site = loadSiteConfig();
const snapshot = await loadCanonicalContent(new URL("../../../content/", import.meta.url));
const baselineReader = projectBaselineSnapshot(snapshot) as { works?: AnyRecord[] };
const workCandidate = baselineReader.works?.find((candidate) => candidate.work_id === workId);
if (!workCandidate) throw new Error(`Baseline Work not found: ${workId}`);
const work = workCandidate;
const isCandidate = work.reader_status === "candidate";

const versions = (work.versions ?? []) as AnyRecord[];
const preferredVersionCandidate = versions.find((version) => version.id === work.preferred_version_id);
if (!preferredVersionCandidate) throw new Error(`Missing preferred Version for ${workId}.`);
const preferredVersion = preferredVersionCandidate;
if (typeof preferredVersion.release_date?.value !== "string" || !/^\d{4}/u.test(preferredVersion.release_date.value)) {
  throw new Error(`Missing preferred Version release year for ${workId}.`);
}

const reading = parseReadingDocument(String(work.reading ?? ""));
const readingSections = {
  why: whyThisWorkMatters(reading, workId),
  problem: requiredReadingSection(reading, "Problem", workId),
  takeaway: requiredReadingSection(reading, "Scientific takeaway", workId),
  assumptions: requiredReadingSection(reading, "Assumptions", workId),
  delta: requiredReadingSection(reading, "Scientific delta", workId),
};

function title() {
  return preferredVersion.title;
}

const publicationRelations = (work.publication_relations ?? []) as AnyRecord[];
const bibliographicSources = (work.bibliographic_sources ?? []) as AnyRecord[];
const bibliographicSourcesById = new Map(
  bibliographicSources.filter((source) => typeof source?.id === "string").map((source) => [source.id, source]),
);
const statements = (work.statements ?? []) as AnyRecord[];
const physicalAccount = work.physical_account ?? { stages: [], links: [] };
const scientificEdges = (work.scientific_edges ?? []) as AnyRecord[];
const evidenceRecords = (work.evidence ?? []) as AnyRecord[];
const evidenceById = new Map(
  evidenceRecords.filter((evidence) => typeof evidence?.id === "string").map((evidence) => [evidence.id, evidence]),
);
const lineMemberships = (work.research_lines ?? []) as AnyRecord[];

const relationLabels: Record<string, { outbound: string; inbound: string }> = {
  builds_on: { outbound: "Builds on", inbound: "Built upon by" },
  extends: { outbound: "Extends", inbound: "Extended by" },
  tests: { outbound: "Tests", inbound: "Tested by" },
  constrains: { outbound: "Constrains", inbound: "Constrained by" },
  challenges: { outbound: "Challenges", inbound: "Challenged by" },
  replaces_assumption: { outbound: "Replaces assumption", inbound: "Assumption replaced by" },
  corrects: { outbound: "Corrects", inbound: "Corrected by" },
};

function describeLocator(locator: AnyRecord | undefined) {
  if (!locator?.type) return "typed locator unavailable";
  const englishParts = [String(locator.type)];
  for (const key of ["section", "equation", "table", "figure", "paragraph", "page"]) {
    if (locator[key] !== undefined) englishParts.push(`${key} ${locator[key]}`);
  }
  return `typed locator: ${englishParts.join("; ")}`;
}

function reviewContext(value: AnyRecord) {
  const context = value.review_context;
  if (!context?.status) return "Review context unavailable";
  return `${localizedReviewStatus(context.status)}${context.reviewer_actor_id ? ` (reviewed by ${context.reviewer_actor_id}${context.reviewed_at ? ` at ${formatSystemTime(context.reviewed_at)}` : ""})` : ""}`;
}

function relationLabel(edge: AnyRecord) {
  if (typeof edge.relation !== "string" || !relationLabels[edge.relation]) {
    throw new Error(`Unknown Scientific Edge relation for ${workId}.`);
  }
  if (edge.source_work_id === workId) return relationLabels[edge.relation].outbound;
  if (edge.target_work_id === workId) return relationLabels[edge.relation].inbound;
  throw new Error(`Scientific Edge does not connect to ${workId}.`);
}

function otherWorkId(edge: AnyRecord) {
  if (edge.source_work_id === workId) return edge.target_work_id;
  if (edge.target_work_id === workId) return edge.source_work_id;
  throw new Error(`Scientific Edge does not connect to ${workId}.`);
}

function connectedPaper(edge: AnyRecord) {
  const connectedWorkId = otherWorkId(edge);
  const connectedWork = projectWorkForReader(snapshot, connectedWorkId) as AnyRecord | null;
  if (!connectedWork) {
    throw new Error(`Scientific Edge endpoint is not reader-visible: ${connectedWorkId}.`);
  }
  const connectedVersion = (connectedWork.versions ?? []).find(
    (version: AnyRecord) => version.id === connectedWork.preferred_version_id,
  );
  if (!connectedVersion) {
    throw new Error(`Missing preferred Version for connected Work ${connectedWorkId}.`);
  }
  return {
    href: workReaderPath(snapshot, connectedWorkId),
    title: localizedWorkTitle(connectedWorkId, connectedVersion.title),
    authors: formatAuthorList(connectedVersion.authors, { max: 10 }),
    year: connectedVersion.release_date?.value?.slice(0, 4),
  };
}

const scixUrl = preferredVersion.arxiv_id
  ? getBibliographicUrl(preferredVersion.arxiv_id)
  : preferredVersion.doi
    ? getBibliographicUrl(preferredVersion.doi)
    : null;
const scixName = getBibliographicSourceName();
const arxivPdfUrl = preferredVersion.arxiv_id ? `https://arxiv.org/pdf/${preferredVersion.arxiv_id}.pdf` : null;
const arxivHtmlUrl = preferredVersion.arxiv_id ? `https://arxiv.org/html/${preferredVersion.arxiv_id}` : null;

const disputeInfo = detectContestedClaims(workId, scientificEdges);
const conventionsRaw = getHighEnergyConventions();
const conventionsHtml = renderInlineScientificMarkdownWithMath(conventionsRaw);
const hasPhysicalAccount = (physicalAccount.stages?.length ?? 0) > 0;
const mechanismDAG = projectMechanismDAG(physicalAccount);
const { upstream: upstreamEdges, downstream: downstreamEdges } = partitionScientificEdges(workId, scientificEdges);
const versionsById = new Map(versions.map((v: AnyRecord) => [v.id, v]));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={`Scientific reading view for ${preferredVersion.title}.`} />
    <title>{title()} · {site.title}</title>
  </head>
  <body>
    <main class="site-shell reader-page">
      <SiteNav />
      <p class="eyebrow"><a href="/papers/">Papers</a> · Paper Detail</p>

      <div class="paper-detail-grid">
        <div class="paper-main-content">
          <header class="reader-header">
        <p class="section-kicker">Bibliographic Record</p>
        <h1>{title()}</h1>
        <p class="paper-meta">{formatAuthorList(preferredVersion.authors, { max: 10 })} · {preferredVersion.release_date.value.slice(0, 4)}</p>
        {isCandidate ? (
          <p class="reader-note"><span class="tag">Candidate Baseline</span> This entry has completed source verification and formula review.</p>
        ) : null}
        {preferredVersion.journal?.name ? (
          <p>{preferredVersion.journal.name}{preferredVersion.journal.volume ? ` ${preferredVersion.journal.volume}` : ""}{preferredVersion.journal.first_page ? `, ${preferredVersion.journal.first_page}` : ""}{preferredVersion.doi ? ` · DOI ${preferredVersion.doi}` : ""}</p>
        ) : null}
        <ul class="inline-list paper-source-links" aria-label="Original paper sources">
          {(preferredVersion.access_urls ?? []).map((access: AnyRecord) => (
            <li><a href={access.url}>Open {localizedAccessKind(access.kind)}</a></li>
          ))}
        </ul>
      </header>

      {disputeInfo.isContested && (
        <div class="paper-dispute-banner" role="alert">
          <span class="dispute-icon">⚠</span>
          <div class="dispute-content">
            <strong>Academic Dispute / Contested Claim:</strong>
            <span>
              Core conclusions or assumptions of this work are contested by {disputeInfo.contestedCount} connected paper{disputeInfo.contestedCount > 1 ? "s" : ""}.
              <a href="#connections-heading">Inspect conflicting evidence ↓</a>
            </span>
          </div>
        </div>
      )}

      <div class="paper-conventions-line" aria-label="Physical Notation and Reporting Conventions">
        <span class="conventions-badge">Conventions</span>
        <span class="conventions-text" set:html={conventionsHtml} />
      </div>

      <section class="panel reading-section" aria-labelledby="why-heading">
        <h2 id="why-heading">Why This Work Matters</h2>
        <ReadingProse blocks={readingSections.why} localizationKey={workId} localizationSection="why" />
      </section>
      <section class="panel reading-section" aria-labelledby="problem-heading">
        <h2 id="problem-heading">Problem</h2>
        <ReadingProse blocks={readingSections.problem} localizationKey={workId} localizationSection="problem" />
      </section>
      <section class="panel reading-section" aria-labelledby="takeaway-heading">
        <h2 id="takeaway-heading">Scientific Takeaway</h2>
        <ReadingProse blocks={readingSections.takeaway} localizationKey={workId} localizationSection="takeaway" />
      </section>
      <section class="panel reading-section" aria-labelledby="assumptions-heading">
        <h2 id="assumptions-heading">Assumptions</h2>
        <ReadingProse blocks={readingSections.assumptions} localizationKey={workId} localizationSection="assumptions" />
      </section>
      <section class="panel reading-section" aria-labelledby="delta-heading">
        <h2 id="delta-heading">Scientific Delta</h2>
        <ReadingProse blocks={readingSections.delta} localizationKey={workId} localizationSection="delta" />
      </section>

      {hasPhysicalAccount && mechanismDAG.totalStages > 0 && (
        <MechanismDAGStream dag={mechanismDAG} />
      )}

      {!hasPhysicalAccount && (
        <section class="panel observational-setup-card" aria-labelledby="observational-setup-heading">
          <h2 id="observational-setup-heading">Observational & Empirical Profile</h2>
          <p class="section-intro">This work contributes empirical observations, catalogs, or methodological analysis rather than an isolated microphysical stage model.</p>
          {(work.method_annotations ?? []).length > 0 && (
            <div class="methods-summary">
              <h3>Applied Methods</h3>
              <ul class="inline-list">
                {(work.method_annotations ?? []).map((method: AnyRecord) => (
                  <li><span class="tag">{method.technique_id}</span> ({method.basis})</li>
                ))}
              </ul>
            </div>
          )}
          {statements.length > 0 && (
            <div class="statements-summary">
              <h3>Key Empirical Statements</h3>
              <ul class="compact-list">
                {statements.map((statement: AnyRecord) => (
                  <li><strong>{statement.kind}</strong>: {statement.canonical_text}</li>
                ))}
              </ul>
            </div>
          )}
        </section>
      )}

      <section class="panel connections-container" aria-labelledby="connections-heading">
        <h2 id="connections-heading">Scientific Connections & Directed Lineage</h2>
        <p class="section-intro">Causal intellectual trajectory partitioned into upstream foundational heritage and downstream empirical testing.</p>

        <div class="lineage-stream-group">
          <div class="lineage-substream">
            <h3 id="foundational-lineage-heading" class="substream-heading">Foundational Lineage (Upstream Heritage)</h3>
            {upstreamEdges.length === 0 ? (
              <p class="empty-state">No upstream foundational dependencies recorded.</p>
            ) : (
              <ul class="edge-list upstream-edges">
                {upstreamEdges.map((edge: AnyRecord) => {
                  const connected = connectedPaper(edge);
                  return (
                    <li class={`edge-card polarity-${edge.polarity}`}>
                      <div class="edge-card-header">
                        <span class={`polarity-badge polarity-${edge.polarity}`}>
                          {edge.polarity === "supports" ? "Adopts / Supports" : edge.polarity === "contradicts" ? "Challenges / Contests" : "Neutral Baseline"}
                        </span>
                        <span class="tag relation-tag">{relationLabel(edge)}</span>
                        {edge.disposition === "contested" ? <strong class="dispute-indicator"> Contested</strong> : null}
                      </div>
                      <h4><a href={connected.href}>{connected.title}</a></h4>
                      <p class="paper-meta">{connected.authors} · {connected.year}</p>
                      <p class="edge-reason">{localizedEdgeReason(edge.id, edge.reason)}</p>
                      {(edge.evidence_ids ?? []).length > 0 && (
                        <div class="edge-evidence-links">
                          <span class="evidence-link-title">Evidence:</span>
                          {(edge.evidence_ids ?? []).map((evId: string) => {
                            const ev = evidenceById.get(evId);
                            const loc = ev ? formatVersionPinnedLocator(ev.locator, preferredVersion) : evId;
                            return (
                              <a href={`#evidence-${evId}`} class="evidence-chip" title="Jump to verified evidence in ledger">
                                📌 {loc}
                              </a>
                            );
                          })}
                        </div>
                      )}
                    </li>
                  );
                })}
              </ul>
            )}
          </div>

          <div class="lineage-substream">
            <h3 id="downstream-tests-heading" class="substream-heading">Empirical Tests & Applications (Downstream Validations)</h3>
            {downstreamEdges.length === 0 ? (
              <p class="empty-state">No downstream tests or extensions recorded yet.</p>
            ) : (
              <ul class="edge-list downstream-edges">
                {downstreamEdges.map((edge: AnyRecord) => {
                  const connected = connectedPaper(edge);
                  return (
                    <li class={`edge-card polarity-${edge.polarity}`}>
                      <div class="edge-card-header">
                        <span class={`polarity-badge polarity-${edge.polarity}`}>
                          {edge.polarity === "supports" ? "Validates / Extends" : edge.polarity === "contradicts" ? "Challenges / Constrains" : "Empirical Test"}
                        </span>
                        <span class="tag relation-tag">{relationLabel(edge)}</span>
                        {edge.disposition === "contested" ? <strong class="dispute-indicator"> Contested</strong> : null}
                      </div>
                      <h4><a href={connected.href}>{connected.title}</a></h4>
                      <p class="paper-meta">{connected.authors} · {connected.year}</p>
                      <p class="edge-reason">{localizedEdgeReason(edge.id, edge.reason)}</p>
                      {(edge.evidence_ids ?? []).length > 0 && (
                        <div class="edge-evidence-links">
                          <span class="evidence-link-title">Evidence:</span>
                          {(edge.evidence_ids ?? []).map((evId: string) => {
                            const ev = evidenceById.get(evId);
                            const loc = ev ? formatVersionPinnedLocator(ev.locator, preferredVersion) : evId;
                            return (
                              <a href={`#evidence-${evId}`} class="evidence-chip" title="Jump to verified evidence in ledger">
                                📌 {loc}
                              </a>
                            );
                          })}
                        </div>
                      )}
                    </li>
                  );
                })}
              </ul>
            )}
          </div>
        </div>
      </section>

      <section class="panel" aria-labelledby="research-context-heading">
        <h2 id="research-context-heading">Research Context</h2>
        {lineMemberships.length === 0 ? (
          <p class="empty-state">No recorded research line memberships.</p>
        ) : (
          <ul class="compact-list">
            {lineMemberships.map((membership) => (
              <li>
                <a href={researchLineReaderPath(snapshot, membership.line_id)}>{localizedLineTitle(membership.line_id, membership.line?.title ?? membership.line_id)}</a>
                {membership.line?.reader_status === "candidate" ? <span class="tag">Candidate</span> : null}
              </li>
            ))}
          </ul>
        )}
      </section>

      <EvidenceLedger evidenceRecords={evidenceRecords} versionsById={versionsById} preferredVersion={preferredVersion} />

      <details class="panel provenance-detail" id="provenance-detail">
        <summary>Provenance & Scientific Evidence</summary>
        <p class="layer-intro">Inspect projection, evidence, scientific ontology, and review records.</p>

        <h3>Versions</h3>
        <ul class="compact-list">
          {versions.map((version) => (
            <li><strong>{version.kind}</strong>: {version.title} ({version.id}); Released {version.release_date?.value}{version.arxiv_id ? `; arXiv ${version.arxiv_id}v${version.arxiv_revision}` : ""}{version.doi ? `; DOI ${version.doi}` : ""}</li>
          ))}
        </ul>

        <h3>Scientific Statements</h3>
        <ul class="compact-list">
          {statements.map((statement) => <li><strong>{statement.kind}</strong>: {statement.canonical_text}{statement.reason ? ` — ${statement.reason}` : ""}</li>)}
        </ul>

        <h3>Physical Ontology</h3>
        <dl class="dense-definitions">
          {(work.annotations ?? []).map((annotation: AnyRecord) => (
            <><dt>{annotation.axis}</dt><dd><span class="state">{localizedReviewStatus(annotation.assessment?.state ?? "unavailable")}</span>{(annotation.assessment?.values ?? []).length ? `: ${annotation.assessment.values.map((value: AnyRecord) => value.term_id).join(", ")}` : ""}{annotation.interpretive_risk ? `; risk: ${annotation.interpretive_risk}` : ""}{annotation.reason ? `; ${annotation.reason}` : ""}</dd></>
          ))}
        </dl>

        <h3>Methods</h3>
        <ul class="compact-list">
          {(work.method_annotations ?? []).map((annotation: AnyRecord) => <li><strong>{annotation.technique_id}</strong> <span class="tag">{annotation.basis}</span>{annotation.reason ? ` — ${annotation.reason}` : ""}</li>)}
        </ul>

        <h3>Physical Description</h3>
        <ol class="account-stages">
          {(physicalAccount.stages ?? []).map((stage: AnyRecord) => <li><strong>{stage.label}</strong> <span class="record-label">{stage.id}</span></li>)}
        </ol>
        <ul class="compact-list causal-links">
          {(physicalAccount.links ?? []).map((link: AnyRecord) => <li>{link.source_stage_id} <strong>{link.relation}</strong> {link.target_stage_id}: {link.reason}</li>)}
        </ul>

        <h3>Publication Relations</h3>
        {publicationRelations.length === 0 ? <p>No reviewed publication relations stored for this work.</p> : (
          <ul class="compact-list">
            {publicationRelations.map((relation) => {
              const sources = (relation.bibliographic_source_ids ?? []).map((sourceId: string) => bibliographicSourcesById.get(sourceId)).filter(Boolean) as AnyRecord[];
              return <li>{relation.source_version_id} <strong>{relation.relation}</strong> {relation.target_version_id}{relation.basis ? ` (${relation.basis})` : ""}: {relation.reason}{sources.length === 0 ? " Bibliographic Provenance: unavailable" : <span> Bibliographic Provenance: {sources.map((source) => <span> {source.id} ({source.provider}, {source.record_id}, retrieved {formatSystemTime(source.retrieved_at)}){source.source_url ? <> — <a href={source.source_url}>source</a></> : null}</span>)}</span>}</li>;
            })}
          </ul>
        )}

        <h3>Scientific Connection Evidence</h3>
        {scientificEdges.length === 0 ? <p>No reviewed scientific connections stored for this work.</p> : (
          <ul class="compact-list">
            {scientificEdges.map((edge) => (
              <li><strong>{edge.id}</strong>: {edge.source_work_id} <strong>{localizedRelation(edge.relation)}</strong> {edge.target_work_id}{edge.basis ? `; basis ${edge.basis}` : ""}{edge.disposition ? `; disposition ${localizedReviewStatus(edge.disposition)}` : ""}{edge.reason ? `; ${localizedEdgeReason(edge.id, edge.reason)}` : ""}{edge.review_context?.status ? `; review: ${reviewContext(edge)}` : ""}
                <ul>{(edge.evidence_ids ?? []).map((evidenceId: string) => { const evidence = evidenceById.get(evidenceId); return evidence ? <li><strong>{evidence.id}</strong>{evidence.work_id ? ` (work ${evidence.work_id})` : ""}{` — version ${evidence.version_id}; ${describeLocator(evidence.locator)}; "${evidence.excerpt}"`}{evidence.source_url ? <> — <a href={evidence.source_url}>source</a></> : null}</li> : <li>{evidenceId} — evidence unavailable</li>; })}</ul>
              </li>
            ))}
          </ul>
        )}

        <h3>Version Evidence</h3>
        <ul class="compact-list evidence-list">
          {evidenceRecords.map((evidence) => <li><strong>{evidence.id}</strong>{evidence.work_id ? ` (work ${evidence.work_id})` : ""}{` — version ${evidence.version_id}; ${describeLocator(evidence.locator)}; "${evidence.excerpt}"`}{evidence.source_url ? <> — <a href={evidence.source_url}>source</a></> : null}{evidence.review_context?.status ? `; review: ${reviewContext(evidence)}` : ""}</li>)}
        </ul>
      </details>
        </div>

        <aside class="paper-sticky-sidebar" aria-label="Reading Navigation and Actions">
          <div class="sidebar-sticky-wrapper">
            <nav class="paper-toc" aria-label="Table of Contents">
              <p class="sidebar-kicker">Navigation</p>
              <ul class="toc-list">
                <li><a href="#why-heading">Why This Matters</a></li>
                <li><a href="#problem-heading">Problem</a></li>
                <li><a href="#takeaway-heading">Takeaway</a></li>
                <li><a href="#assumptions-heading">Assumptions</a></li>
                <li><a href="#delta-heading">Scientific Delta</a></li>
                {hasPhysicalAccount && mechanismDAG.totalStages > 0 && (
                  <li><a href="#mechanism-stream-heading">Physical Mechanism</a></li>
                )}
                {!hasPhysicalAccount && (
                  <li><a href="#observational-setup-heading">Empirical Profile</a></li>
                )}
                <li><a href="#connections-heading">Lineage & Connections</a></li>
                <li><a href="#research-context-heading">Research Context</a></li>
                <li><a href="#evidence-ledger-heading">Evidence Ledger</a></li>
                <li><a href="#provenance-detail">Provenance & Deep Ontology</a></li>
              </ul>
            </nav>

            <div class="paper-action-tray">
              <p class="sidebar-kicker">Scholarly Actions</p>
              <button
                type="button"
                class="btn-copy-bibtex"
                data-bibtex={formatWorkBibTeX(work, preferredVersion)}
                aria-label="Copy BibTeX Citation"
                onclick="try{var b=this,orig=b.innerHTML;navigator.clipboard.writeText(b.getAttribute('data-bibtex')).then(function(){b.innerHTML='<span class=\'btn-icon\'>✓</span> Copied!';setTimeout(function(){b.innerHTML=orig;},2000);});}catch(e){}"
              >
                <span class="btn-icon">📋</span> Copy BibTeX
              </button>

              <div class="paper-external-links">
                {scixUrl ? (
                  <a href={scixUrl} target="_blank" rel="noopener noreferrer" class="ext-link-pill">
                    {scixName} ↗
                  </a>
                ) : null}
                {preferredVersion.doi ? (
                  <a href={`https://doi.org/${preferredVersion.doi}`} target="_blank" rel="noopener noreferrer" class="ext-link-pill">
                    DOI ↗
                  </a>
                ) : null}
                {arxivPdfUrl ? (
                  <a href={arxivPdfUrl} target="_blank" rel="noopener noreferrer" class="ext-link-pill">
                    arXiv PDF ↗
                  </a>
                ) : null}
                {arxivHtmlUrl ? (
                  <a href={arxivHtmlUrl} target="_blank" rel="noopener noreferrer" class="ext-link-pill">
                    arXiv HTML ↗
                  </a>
                ) : null}
              </div>
            </div>
          </div>
        </aside>
      </div>

    </main>
  </body>
</html>
