---
import archiveManifest from "../data/arxiv-archives/manifest.json";

interface Props {
  currentDate: string;
}

const { currentDate } = Astro.props;

const allWeeks = (archiveManifest as any).weeks || [];
const allDays = allWeeks
  .flatMap((w: any) => (w.days || []).map((d: any) => ({ ...d, week_id: w.week_id })))
  .sort((a: any, b: any) => b.date.localeCompare(a.date));

const latestDate = (archiveManifest as any).latest_daily_date || (allDays[0]?.date ?? "");

// Take latest 8 dates for the immediate scrollable pills
const recentDays = allDays.slice(0, 8);
---

<nav class="aihot-date-ribbon" aria-label="学术日报日期快速切换">
  <div class="ribbon-inner">
    <div class="ribbon-brand-tag">
      <span class="ribbon-icon">📅</span>
      <span class="ribbon-title">日期速选</span>
    </div>

    <!-- Scrollable Recent Dates Track (AI HOT style) -->
    <div class="ribbon-track-wrap">
      <div class="ribbon-pills-track">
        {recentDays.map((d: any) => {
          const isCurrent = d.date === currentDate;
          const isLatest = d.date === latestDate;
          const targetUrl = isLatest ? "/arxiv-daily/" : `/arxiv-daily/${d.date}/`;
          return (
            <a
              class={`date-pill ${isCurrent ? "active" : ""} ${isLatest ? "pill-latest" : ""}`}
              href={targetUrl}
              title={`切换至 ${d.date} (${d.weekday}) 导读雷达`}
              aria-current={isCurrent ? "page" : undefined}
            >
              {isLatest && <span class="pill-fire-badge">最新</span>}
              <strong class="pill-date">{d.date.slice(5)}</strong>
              <span class="pill-weekday">{d.weekday}</span>
              <span class="pill-count">{d.total_papers}篇</span>
            </a>
          );
        })}
      </div>
    </div>

    <!-- Pure HTML Dropdown for All Historical Dates (Zero Script) -->
    <details class="ribbon-archive-details">
      <summary class="ribbon-archive-summary" title="展开更多历史日期">
        <span>全部往期 ({allDays.length})</span>
        <span class="summary-caret">▾</span>
      </summary>
      <div class="ribbon-archive-dropdown-menu">
        <div class="dropdown-header">
          <span>历史监测批次归档列表</span>
          <a class="dropdown-all-link" href="/arxiv-archives/">查看全局存档库 →</a>
        </div>
        <div class="dropdown-grid">
          {allDays.map((d: any) => {
            const isCurrent = d.date === currentDate;
            const isLatest = d.date === latestDate;
            const targetUrl = isLatest ? "/arxiv-daily/" : `/arxiv-daily/${d.date}/`;
            return (
              <a
                class={`dropdown-day-item ${isCurrent ? "active" : ""}`}
                href={targetUrl}
              >
                <div class="day-item-left">
                  <span class="day-item-date">{d.date}</span>
                  <span class="day-item-weekday">{d.weekday}</span>
                </div>
                <div class="day-item-right">
                  {d.must_read_count > 0 && <span class="badge-must">{d.must_read_count}重点</span>}
                  <span class="badge-total">{d.total_papers}篇</span>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </details>
  </div>
</nav>

<style>
  .aihot-date-ribbon {
    margin: 1.25rem 0 1.5rem 0;
    padding: 0.6rem 0.85rem;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03);
  }
  :global([data-theme="dark"]) .aihot-date-ribbon {
    background: #0f172a;
    border-color: #334155;
  }
  .ribbon-inner {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .ribbon-brand-tag {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: #475569;
    white-space: nowrap;
    padding-right: 0.5rem;
    border-right: 1px solid #e2e8f0;
  }
  :global([data-theme="dark"]) .ribbon-brand-tag {
    color: #94a3b8;
    border-right-color: #334155;
  }
  .ribbon-icon {
    font-size: 1rem;
  }
  .ribbon-track-wrap {
    flex: 1;
    min-width: 240px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    padding: 0.15rem 0;
  }
  .ribbon-pills-track {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    width: max-content;
  }
  .date-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.35rem 0.65rem;
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    font-size: 0.82rem;
    color: #334155;
    text-decoration: none;
    white-space: nowrap;
    transition: all 0.15s ease;
  }
  .date-pill:hover {
    border-color: #3b82f6;
    background: #eff6ff;
    color: #1d4ed8;
  }
  :global([data-theme="dark"]) .date-pill {
    background: #1e293b;
    border-color: #475569;
    color: #cbd5e1;
  }
  :global([data-theme="dark"]) .date-pill:hover {
    background: #1e3a8a33;
    border-color: #60a5fa;
    color: #93c5fd;
  }
  .date-pill.active {
    background: #2563eb;
    border-color: #2563eb;
    color: #ffffff;
    font-weight: 600;
    box-shadow: 0 2px 4px rgba(37, 99, 235, 0.25);
  }
  :global([data-theme="dark"]) .date-pill.active {
    background: #3b82f6;
    border-color: #3b82f6;
    color: #ffffff;
  }
  .pill-fire-badge {
    font-size: 0.68rem;
    font-weight: 700;
    background: #ef4444;
    color: #ffffff;
    padding: 0.05rem 0.25rem;
    border-radius: 4px;
    line-height: 1.1;
  }
  .date-pill.active .pill-fire-badge {
    background: #ffffff;
    color: #dc2626;
  }
  .pill-date {
    font-family: monospace;
    font-size: 0.88rem;
  }
  .pill-weekday {
    font-size: 0.72rem;
    opacity: 0.8;
  }
  .pill-count {
    font-size: 0.72rem;
    opacity: 0.8;
    background: rgba(0, 0, 0, 0.05);
    padding: 0.05rem 0.25rem;
    border-radius: 3px;
  }
  .date-pill.active .pill-count {
    background: rgba(255, 255, 255, 0.25);
  }

  /* Dropdown styles */
  .ribbon-archive-details {
    position: relative;
  }
  .ribbon-archive-summary {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.65rem;
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 600;
    color: #475569;
    cursor: pointer;
    list-style: none;
    user-select: none;
    transition: all 0.15s ease;
  }
  .ribbon-archive-summary::-webkit-details-marker {
    display: none;
  }
  .ribbon-archive-summary:hover {
    border-color: #94a3b8;
    background: #f1f5f9;
  }
  :global([data-theme="dark"]) .ribbon-archive-summary {
    background: #1e293b;
    border-color: #475569;
    color: #cbd5e1;
  }
  .summary-caret {
    font-size: 0.75rem;
    transition: transform 0.15s ease;
  }
  .ribbon-archive-details[open] .summary-caret {
    transform: rotate(180deg);
  }
  .ribbon-archive-dropdown-menu {
    position: absolute;
    right: 0;
    top: calc(100% + 6px);
    width: 320px;
    max-height: 380px;
    overflow-y: auto;
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.15);
    padding: 0.75rem;
    z-index: 50;
  }
  :global([data-theme="dark"]) .ribbon-archive-dropdown-menu {
    background: #0f172a;
    border-color: #334155;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5);
  }
  .dropdown-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.78rem;
    font-weight: 700;
    color: #64748b;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #f1f5f9;
    margin-bottom: 0.5rem;
  }
  :global([data-theme="dark"]) .dropdown-header {
    color: #94a3b8;
    border-bottom-color: #1e293b;
  }
  .dropdown-all-link {
    font-size: 0.75rem;
    color: #2563eb;
    text-decoration: none;
  }
  .dropdown-all-link:hover {
    text-decoration: underline;
  }
  .dropdown-grid {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .dropdown-day-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.4rem 0.6rem;
    border-radius: 6px;
    text-decoration: none;
    font-size: 0.8rem;
    color: #334155;
    background: #f8fafc;
    transition: all 0.12s ease;
  }
  .dropdown-day-item:hover {
    background: #eff6ff;
    color: #1d4ed8;
  }
  :global([data-theme="dark"]) .dropdown-day-item {
    background: #1e293b;
    color: #cbd5e1;
  }
  :global([data-theme="dark"]) .dropdown-day-item:hover {
    background: #1e3a8a44;
    color: #93c5fd;
  }
  .dropdown-day-item.active {
    background: #2563eb;
    color: #ffffff;
    font-weight: 600;
  }
  .day-item-left {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }
  .day-item-date {
    font-family: monospace;
    font-weight: 600;
  }
  .day-item-weekday {
    font-size: 0.72rem;
    opacity: 0.8;
  }
  .day-item-right {
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }
  .badge-must {
    font-size: 0.68rem;
    background: #fee2e2;
    color: #991b1b;
    padding: 0.05rem 0.25rem;
    border-radius: 3px;
  }
  .dropdown-day-item.active .badge-must {
    background: #ffffff;
    color: #dc2626;
  }
  .badge-total {
    font-size: 0.7rem;
    opacity: 0.8;
  }
</style>
