---
import { validateDailyRadarPayload } from "../../../scripts/daily-radar.mjs";
import { loadCanonicalContent } from "../../../scripts/content-loader.mjs";
import { projectVisibleSnapshot } from "../../../scripts/reader-projection.mjs";
import { workReaderPath } from "../../lib/reader-routes";
import SiteNav from "../../components/SiteNav.astro";
import DailyRadarPendingCard from "../../components/DailyRadarPendingCard.astro";
import DailyRadarPrioritySection from "../../components/DailyRadarPrioritySection.astro";
import DailyKnowledgePoint from "../../components/DailyKnowledgePoint.astro";
import DailyDateSwitcher from "../../components/DailyDateSwitcher.astro";
import DailyTopicFilter from "../../components/DailyTopicFilter.astro";
import { formatAnnouncementInBeijing } from "../../domain/academic-domain.mjs";
import { isLegacyChineseDate } from "../../domain/language-cutover.mjs";
import { loadSiteConfig } from "../../lib/site-config";
import "../../styles/global.css";

type AnyRecord = Record<string, any>;

export async function getStaticPaths() {
  const dailyArchiveModules = import.meta.glob<{ default: AnyRecord }>(
    "../../data/arxiv-archives/daily/*.json",
    { eager: true }
  );

  const allArchives = Object.values(dailyArchiveModules)
    .map((mod) => (mod as any).default || mod)
    .sort((a, b) => a.date.localeCompare(b.date));

  const paths: any[] = [];
  const emittedDates = new Set<string>();

  for (let index = 0; index < allArchives.length; index++) {
    const archive = allArchives[index];
    const prevArchive = index > 0 ? allArchives[index - 1] : null;
    const nextArchive = index < allArchives.length - 1 ? allArchives[index + 1] : null;
    const bjtInfo = formatAnnouncementInBeijing(archive.date, archive.weekday);

    if (!emittedDates.has(archive.date)) {
      emittedDates.add(archive.date);
      paths.push({
        params: { date: archive.date },
        props: {
          archive,
          prevDate: prevArchive ? prevArchive.date : null,
          nextDate: nextArchive ? nextArchive.date : null,
        },
      });
    }
  }

  return paths;
}

const { date } = Astro.params;
const { archive, prevDate, nextDate } = Astro.props as {
  archive: AnyRecord;
  prevDate: string | null;
  nextDate: string | null;
};

const site = loadSiteConfig();
const snapshot = await loadCanonicalContent(new URL("../../../content/", import.meta.url));
const visibleReader = projectVisibleSnapshot(snapshot) as AnyRecord;

function preferredVersion(work: AnyRecord) {
  const preferredVersionId = work.preferred_version_id ?? work.preferred_version?.version_id;
  return Array.isArray(work.versions)
    ? work.versions.find((version: AnyRecord) => version.id === preferredVersionId)
    : null;
}

const visibleWorkLinks = Object.fromEntries(
  (visibleReader.works ?? [])
    .map((work: AnyRecord): readonly [string, { href: string; title: string }] | null => {
      const version = preferredVersion(work);
      if (typeof work.work_id !== "string" || typeof version?.title !== "string" || version.title.trim() === "") return null;
      return [work.work_id, { href: workReaderPath(snapshot, work.work_id), title: version.title }] as const;
    })
    .filter((entry: readonly [string, { href: string; title: string }] | null): entry is readonly [string, { href: string; title: string }] => entry !== null),
);

const radarValidation = validateDailyRadarPayload(archive.feed, archive.radar, {
  visibleWorkIds: Object.keys(visibleWorkLinks),
});

if (radarValidation.fatalDiagnostics?.length > 0 || (!radarValidation.fatalDiagnostics && !radarValidation.valid)) {
  throw new Error(`Daily Radar archive payload for ${date} is invalid: ${radarValidation.diagnostics.join(", ")}`);
}

const model = radarValidation.model;
const priorityGroups = model.groups as AnyRecord;

function pendingLabel(reason: string) {
  return {
    analysis_missing: "Pending analysis",
    analysis_failed: "Analysis failed",
    analysis_invalid: "Invalid analysis record",
    analysis_pending: "Analysis pending",
    source_changed: "Source changed, previous brief invalid",
    analysis_revision_mismatch: "Revision mismatch, previous brief invalid",
    coverage_insufficient_must_read: "Insufficient full-text coverage, not recommended",
    coverage_insufficient_worth_knowing: "Insufficient body evidence, not grouped here",
  }[reason] ?? "Pending verification";
}

const bjtInfo = formatAnnouncementInBeijing(archive.date, archive.weekday);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content={`arXiv Daily Academic Brief Archive · ${bjtInfo.beijingDate} (US Date ${archive.date}): High-energy astrophysical transient monitoring and tiered analysis.`}
    />
    <title>Daily Radar · {bjtInfo.beijingDate} · {site.title}</title>
  </head>
  <body>
    <main class="site-shell index-page reader-page radar-page archive-standalone-page">
      <SiteNav />

      <p class="eyebrow">
        <a href="/">{site.title}</a> · <a href="/arxiv-daily/">Daily Radar</a> · Archive
      </p>

      <!-- Historical Archive Banner -->
      <section class="standalone-archive-banner" aria-label="Archive Batch Navigation">
        <div class="archive-banner-left">
          <span class="banner-badge-archive">📅 Archive Batch</span>
          <strong class="banner-date">{bjtInfo.beijingDate}</strong>
          <span class="banner-meta-pill">US Date: {archive.date} ({archive.weekday})</span>
          <span class="banner-meta-pill">Week: {archive.week_id}</span>
          <span class="banner-meta-pill">{archive.batch_id}</span>
        </div>
        <div class="archive-banner-right">
          <a class="banner-nav-link" href="/arxiv-daily/">
            ← Latest Daily
          </a>
          <a class="banner-nav-link" href="/arxiv-weekly/">
            Weekly Synthesis →
          </a>
        </div>
      </section>

      <header class="reader-header">
        <h1>Daily arXiv Reading Guide · Archive</h1>
        {isLegacyChineseDate(archive.date) && (
          <div class="legacy-archive-banner" role="note">
            <span class="legacy-badge">Legacy Archive</span>
            <span>This edition was generated prior to the English transition ({archive.date}) and contains historical Chinese text.</span>
          </div>
        )}
        <div class="historical-quick-stats">
          <span class="stat-pill total">Total: <strong>{model.counts.total}</strong></span>
          <span class="stat-pill analyzed">Analyzed: <strong>{model.counts.analyzed}</strong></span>
          <span class="stat-pill must">Must Read: <strong>{priorityGroups.must_read?.length ?? 0}</strong></span>
          <span class="stat-pill worth">Followed: <strong>{priorityGroups.worth_knowing?.length ?? 0}</strong></span>
          <span class="stat-pill skim">Skim: <strong>{priorityGroups.skip?.length ?? 0}</strong></span>
        </div>
      </header>

      <!-- Consolidated AI HOT Date Switcher & Filter Ribbon -->
      <DailyDateSwitcher currentDate={archive.date} groups={priorityGroups} />

      <!-- Standalone Date Pager -->
      <nav class="standalone-date-pager" aria-label="Daily Brief Archive Switcher">
        <div class="pager-col left">
          {prevDate ? (
            <a class="date-pager-btn" href={`/arxiv-daily/${prevDate}/`} title={`Switch to previous day: ${prevDate}`}>
              ← Previous ({prevDate})
            </a>
          ) : (
            <span class="date-pager-btn disabled">Earliest Archive</span>
          )}
        </div>
        <div class="pager-col center">
          <a class="date-pager-btn overview" href="/arxiv-archives/">
            🗓️ View All Archives
          </a>
        </div>
        <div class="pager-col right">
          {nextDate ? (
            <a class="date-pager-btn" href={`/arxiv-daily/${nextDate}/`} title={`Switch to next day: ${nextDate}`}>
              Next ({nextDate}) →
            </a>
          ) : (
            <a class="date-pager-btn" href="/arxiv-daily/" title="Go to latest daily brief">
              Today's Latest Brief →
            </a>
          )}
        </div>
      </nav>

      {priorityGroups.must_read.length === 0 && (
        <aside class="no-must-read-notice" role="status">
          <div class="notice-icon">ℹ️</div>
          <div class="notice-body">
            <strong class="notice-title">Batch Note</strong>
            <p class="notice-text">No must-read breakthrough in this edition; focused on the following works.</p>
          </div>
        </aside>
      )}

      <div class="daily-radar-content-wrap">
        <DailyTopicFilter groups={priorityGroups} />

        <DailyRadarPrioritySection
          id="must-read"
          items={priorityGroups.must_read}
          primaryLabel="Must Read"
          englishLabel="Must Read"
          visibleWorkLinks={visibleWorkLinks}
        />

        <DailyRadarPrioritySection
          id="worth-knowing"
          items={priorityGroups.worth_knowing}
          primaryLabel="Follow"
          englishLabel="Followed"
          visibleWorkLinks={visibleWorkLinks}
        />

        {priorityGroups.skip && priorityGroups.skip.length > 0 && (
          <details class="radar-priority-section skip-section">
            <summary>
              <span>Skim (collapsed by default)</span>
            </summary>
            <DailyRadarPrioritySection
              id="skim"
              items={priorityGroups.skip}
              primaryLabel="Skim"
              englishLabel="Skim"
              visibleWorkLinks={visibleWorkLinks}
            />
          </details>
        )}
      </div>

      {model.knowledge_points && model.knowledge_points.length > 0 && (
        <section class="radar-section" id="knowledge-points">
          <p class="section-kicker">Learning supplement</p>
          <h2>Knowledge point</h2>
          {model.knowledge_points.map((point: any) => (
            <>
              <div><DailyKnowledgePoint point={point} /></div>
            </>
          ))}
        </section>
      )}

      <details class="radar-status-disclosure">
        <summary>
          <span>Historical Sources & Pending Items</span>
        </summary>
        <div class="radar-status-body">
          <p>
            Batch {archive.batch_id} (Date {archive.date}): {model.counts.total} candidates, {model.counts.analyzed} verified briefs, {model.pending?.length ?? 0} pending verification.
          </p>
          <p class="record-label">Query: {model.edition.query ?? archive.feed?.query ?? "Unrecorded"}</p>
          <section class="radar-section" id="pending-analysis">
            <p class="section-kicker">Analysis status</p>
            <h2>Pending analysis</h2>
            <ol class="paper-index radar-list">
              {model.pending.map((item: any) => (
                <DailyRadarPendingCard item={item} pendingLabel={pendingLabel(item.pending_reason)} />
              ))}
            </ol>
          </section>
        </div>
      </details>
    </main>
  </body>
</html>
