  :global(.daily-radar-content-wrap:has(#filter-daily-frb:checked) #worth-knowing:not(:has(.radar-list-item[data-tags*="FRB"]))) {
    display: none !important;
  }
  :global(.daily-radar-content-wrap:has(#filter-daily-frb:checked) .skip-section:not(:has(.radar-list-item[data-tags*="FRB"]))) {
    display: none !important;
  }

  :global(.daily-radar-content-wrap:has(#filter-daily-sn:checked) .radar-list-item:not([data-tags*="SN"])) {
    display: none !important;
  }
  :global(.daily-radar-content-wrap:has(#filter-daily-sn:checked) #must-read:not(:has(.radar-list-item[data-tags*="SN"]))) {
    display: none !important;
  }
  :global(.daily-radar-content-wrap:has(#filter-daily-sn:checked) #worth-knowing:not(:has(.radar-list-item[data-tags*="SN"]))) {
