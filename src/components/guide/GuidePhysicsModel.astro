---
import ReaderText from "../ReaderText.astro";
import { normalizeStructuredClaim } from "../../domain/academic-domain.mjs";

interface Props {
  assumptions?: string[];
  figures?: any[];
  result?: string;
  limits?: string[];
  resultSectionLabel?: string;
  resultSectionLabelEnglish?: string;
}

const {
  assumptions = [],
  figures = [],
  result,
  limits = [],
  resultSectionLabel = "作者报告的结果与边界",
  resultSectionLabelEnglish = "Author-reported results and limits",
} = Astro.props;

const hasAssumptions = Array.isArray(assumptions) && assumptions.length > 0;
const hasFigures = Array.isArray(figures) && figures.length > 0;
const hasResult = Boolean(result && result.trim() !== "");
const hasLimits = Array.isArray(limits) && limits.length > 0;

const resultClaim = normalizeStructuredClaim(result, "核心结果");
---

<div class="guide-module-panel guide-physics-model">
  <div class="module-header">
    <span class="module-icon">📐</span>
    <h4 class="module-title">
      <span class="language-primary">物理假设、图表与结果边界</span>
      <span class="language-english" lang="en">Physical Models, Figures & Results</span>
    </h4>
  </div>

  <div class="module-content">
    {hasAssumptions && (
      <div class="guide-field-block">
        <div class="guide-lead-row">
          <span class="guide-tag tag-assumption">📐 物理假设</span>
        </div>
        <ul class="guide-bullet-list">
          {assumptions.map((item: string) => (
            <li><ReaderText text={item} /></li>
          ))}
        </ul>
      </div>
    )}

    {hasFigures && (
      <div class="guide-field-block figures-block">
        <div class="guide-lead-row">
          <span class="guide-tag tag-figure">📊 核心图表</span>
        </div>
        <div class="schematic-figures-grid">
          {figures.map((fig: any) => (
            <figure class="paper-schematic-figure">
              <a href={fig.url} target="_blank" rel="noopener noreferrer" title="点击查看原始高清大图">
                <img src={fig.url} alt={fig.caption || "核心科学图表"} loading="lazy" />
              </a>
              {fig.caption && (
                <figcaption>
                  <span class={`fig-badge fig-badge-${fig.category || "theoretical"}`}>
                    {fig.category_badge || fig.label || "科学图表"}
                  </span>
                  <ReaderText text={fig.caption} />
                </figcaption>
              )}
            </figure>
          ))}
        </div>
      </div>
    )}

    {hasResult && (
      <div class="guide-field-block">
        <div class="guide-lead-row">
          <span class="guide-tag tag-result">🏁 {resultSectionLabel}</span>
          <strong class="claim-headline">{resultClaim.headline}</strong>
        </div>
        {resultClaim.detailed_text && resultClaim.detailed_text !== resultClaim.headline && (
          <div class="claim-body-text">
            <ReaderText text={resultClaim.detailed_text} />
          </div>
        )}
      </div>
    )}

    {hasLimits && (
      <div class="guide-field-block">
        <div class="guide-lead-row">
          <span class="guide-tag tag-limit">⚠️ 物理边界与局限</span>
        </div>
        <ul class="guide-bullet-list guide-limits-list">
          {limits.map((item: string) => (
            <li><ReaderText text={item} /></li>
          ))}
        </ul>
      </div>
    )}
  </div>
</div>

<style>
  .guide-module-panel {
    background: var(--bg-surface, #ffffff);
    border: 1px solid var(--border-color, #e2e8f0);
    border-radius: 0.45rem;
    overflow: hidden;
  }
  :global([data-theme="dark"]) .guide-module-panel {
    background: #1e293b;
    border-color: #334155;
  }
  .module-header {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.75rem;
    background: #f8fafc;
    border-bottom: 1px solid var(--border-color, #e2e8f0);
  }
  :global([data-theme="dark"]) .module-header {
    background: #0f172a;
    border-bottom-color: #334155;
  }
  .module-icon {
    font-size: 0.95rem;
  }
  .module-title {
    margin: 0;
    font-size: 0.86rem;
    font-weight: 700;
    color: var(--text-heading, #0f172a);
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }
  :global([data-theme="dark"]) .module-title {
    color: #f8fafc;
  }
  .module-content {
    padding: 0.55rem 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .guide-field-block {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .guide-lead-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.45rem;
    line-height: 1.45;
  }
  .guide-tag {
    display: inline-flex;
    align-items: center;
    padding: 0.08rem 0.4rem;
    font-size: 0.72rem;
    font-weight: 700;
    border-radius: 0.25rem;
    letter-spacing: 0.02em;
    flex-shrink: 0;
  }
  .tag-assumption {
    background: #ede9fe;
    color: #5b21b6;
    border: 1px solid #ddd6fe;
  }
  .tag-figure {
    background: #e0f2fe;
    color: #0369a1;
    border: 1px solid #bae6fd;
  }
  .tag-result {
    background: #eff6ff;
    color: #1d4ed8;
    border: 1px solid #bfdbfe;
  }
  .tag-limit {
    background: #fff1f2;
    color: #be123c;
    border: 1px solid #fecdd3;
  }
  :global([data-theme="dark"]) .tag-assumption {
    background: #2e1065;
    color: #c4b5fd;
    border-color: #6d28d9;
  }
  :global([data-theme="dark"]) .tag-figure {
    background: #082f49;
    color: #7dd3fc;
    border-color: #0284c7;
  }
  :global([data-theme="dark"]) .tag-result {
    background: #1e3a5f;
    color: #93c5fd;
    border-color: #2563eb;
  }
  :global([data-theme="dark"]) .tag-limit {
    background: #4c0519;
    color: #fda4af;
    border-color: #e11d48;
  }
  .claim-headline {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-heading, #0f172a);
    line-height: 1.45;
  }
  :global([data-theme="dark"]) .claim-headline {
    color: #f1f5f9;
  }
  .claim-body-text {
    font-size: 0.84rem;
    line-height: 1.55;
    color: var(--text-body, #475569);
    padding-left: 0.5rem;
    border-left: 2px solid var(--border-color, #e2e8f0);
    margin-top: 0.15rem;
  }
  :global([data-theme="dark"]) .claim-body-text {
    color: #94a3b8;
    border-left-color: #334155;
  }
  .guide-bullet-list {
    margin: 0.15rem 0 0.15rem 0.5rem;
    padding-left: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-size: 0.84rem;
    line-height: 1.5;
    color: var(--text-body, #334155);
  }
  :global([data-theme="dark"]) .guide-bullet-list {
    color: #cbd5e1;
  }
  .guide-limits-list {
    color: #b91c1c;
  }
  :global([data-theme="dark"]) .guide-limits-list {
    color: #fca5a5;
  }
  .figures-block {
    margin: 0.2rem 0;
  }
  .schematic-figures-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.5rem;
    margin-top: 0.25rem;
  }
  .paper-schematic-figure {
    margin: 0;
    border: 1px solid var(--border-color, #e2e8f0);
    border-radius: 0.35rem;
    overflow: hidden;
    background: var(--bg-primary, #ffffff);
  }
  :global([data-theme="dark"]) .paper-schematic-figure {
    border-color: #334155;
    background: #0f172a;
  }
  .paper-schematic-figure img {
    width: 100%;
    max-height: 190px;
    object-fit: contain;
    background: #ffffff;
    display: block;
    cursor: zoom-in;
    transition: transform 0.2s;
  }
  .paper-schematic-figure img:hover {
    transform: scale(1.02);
  }
  .paper-schematic-figure figcaption {
    padding: 0.35rem 0.5rem;
    font-size: 0.76rem;
    line-height: 1.4;
    color: var(--text-secondary, #475569);
    border-top: 1px solid var(--border-color, #e2e8f0);
  }
  :global([data-theme="dark"]) .paper-schematic-figure figcaption {
    color: #94a3b8;
    border-top-color: #334155;
  }
  .fig-badge {
    display: inline-block;
    padding: 0.06rem 0.3rem;
    font-size: 0.66rem;
    font-weight: 700;
    border-radius: 0.2rem;
    margin-right: 0.3rem;
  }
  .fig-badge-theoretical {
    background: #f3e8ff;
    color: #6b21a8;
  }
  .fig-badge-observational {
    background: #e0f2fe;
    color: #0369a1;
  }
  .fig-badge-fitting {
    background: #fef08a;
    color: #854d0e;
  }
  :global([data-theme="dark"]) .fig-badge-theoretical {
    background: #3b0764;
    color: #d8b4fe;
  }
  :global([data-theme="dark"]) .fig-badge-observational {
    background: #082f49;
    color: #7dd3fc;
  }
  :global([data-theme="dark"]) .fig-badge-fitting {
    background: #422006;
    color: #fde047;
  }
</style>
