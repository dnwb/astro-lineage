---
import { loadCanonicalContent } from "../../../scripts/content-loader.mjs";
import { projectBaselineSnapshot } from "../../../scripts/reader-projection.mjs";
import { learningPathReaderPath } from "../../lib/reader-routes";
import { localizedPathTitle } from "../../lib/reader-localization";
import { loadSiteConfig } from "../../lib/site-config";
import SiteNav from "../../components/SiteNav.astro";
import "../../styles/global.css";

type AnyRecord = Record<string, any>;

const site = loadSiteConfig();
const snapshot = await loadCanonicalContent(new URL("../../../content/", import.meta.url));
const reader = projectBaselineSnapshot(snapshot) as Record<string, any>;
const learningPaths = (reader.learning_paths ?? []) as AnyRecord[];
const publishedCount = learningPaths.filter((path) => path.reader_status === "published").length;
const candidateCount = learningPaths.filter((path) => path.reader_status === "candidate").length;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content={`The reviewed Learning Paths in ${site.title}.`}
    />
    <title>学习路径 · {site.title}</title>
  </head>
  <body>
    <main class="site-shell index-page">
      <SiteNav />
      <p class="eyebrow"><a href="/">{site.title}</a> · 学习路径索引</p>
      <h1>学习路径</h1>
      <p class="layer-intro">{learningPaths.length} 条学习路径：{publishedCount} 条已审核，{candidateCount} 条候选基准路径</p>
      <p class="reader-note">候选基准路径用于组织完整文献库的阅读顺序，教学内容已经写入页面，但尚未获得人工审核发布。</p>
      {
        learningPaths.length === 0 ? (
          <p class="empty-state">暂无经过审核的学习路径。</p>
        ) : (
          <ol class="paper-index">
            {learningPaths.map((path) => (
              <li class="paper-index-item">
                <article>
                  <h2>
                    <a class="paper-title" href={learningPathReaderPath(snapshot, path.path_id)}>
                      {localizedPathTitle(path.path_id, path.title ?? path.path_id)}
                    </a>
                  </h2>
                  <p class="original-title" lang="en">英文标题：{path.title ?? path.path_id}</p>
                  <p><span class="tag">{path.reader_status === "candidate" ? "候选基准路径" : "已审核路径"}</span></p>
                  <p class="paper-meta">{path.entries?.length ?? 0} 篇论文 · {path.transitions?.length ?? 0} 段“下一步”说明</p>
                  <p><a class="browse-link" href={learningPathReaderPath(snapshot, path.path_id)}>打开学习路径</a></p>
                </article>
              </li>
            ))}
          </ol>
        )
      }
    </main>
  </body>
</html>
