  :global(.daily-radar-content-wrap:has(#filter-daily-grb:checked) #must-read:not(:has(.radar-list-item[data-tags*="GRB"]))) {
    display: none !important;
  }
  :global(.daily-radar-content-wrap:has(#filter-daily-grb:checked) #worth-knowing:not(:has(.radar-list-item[data-tags*="GRB"]))) {
    display: none !important;
  }
  :global(.daily-radar-content-wrap:has(#filter-daily-grb:checked) .skip-section:not(:has(.radar-list-item[data-tags*="GRB"]))) {
    display: none !important;
  }

  :global(.daily-radar-content-wrap:has(#filter-daily-gw:checked) .radar-list-item:not([data-tags*="GW"])) {
    display: none !important;
  }
  :global(.daily-radar-content-wrap:has(#filter-daily-gw:checked) #must-read:not(:has(.radar-list-item[data-tags*="GW"]))) {
    display: none !important;
  }
  :global(.daily-radar-content-wrap:has(#filter-daily-gw:checked) #worth-knowing:not(:has(.radar-list-item[data-tags*="GW"]))) {
    display: none !important;
  }
  :global(.daily-radar-content-wrap:has(#filter-daily-gw:checked) .skip-section:not(:has(.radar-list-item[data-tags*="GW"]))) {
    display: none !important;
  }

  :global(.daily-radar-content-wrap:has(#filter-daily-mag:checked) .radar-list-item:not([data-tags*="MAG"])) {
    display: none !important;
  }
  :global(.daily-radar-content-wrap:has(#filter-daily-mag:checked) #must-read:not(:has(.radar-list-item[data-tags*="MAG"]))) {
    display: none !important;
