---
import ReadingProse from "../../components/ReadingProse.astro";
import { loadCanonicalContent } from "../../../scripts/content-loader.mjs";
import { projectLearningPathForReader } from "../../../scripts/reader-projection.mjs";
import { workReaderPath } from "../../lib/reader-routes";
import "../../styles/global.css";

type AnyRecord = Record<string, any>;
type LearningPathBundle = { id: string; slug: string; path: AnyRecord };

export async function getStaticPaths() {
  const snapshot = await loadCanonicalContent(new URL("../../../content/", import.meta.url));
  return (snapshot.learningPaths as LearningPathBundle[])
    .filter((path) => projectLearningPathForReader(snapshot, path.id) !== null)
    .map((path) => ({ params: { id: path.slug }, props: { pathId: path.id } }));
}

const { pathId } = Astro.props;
const snapshot = await loadCanonicalContent(new URL("../../../content/", import.meta.url));
const learningPath = projectLearningPathForReader(snapshot, pathId) as AnyRecord | null;
if (!learningPath) {
  throw new Error(`Visible Learning Path not found: ${pathId}`);
}

const entries = (learningPath.entries ?? []) as AnyRecord[];
const transitions = (learningPath.transitions ?? []) as AnyRecord[];
const steps = entries.map((entry, index) => ({
  entry,
  transition: transitions[index] ?? null,
}));

function workTitle(entry: AnyRecord) {
  return entry.work?.title ?? entry.work_id;
}

function workAuthors(entry: AnyRecord) {
  return (entry.work?.authors ?? [])
    .map((author: AnyRecord) => author.display_name)
    .filter(Boolean)
    .join(", ");
}

function workDate(entry: AnyRecord) {
  return entry.work?.release_date?.value ?? "release date unavailable";
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content={`Learning Path: ${learningPath.title ?? pathId}`}
    />
    <title>{learningPath.title ?? pathId} · High-Energy Transient Reading Radar</title>
  </head>
  <body>
    <main class="site-shell reader-page">
      <p class="eyebrow"><a href="/">High-Energy Transient Reading Radar</a> · Learning Path</p>
      <header class="reader-header">
        <p class="record-label">Learning Path ID: {pathId}</p>
        <h1>{learningPath.title ?? pathId}</h1>
        <p class="reader-deck">An ordered, reviewed sequence of Works. Transition reasons are path-local pedagogical context, not Scientific Edges.</p>
      </header>

      <section class="panel reader-view" aria-labelledby="path-reader-view-heading">
        <p class="section-kicker">Inspection layer 1</p>
        <h2 id="path-reader-view-heading">Reader View</h2>
        <ReadingProse source={String(learningPath.reading ?? "")} />
      </section>

      <section class="panel" aria-labelledby="reading-sequence-heading">
        <p class="section-kicker">Ordered pedagogy</p>
        <h2 id="reading-sequence-heading">Reading sequence</h2>
        <ol class="path-sequence">
          {steps.map(({ entry, transition }, index) => (
            <li class="path-step">
              <span class="step-number">{index + 1}</span>
              <div>
                <a class="paper-title" href={workReaderPath(snapshot, entry.work_id)}>{workTitle(entry)}</a>
                <p class="step-meta">
                  Preferred Version: {entry.work?.preferred_version_id ?? "unavailable"}.
                  {workAuthors(entry) ? ` ${workAuthors(entry)}.` : ""}
                  {` Release date: ${workDate(entry)}.`}
                </p>
                {transition ? (
                  <p class="transition-reason"><strong>Why this next:</strong> {transition.reason}</p>
                ) : null}
              </div>
            </li>
          ))}
        </ol>
      </section>

      <details class="panel provenance-detail">
        <summary>Provenance Detail</summary>
        <h2>Path review</h2>
        <p>
          <span class="tag">{learningPath.review_context?.status ?? "review status unavailable"}</span>
          {learningPath.review_context?.reviewer_actor_id
            ? ` by ${learningPath.review_context.reviewer_actor_id}`
            : ""}
          {learningPath.review_context?.reviewed_at
            ? ` at ${learningPath.review_context.reviewed_at}`
            : ""}
        </p>
        <h3>Pedagogical Transitions</h3>
        <ul class="compact-list">
          {transitions.map((transition: AnyRecord) => (
            <li>
              {transition.source_work_id} <strong>→</strong> {transition.target_work_id}: {transition.reason}
            </li>
          ))}
        </ul>
      </details>
    </main>
  </body>
</html>
