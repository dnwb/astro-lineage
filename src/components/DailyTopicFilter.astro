---
import { matchScientificTags, TOPIC_FILTER_SPECS } from "../domain/academic-domain.mjs";

interface Props {
  groups?: {
    must_read?: any[];
    worth_knowing?: any[];
    skip?: any[];
  };
}

const { groups = {} } = Astro.props;
const mustItems = groups.must_read || [];
const worthItems = groups.worth_knowing || [];
const skipItems = groups.skip || [];
const allItems = [...mustItems, ...worthItems, ...skipItems];
const totalCount = allItems.length;
const mustCount = mustItems.length;
const worthCount = worthItems.length;
const skipCount = skipItems.length;

const topicCounts: Record<string, number> = {};
for (const item of allItems) {
  const tags = matchScientificTags(item);
  for (const t of tags) {
    topicCounts[t] = (topicCounts[t] || 0) + 1;
  }
}

const activeTopicFilters = TOPIC_FILTER_SPECS
  .map((spec) => ({ ...spec, count: topicCounts[spec.id] || 0 }))
  .filter((spec) => spec.count > 0);
---

{totalCount > 0 && (
  <div class="daily-filter-bar" role="tablist" aria-label="按主题与标签筛选日报论文">
    <span class="daily-filter-title">🏷️ 标签筛选：</span>

    <input type="radio" name="daily-topic-filter" id="filter-daily-all" class="daily-topic-radio" checked />
    <label for="filter-daily-all" class="daily-filter-pill">全部 ({totalCount})</label>

    {mustCount > 0 && (
      <>
        <input type="radio" name="daily-topic-filter" id="filter-daily-must" class="daily-topic-radio" />
        <label for="filter-daily-must" class="daily-filter-pill pill-must">⭐ 必读 ({mustCount})</label>
      </>
    )}

    {worthCount > 0 && (
      <>
        <input type="radio" name="daily-topic-filter" id="filter-daily-worth" class="daily-topic-radio" />
        <label for="filter-daily-worth" class="daily-filter-pill pill-worth">📌 关注 ({worthCount})</label>
      </>
    )}

    {skipCount > 0 && (
      <>
        <input type="radio" name="daily-topic-filter" id="filter-daily-skim" class="daily-topic-radio" />
        <label for="filter-daily-skim" class="daily-filter-pill pill-skim">⚡ 略读 ({skipCount})</label>
      </>
    )}

    {activeTopicFilters.map((t) => (
      <>
        <input type="radio" name="daily-topic-filter" id={`filter-daily-${t.id.toLowerCase()}`} class="daily-topic-radio" />
        <label for={`filter-daily-${t.id.toLowerCase()}`} class="daily-filter-pill pill-topic">
          {t.emoji ? `${t.emoji} ` : ""}{t.short} ({t.count})
        </label>
      </>
    ))}
  </div>
)}

