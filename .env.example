# AstroLineage Environment Variables Template (.env.example)

# AI Gateway Configuration (Unified on localhost:8318)
OPENAI_BASE_URL=http://localhost:8318/v1
IOA_API_KEY=your_ioa_api_key_here

# Optional Local AGY Daemon Integration (for Google Gemini direct execution)
# Set ENABLE_AGY=true to enable local agy fallback when 8318 gateway fails
# Models can also be prefixed with agy/ (e.g. agy/gemini-3.8-flash-medium) to route directly to agy daemon
ENABLE_AGY=true
# AI_BACKEND=agy

# Tiered Model Configuration
# - Background arXiv Scrape, Skim & Triage:
AI_MODEL=gpt-6-luna
AI_MODEL_TRIAGE=gpt-6-luna
AI_TRIAGE_FALLBACK_MODELS=agy/gemini-3.8-flash-medium,gpt-5.6-luna

# - Deep Reading (full body / chunks / synthesis):
AI_MODEL_BODY=agy/gemini-3.8-flash-medium
AI_BODY_FALLBACK_MODELS=gpt-6.1-sol,gpt-6-sol
AI_MODEL_LEARNING=agy/gemini-3.8-flash-medium
AI_FALLBACK_MODELS=gpt-6.1-sol,gpt-6-sol
REASONING_EFFORT=medium
AI_CONCURRENCY=3

# Chat Agent Bot Configuration (QQ Bot QA)
BOT_AI_MODEL=terra
BOT_FALLBACK_MODELS=agy/gemini-3.8-flash-medium,gpt-6.1-sol,gpt-6-astra,gpt-6-sol
BOT_REASONING_EFFORT=medium

# Site & Service URL Configuration
PUBLIC_SITE_URL=https://astro-lineage.pages.dev
LOCAL_SITE_URL=http://10.131.43.83:4321
SITE_BASE_URL=https://astro-lineage.pages.dev
# Set to true to automatically commit & push data in cron-runner to trigger Cloudflare build
CRON_GIT_PUSH=false
# Sliding window (in academic weeks) for syncing paper figures to Git & Cloudflare Pages (default: 7)
SYNC_FIGURES_WEEKS=7
# Maximum storage budget (in MB) for synced paper figures in Git (default: 300)
SYNC_FIGURES_MAX_MB=300

# Official QQ Bot Configuration (QQ Open Platform https://q.qq.com)
QQ_APP_ID=your_qq_app_id_here
QQ_APP_SECRET=your_qq_app_secret_here
QQ_BOT_SANDBOX=false
QQ_ADMIN_OPENID=your_admin_openid_here

# Tencent Docs & Guild Community Configuration
TENCENT_DOCS_TOKEN=your_tencent_docs_token_here
TENCENT_GUILD_ID=your_guild_id_here
TENCENT_DAILY_CHANNEL_ID=your_daily_channel_id_here
TENCENT_WEEKLY_CHANNEL_ID=your_weekly_channel_id_here
TENCENT_BOT_USER_ID=your_bot_user_id_here
