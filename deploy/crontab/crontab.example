# ==============================================================================
# AstroLineage arXiv 定时抓取、AI 研判与频道自动发布 Crontab 任务配置（已合并）
#
# 时序与合并机制：
#   - 每天统一在【上午 10:00 (北京时间)】执行一次；
#   - 避开冬夏令时交替与官方 API 索引延迟；
#   - 周一至周四：执行每日批次抓取、AI 研判、构建页面并自动推送到【每日arXiv导读】版块；
#   - 每周五：每日批次抓取研判完成后，自动追加执行【每周学术脉络总结】，并推送到【前沿学术周报】版块。
#   - 单个统一日志文件：/tmp/arxiv-task.log
# ==============================================================================

# 基础环境变量（cron 默认环境较精简，必须显式定义）
SHELL=/bin/bash
PATH=/home/long/.npm-global/bin:/usr/local/bin:/usr/bin:/bin:/home/long/.local/bin
PROJECT_DIR=/home/long/axvdaily

# 指定 cron 时区为北京时间（系统 cronie 支持 CRON_TZ 变量）
CRON_TZ=Asia/Shanghai

# ------------------------------------------------------------------------------
# 统一前沿学术调度任务：周一至周五上午 10:00 (北京时间)
# ------------------------------------------------------------------------------
0 10 * * 1-5 /bin/bash /home/long/axvdaily/scripts/cron-runner.sh auto >> /tmp/arxiv-task.log 2>&1
