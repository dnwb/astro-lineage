---
import LanguageSwitch from "./LanguageSwitch.astro";
import ThemeToggle from "./ThemeToggle.astro";

const currentPath = Astro.url.pathname;
const isCurrent = (path: string) => {
  if (path === "/" && currentPath === "/") return true;
  if (path !== "/" && currentPath.startsWith(path)) return true;
  return false;
};
---

<nav class="site-nav" aria-label="主导航">
  <a class="site-brand" href="/" aria-current={isCurrent("/") && currentPath === "/" ? "page" : undefined}>AstroLineage</a>
  <ul>
    <li><a href="/arxiv-daily/" aria-current={isCurrent("/arxiv-daily/") ? "page" : undefined} class={isCurrent("/arxiv-daily/") ? "active" : undefined}>每日 arXiv</a></li>
    <li><a href="/arxiv-weekly/" aria-current={isCurrent("/arxiv-weekly/") ? "page" : undefined} class={isCurrent("/arxiv-weekly/") ? "active" : undefined}>每周总结</a></li>
    <li><a href="/arxiv-archives/" aria-current={isCurrent("/arxiv-archives/") ? "page" : undefined} class={isCurrent("/arxiv-archives/") ? "active" : undefined}>往期归档</a></li>
    <li><a href="/events/" aria-current={isCurrent("/events/") ? "page" : undefined} class={isCurrent("/events/") ? "active" : undefined}>📅 爆发事件</a></li>
    <li><a href="/agent/" aria-current={isCurrent("/agent/") ? "page" : undefined} class={`agent-nav-tab ${isCurrent("/agent/") ? "active" : ""}`} title="Agent 接入与 OpenAPI">🤖 Agent</a></li>
    <li><a href="https://github.com/dnwb/astro-lineage/issues" target="_blank" rel="noopener noreferrer" class="feedback-nav-link" title="GitHub 反馈">💬 反馈 ↗</a></li>
  </ul>
  <div class="nav-actions">
    <ThemeToggle />
    <LanguageSwitch />
  </div>
</nav>

