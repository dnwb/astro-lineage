---
import ReadingProse from "../../components/ReadingProse.astro";
import { loadCanonicalContent } from "../../../scripts/content-loader.mjs";
import { parseReadingMarkdown } from "../../../scripts/reader-markdown.mjs";
import {
  projectBaselineSnapshot,
} from "../../../scripts/reader-projection.mjs";
import { workReaderPath } from "../../lib/reader-routes";
import {
  localizedLineQuestion,
  localizedLineTitle,
  localizedMembershipReason,
  localizedRole,
  localizedWorkTitle,
} from "../../lib/reader-localization";
import { loadSiteConfig } from "../../lib/site-config";
import SiteNav from "../../components/SiteNav.astro";
import "../../styles/global.css";

type AnyRecord = Record<string, any>;
type ResearchLineBundle = { id: string; slug: string; line: AnyRecord };

export async function getStaticPaths() {
  const snapshot = await loadCanonicalContent(new URL("../../../content/", import.meta.url));
  const projected = projectBaselineSnapshot(snapshot) as { research_lines?: AnyRecord[] };
  const projectedLineIds = new Set(
    (projected.research_lines ?? [])
      .map((line) => line.line_id)
      .filter((lineId): lineId is string => typeof lineId === "string"),
  );
  // The baseline projection supplies the catalogue boundary; the canonical
  // bundle is consulted only to resolve an identity to its filesystem slug.
  const readerLines = (snapshot.researchLines as ResearchLineBundle[])
    .filter((line) => projectedLineIds.has(line.id));
  return readerLines.map((line) => ({ params: { id: line.slug }, props: { lineId: line.id } }));
}

const { lineId } = Astro.props;
const site = loadSiteConfig();
const snapshot = await loadCanonicalContent(new URL("../../../content/", import.meta.url));
const baselineReader = projectBaselineSnapshot(snapshot) as { research_lines?: AnyRecord[]; works?: AnyRecord[] };
const researchLine = baselineReader.research_lines?.find((line) => line.line_id === lineId) ?? null;
if (!researchLine) {
  throw new Error(`Baseline Research Line not found: ${lineId}`);
}
const isCandidate = researchLine.reader_status === "candidate";

const memberships = (researchLine.memberships ?? []) as AnyRecord[];

function workAuthors(membership: AnyRecord) {
  return (membership.work?.authors ?? [])
    .map((author: AnyRecord) => author.display_name)
    .filter(Boolean)
    .join(", ");
}

function workTitle(membership: AnyRecord) {
  return membership.work?.title ?? membership.work_id;
}

function workYear(membership: AnyRecord) {
  const value = membership.work?.release_date?.value;
  return typeof value === "string" && /^\d{4}/u.test(value) ? value.slice(0, 4) : "";
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={researchLine.scientific_question} />
    <title>{researchLine.title} · {site.title}</title>
  </head>
  <body>
    <main class="site-shell reader-page">
      <SiteNav />
      <p class="eyebrow"><a href="/research-lines/">Research Lines</a> · Line Detail</p>
      <header class="reader-header">
        {isCandidate ? <p class="reader-note"><span class="tag">Candidate Line</span> This line is curated from baseline literature and pending review.</p> : null}
        <h1>{researchLine.title}</h1>
        <p class="section-kicker">Scientific Question</p>
        <p class="reader-deck">{researchLine.scientific_question}</p>
      </header>

      <section class="panel reader-view" aria-labelledby="line-reader-view-heading">
        <h2 id="line-reader-view-heading">Why This Line Matters</h2>
        <ReadingProse source={String(researchLine.reading ?? "")} localizationKey={lineId} />
      </section>

      <section class="panel" aria-labelledby="line-works-heading">
        <h2 id="line-works-heading">Papers in this Research Line</h2>
        {memberships.length === 0 ? (
          <p class="empty-state">No verified papers associated with this research line yet.</p>
        ) : (
          <ol class="paper-index">
            {memberships.map((membership: AnyRecord) => (
              <li class="paper-index-item">
                <article>
                  <h3>
                    <a class="paper-title" href={workReaderPath(snapshot, membership.work_id)}>
                      {workTitle(membership)}
                    </a>
                  </h3>
                  {workAuthors(membership) || workYear(membership) ? (
                    <p class="paper-meta">
                      {workAuthors(membership)}{workAuthors(membership) && workYear(membership) ? " · " : ""}{workYear(membership)}
                    </p>
                  ) : null}
                  <p class="record-label">
                    Role: {membership.reading_roles?.map(localizedRole).join(", ") ?? "None"}
                    {membership.editorial_anchor ? " · Editorial anchor for this line" : ""}
                  </p>
                  {membership.reason ? (
                    <p>{membership.reason}</p>
                  ) : null}
                  <p><a class="browse-link" href={workReaderPath(snapshot, membership.work_id)}>Read paper →</a></p>
                </article>
              </li>
            ))}
          </ol>
        )}
      </section>
    </main>
  </body>
</html>
