---
import SiteNav from "../../components/SiteNav.astro";
import ReaderText from "../../components/ReaderText.astro";
import eventsData from "../../data/scientific-events.json";
import { formatAnnouncementInBeijing, parseTransientEpoch } from "../../domain/academic-domain.mjs";
import { loadSiteConfig } from "../../lib/site-config";
import "../../styles/global.css";

const site = loadSiteConfig();
const allEvents = eventsData.events || [];
const topEvents = [...allEvents].sort((a, b) => (b.heat_score || 0) - (a.heat_score || 0)).slice(0, 5);

// Calculate type counts
const counts: Record<string, number> = {
  ALL: allEvents.length,
  GRB: 0,
  SN: 0,
  AT: 0,
  FRB: 0,
  GW: 0,
  SGR: 0,
};
for (const e of allEvents) {
  if (counts[e.event_type] !== undefined) counts[e.event_type]++;
  else counts[e.event_type] = 1;
}

interface EventWithBjt {
  event_id: string;
  event_type: string;
  tags: string[];
  heat_score: number;
  paper_count: number;
  headline: string;
  narrative: string;
  first_seen: string;
  last_updated: string;
  papers: any[];
  usDate: string;
  bjtDate: string;
  bjtShort: string;
  bjtWeekday: string;
}

// Map each event to Beijing Time announcement date
const eventsWithBjt: EventWithBjt[] = allEvents.map((e) => {
  const bjt = formatAnnouncementInBeijing(e.last_updated, "");
  return {
    ...e,
    usDate: e.last_updated,
    bjtDate: bjt.beijingDate,
    bjtShort: bjt.shortDate,
    bjtWeekday: bjt.chineseWeekday,
  };
});

// Group events by Beijing Date
const dateMap: Record<string, EventWithBjt[]> = {};
for (const e of eventsWithBjt) {
  if (!dateMap[e.bjtDate]) dateMap[e.bjtDate] = [];
  dateMap[e.bjtDate].push(e);
}
// Sorted dates descending (most recent first)
const sortedFollowUpDates = Object.keys(dateMap).sort((a, b) => b.localeCompare(a));

// Discover all active months dynamically from BJT dates (YYYY-MM)
const monthMap = new Map<string, Record<string, EventWithBjt[]>>();
for (const bjtDate of sortedFollowUpDates) {
  const ym = bjtDate.slice(0, 7);
  if (!monthMap.has(ym)) monthMap.set(ym, {});
  monthMap.get(ym)![bjtDate] = dateMap[bjtDate];
}
const sortedYearMonths = Array.from(monthMap.keys()).sort((a, b) => b.localeCompare(a));

interface CalendarCell {
  empty: boolean;
  day?: number;
  dateStr?: string;
  usDateStr?: string;
  weekday?: string;
  events?: EventWithBjt[];
  hasEvents?: boolean;
}

interface MonthCalendar {
  yearMonth: string;
  year: number;
  month: number;
  title: string;
  badge: string;
  totalEvents: number;
  activeBatchesCount: number;
  isLatest: boolean;
  activeDates: string[];
  defaultActiveDate: string;
  cells: CalendarCell[];
}

function buildMonthCalendar(year: number, month: number, eventsByBjtDate: Record<string, EventWithBjt[]>): CalendarCell[] {
  const firstDay = new Date(Date.UTC(year, month - 1, 1));
  let startDayOfWeek = firstDay.getUTCDay();
  if (startDayOfWeek === 0) startDayOfWeek = 7; // Mon=1, Sun=7
  const daysInMonth = new Date(Date.UTC(year, month, 0)).getUTCDate();
  const cells: CalendarCell[] = [];

  for (let p = 1; p < startDayOfWeek; p++) {
    cells.push({ empty: true });
  }

  const weekdays = ["周日", "周一", "周二", "周三", "周四", "周五", "周六"];
  for (let d = 1; d <= daysInMonth; d++) {
    const dStr = `${year}-${String(month).padStart(2, "0")}-${String(d).padStart(2, "0")}`;
    const evts = eventsByBjtDate[dStr] || [];
    const dt = new Date(Date.UTC(year, month - 1, d));
    const dayOfWeek = dt.getUTCDay();
    const usDateStr = evts[0]?.usDate || "";

    cells.push({
      empty: false,
      day: d,
      dateStr: dStr,
      usDateStr,
      weekday: weekdays[dayOfWeek],
      events: evts,
      hasEvents: evts.length > 0,
    });
  }
  return cells;
}

const allMonthCalendars: MonthCalendar[] = sortedYearMonths.map((ym, index) => {
  const [y, m] = ym.split("-").map(Number);
  const evtsOnMonth = monthMap.get(ym)!;
  const activeDates = Object.keys(evtsOnMonth).sort((a, b) => b.localeCompare(a));
  const activeBatchesCount = activeDates.length;
  const totalEvents = Object.values(evtsOnMonth).reduce((sum, list) => sum + list.length, 0);
  const isLatest = index === 0;
  const defaultActiveDate = activeDates[0] || "";

  return {
    yearMonth: ym,
    year: y,
    month: m,
    title: `${y} 年 ${m} 月`,
    badge: isLatest ? "当前监测月 · 活跃" : `往期 ${activeBatchesCount} 批次`,
    totalEvents,
    activeBatchesCount,
    isLatest,
    activeDates,
    defaultActiveDate,
    cells: buildMonthCalendar(y, m, evtsOnMonth),
  };
});

// Outburst epoch categorization
function getEventOutburstYear(eventId: string): number | null {
  const epoch = parseTransientEpoch(eventId);
  if (!epoch) return null;
  const m = epoch.match(/^(\d{4})/);
  return m ? parseInt(m[1], 10) : null;
}

const epochGroups = [
  { id: "epoch-2026", title: "2026 年最新爆发", badge: "当年爆发", desc: "最新发现的高能瞬变现象与快照预警", filter: (yr: number | null) => yr === 2026 },
  { id: "epoch-2025", title: "2025 年爆发密集反演", badge: "近 1 年", desc: "爆发后近1年内密集跟进，多波段联合反演与喷流减速物理", filter: (yr: number | null) => yr === 2025 },
  { id: "epoch-2024", title: "2024 年爆发", badge: "近 2 年", desc: "极早期闪光光谱、外流激波与前身星包层作用", filter: (yr: number | null) => yr === 2024 },
  { id: "epoch-2023", title: "2023 年爆发", badge: "近 3 年", desc: "非热辐射持续观测、晚期余辉与深层介质约束", filter: (yr: number | null) => yr === 2023 },
  { id: "epoch-2022", title: "2022 年世纪伽马暴", badge: "历史最亮", desc: "史上最亮暴 GRB 221009A 等极端物理对象的长期跨波段监测", filter: (yr: number | null) => yr === 2022 },
  { id: "epoch-multi", title: "2017–2021 年多信使与引力波突破", badge: "多信使里程碑", desc: "双中子星并合千新星晚期光谱、潮汐瓦解喷流晚期复苏", filter: (yr: number | null) => yr !== null && yr >= 2017 && yr <= 2021 },
  { id: "epoch-historic", title: "经典历史瞬变与深场监测 (< 2017)", badge: "长周期监测", desc: "SN 1987A 爆发近40年深场演化、历史伽马暴全样本统计", filter: (yr: number | null) => yr !== null && yr < 2017 },
  { id: "epoch-other", title: "坐标与周期性源", badge: "长期源", desc: "按天球坐标编号的软伽马中继器、磁星与重复快速射电暴", filter: (yr: number | null) => yr === null },
];

function typeBadgeColor(type: string): string {
  switch (type.toUpperCase()) {
    case "GW":
      return "badge-gw";
    case "GRB":
      return "badge-grb";
    case "SN":
      return "badge-sn";
    case "FRB":
      return "badge-frb";
    case "AT":
      return "badge-at";
    default:
      return "badge-other";
  }
}

function priorityPill(priority: string) {
  if (priority === "must_read") return { label: "⭐ 必读", cls: "pill-must-read" };
  if (priority === "worth_knowing") return { label: "📌 关注", cls: "pill-worth-knowing" };
  return { label: "⚡ 略读", cls: "pill-skim" };
}

const dynamicMonthCss = allMonthCalendars.map((m) => `
  body:has(#month-${m.yearMonth}:checked) .month-split-container[data-month="${m.yearMonth}"] {
    display: grid !important;
  }
  body:has(#month-${m.yearMonth}:checked) label[for="month-${m.yearMonth}"] {
    background: #2563eb !important;
    color: #ffffff !important;
    border-color: #2563eb !important;
    box-shadow: 0 1px 3px rgba(37, 99, 235, 0.25) !important;
  }
  body:has(#month-${m.yearMonth}:checked) label[for="month-${m.yearMonth}"] .pill-badge {
    background: rgba(255, 255, 255, 0.25) !important;
    color: #ffffff !important;
  }
`).join("\n");

const dynamicDateCss = allMonthCalendars.flatMap((m) =>
  m.activeDates.map((dStr) => `
    body:has(#date-${dStr}:checked) .daily-detail-panel[data-date="${dStr}"] {
      display: flex !important;
    }
    body:has(#date-${dStr}:checked) label[for="date-${dStr}"] {
      background: #2563eb !important;
      color: #ffffff !important;
      border-color: #1d4ed8 !important;
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.35) !important;
    }
    body:has(#date-${dStr}:checked) label[for="date-${dStr}"] .day-num-active,
    body:has(#date-${dStr}:checked) label[for="date-${dStr}"] .cal-active-badge {
      color: #ffffff !important;
    }
    body:has(#date-${dStr}:checked) label[for="date-${dStr}"] .cal-mini-dot {
      outline: 1.5px solid rgba(255, 255, 255, 0.95);
    }
  `)
).join("\n");

const dynamicCalendarCss = dynamicMonthCss + "\n" + dynamicDateCss;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="AstroLineage 瞬变源爆发日历与演化时间轴：提供科学月历网格与真实时间线轨道，按天体物理爆发时刻与 arXiv 跟踪批次双视点追踪 68 个高能事件。" />
    <title>瞬变源爆发日历与脉络时间轴 · {site.title}</title>
  </head>
  <body>
    <main class="site-shell reader-page events-calendar-page">
      <SiteNav />
      <p class="eyebrow"><a href="/">{site.title}</a> · Transient Calendar & Timeline</p>

      <!-- Header -->
      <header class="reader-header">
        <h1>
          <span class="language-primary">爆发事件</span>
          <span class="language-english" lang="en">Events & Timeline</span>
        </h1>
      </header>

      <!-- Master Interactive View Switcher (Zero Client Script) -->
      <section class="master-calendar-control">
        <input type="radio" name="events-view-mode" id="view-calendar-timeline" checked class="view-radio" />
        <input type="radio" name="events-view-mode" id="view-epoch-timeline" class="view-radio" />

        <!-- Category Radio Inputs -->
        <input type="radio" name="event-cat" id="cat-all" checked class="cat-radio" />
        <input type="radio" name="event-cat" id="cat-gw" class="cat-radio" />
        <input type="radio" name="event-cat" id="cat-grb" class="cat-radio" />
        <input type="radio" name="event-cat" id="cat-sn" class="cat-radio" />
        <input type="radio" name="event-cat" id="cat-at" class="cat-radio" />
        <input type="radio" name="event-cat" id="cat-frb" class="cat-radio" />
        <input type="radio" name="event-cat" id="cat-sgr" class="cat-radio" />

        <!-- Month Filter Radio Inputs: Single Month Mode (Latest checked by default) -->
        {allMonthCalendars.map((m) => (
          <input
            type="radio"
            name="cal-month-filter"
            id={`month-${m.yearMonth}`}
            checked={m.isLatest}
            class="month-radio"
          />
        ))}

        <!-- Active Date Selection Radio Inputs (Per-month groups, zero client script) -->
        {allMonthCalendars.map((m) =>
          m.activeDates.map((dStr) => (
            <input
              type="radio"
              name={`select-date-${m.yearMonth}`}
              id={`date-${dStr}`}
              checked={dStr === m.defaultActiveDate}
              class="date-select-radio"
            />
          ))
        )}

        <!-- Dynamic Single Month & Active Date Rules (Pure CSS Zero Script) -->
        <style is:inline set:html={dynamicCalendarCss} />

        <!-- Dual Dimension Controls Bar -->
        <div class="controls-card">
          <div class="control-row">
            <span class="control-label">视点模式：</span>
            <div class="view-pills-group">
              <label for="view-calendar-timeline" class="view-pill view-pill-calendar">
                📅 研读日历
              </label>
              <label for="view-epoch-timeline" class="view-pill view-pill-epoch">
                🪐 爆发年代
              </label>
            </div>
          </div>

          <div class="control-row">
            <span class="control-label">事件类型：</span>
            <div class="cat-pills-bar" aria-label="事件分类筛选">
              <label for="cat-all" class="cat-pill">全部 ({counts.ALL})</label>
              <label for="cat-grb" class="cat-pill">💥 伽马暴 GRB ({counts.GRB})</label>
              <label for="cat-sn" class="cat-pill">🌟 超新星 SN ({counts.SN})</label>
              <label for="cat-at" class="cat-pill">🕳️ 潮汐瓦解 AT ({counts.AT})</label>
              <label for="cat-frb" class="cat-pill">⚡ 快速射电暴 FRB ({counts.FRB})</label>
              <label for="cat-gw" class="cat-pill">🌌 引力波 GW ({counts.GW})</label>
              <label for="cat-sgr" class="cat-pill">🧲 磁星与致密星 ({counts.SGR})</label>
            </div>
          </div>
        </div>

        <!-- Dimension 1: Monthly Calendar Grid (Visible in calendar mode) -->
        <section class="calendar-matrix-section" aria-labelledby="calendar-grid-heading">
          <div class="calendar-matrix-header">
            <div class="matrix-title-row">
              <h2 id="calendar-grid-heading" class="calendar-matrix-title">
                📅 研读日历
              </h2>
              <span class="matrix-total-badge font-mono">收录 {sortedFollowUpDates.length} 个研读批次 · {allMonthCalendars.length} 个月份</span>
            </div>

            <!-- Month Quick Filter Ribbon (Dynamic Single Month Switcher) -->
            <div class="month-selector-bar">
              <span class="month-selector-label">🗓️ 月份切换：</span>
              <div class="month-selector-pills">
                {allMonthCalendars.map((m) => (
                  <label for={`month-${m.yearMonth}`} class="month-tab-pill">
                    <span>{m.title}</span>
                    <span class="pill-badge">{m.isLatest ? "最新 · " : ""}{m.activeBatchesCount} 批次</span>
                  </label>
                ))}
              </div>
            </div>
          </div>

          <!-- Single Month Split View: Calendar on Left, Selected Day Events on Right -->
          <div class="monthly-split-wrapper">
            {allMonthCalendars.map((m) => (
              <div class="month-split-container" data-month={m.yearMonth}>
                <!-- Left Pane: Calendar Matrix for this month -->
                <aside class="calendar-side-pane">
                  <div class="month-card-header">
                    <div class="month-title-group">
                      <span class="month-title">{m.title}</span>
                      <span class={`month-badge ${m.isLatest ? "month-badge-current" : "month-badge-prev"}`}>
                        {m.badge}
                      </span>
                    </div>
                    <div class="month-stats-text font-mono">
                      <span>{m.activeBatchesCount} 个活跃批次</span> · <span>{m.totalEvents} 个事件</span>
                    </div>
                  </div>
                  <div class="calendar-weekdays-row">
                    <span>一</span><span>二</span><span>三</span><span>四</span><span>五</span><span>六</span><span>日</span>
                  </div>
                  <div class="calendar-days-grid">
                    {m.cells.map((cell) => {
                      if (cell.empty) return <div class="cal-cell cal-cell-empty" />;
                      if (!cell.hasEvents) {
                        return (
                          <div class="cal-cell cal-cell-idle" title={`${cell.dateStr}（${cell.weekday}）无爆发事件研读`}>
                            <span class="day-num">{cell.day}</span>
                          </div>
                        );
                      }
                      return (
                        <label
                          for={`date-${cell.dateStr}`}
                          class="cal-cell cal-cell-active"
                          title={cell.events?.map((e: any) => `${e.event_id} (${e.event_type})`).join("\n")}
                        >
                          <span class="day-num-active">{cell.day}</span>
                          <span class="cal-active-badge">{cell.events?.length || 0}件</span>
                          <div class="cal-dots-row">
                            {(cell.events || []).slice(0, 3).map((e: any) => (
                              <span class={`cal-mini-dot ${typeBadgeColor(e.event_type)}`} />
                            ))}
                          </div>
                          <div class="cal-cell-popover" role="tooltip">
                            <div class="popover-title font-mono">{cell.dateStr}（{cell.events?.length} 个事件）</div>
                            <ul class="popover-event-list">
                              {cell.events?.map((e: any) => (
                                <li class="popover-event-item">
                                  <span class={`popover-type-badge ${typeBadgeColor(e.event_type)}`}>{e.event_type}</span>
                                  <span class="popover-event-name font-mono">{e.event_id}</span>
                                </li>
                              ))}
                            </ul>
                          </div>
                        </label>
                      );
                    })}
                  </div>
                </aside>

                <!-- Right Pane: Daily Detail Events Stream Pane -->
                <div class="detail-side-pane">
                  {m.activeDates.map((dStr) => {
                    const eventsOnDate = dateMap[dStr] || [];
                    const firstEvt = eventsOnDate[0];
                    const bjtWeekday = firstEvt?.bjtWeekday || "";
                    const usDate = firstEvt?.usDate || "";

                    return (
                      <section class="daily-detail-panel" data-date={dStr} aria-label={`${dStr} 爆发研读事件`}>
                        <div class="detail-header-card">
                          <div class="detail-header-main">
                            <div class="detail-date-title">
                              <span class="detail-date-badge font-mono">📅 {dStr}（{bjtWeekday}）</span>
                              <span class="detail-count-pill font-mono">当日研读 {eventsOnDate.length} 个高能事件</span>
                            </div>
                            <span class="detail-us-batch font-mono">对应 arXiv 美东批次：{usDate}</span>
                          </div>
                          <div class="detail-header-actions">
                            <a href={`/arxiv-daily/${usDate}/`} class="detail-daily-link">
                              查看当日论文雷达 →
                            </a>
                            <a href={`#station-${dStr}`} class="detail-spine-link" title="在下方完整时间轴轨道中定位">
                              完整轨道 ↓
                            </a>
                          </div>
                        </div>

                        <div class="detail-cards-stream">
                          {eventsOnDate.map((event) => {
                            const epoch = parseTransientEpoch(event.event_id);
                            return (
                              <article class="timeline-event-card" data-type={event.event_type} id={`detail-event-${event.event_id.toLowerCase().replace(/[\s+]+/g, "-")}`}>
                                <div class="card-top-bar">
                                  <div class="card-id-cluster">
                                    <span class={`event-type-badge ${typeBadgeColor(event.event_type)}`}>{event.event_type}</span>
                                    <h3 class="card-event-name">{event.event_id}</h3>
                                    {epoch && (
                                      <span class="card-epoch-pill" title="天体物理爆发/探测时刻">
                                        ⚡ 物理爆发：{epoch}
                                      </span>
                                    )}
                                  </div>
                                  <div class="card-metrics-cluster">
                                    <span class="metric-heat-chip" title="基于7天半衰期模型计算的热度指数">
                                      🔥 热度 <strong>{event.heat_score}</strong>
                                    </span>
                                    <span class="metric-papers-chip">
                                      📚 <strong>{event.paper_count}</strong> 篇研读
                                    </span>
                                  </div>
                                </div>

                                <div class="card-narrative-block">
                                  <h4 class="card-headline">{event.headline}</h4>
                                  <p class="card-narrative-text">
                                    <ReaderText text={event.narrative} />
                                  </p>
                                </div>

                                <div class="card-papers-stream">
                                  <div class="stream-label">📄 当期研读论文与物理结论：</div>
                                  <ul class="station-paper-list">
                                    {event.papers.map((paper) => {
                                      const priority = priorityPill(paper.priority);
                                      const dailyAnchor = `/arxiv-daily/${paper.date}/#card-${paper.arxiv_id}-v${paper.revision || 1}`;
                                      return (
                                        <li class="station-paper-item">
                                          <div class="paper-item-top">
                                            <span class={`priority-badge ${priority.cls}`}>{priority.label}</span>
                                            <a href={dailyAnchor} class="paper-title-anchor">
                                              <span class="paper-arxiv-id font-mono">[{paper.arxiv_id}]</span> {paper.title}
                                            </a>
                                          </div>
                                          {paper.bluf_result && (
                                            <p class="paper-bluf-row">
                                              <strong class="bluf-key">突破：</strong>
                                              <span class="bluf-val">{paper.bluf_result}</span>
                                            </p>
                                          )}
                                          <div class="paper-links-bar">
                                            <a href={dailyAnchor} class="link-radar-deep">进入每日雷达深度解析 →</a>
                                            <a href={`https://arxiv.org/abs/${paper.arxiv_id}`} target="_blank" rel="noopener noreferrer" class="link-arxiv-origin">arXiv 原文 ↗</a>
                                          </div>
                                        </li>
                                      );
                                    })}
                                  </ul>
                                </div>
                              </article>
                            );
                          })}
                        </div>
                      </section>
                    );
                  })}
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- Hot Events Top 5 (Foldable under calendar) -->
        <section class="calendar-hot-events-section" aria-label="瞬变源热度榜单">
          <details class="calendar-hot-events-fold">
            <summary class="calendar-hot-events-summary">
              <span class="summary-left">
                <span class="summary-icon">🔥</span>
                <span class="summary-title">瞬变源热度 Top 5 聚簇榜单</span>
              </span>
              <span class="summary-hint font-mono">点击展开 / 折叠</span>
            </summary>
            <div class="calendar-hot-events-body">
              <p class="hot-events-note">更新时间：{eventsData.generated_at}。热度按 7 天半衰期衰减，反映近期 arXiv 论文讨论活跃度。</p>
              <div class="agent-events-list">
                {topEvents.map((event, idx) => (
                  <div class="agent-event-row">
                    <div class="event-rank font-mono">#{idx + 1}</div>
                    <div class="event-info">
                      <div class="event-header">
                        <span class="event-id font-mono">{event.event_id}</span>
                        <span class={`event-type-badge ${typeBadgeColor(event.event_type)}`}>{event.event_type}</span>
                        <span class="event-heat">🔥 热度 {event.heat_score}</span>
                        <span class="event-papers-count font-mono">共 {event.paper_count} 篇论文关联</span>
                      </div>
                      <div class="event-meta">
                        <span>首次记录: {event.first_seen}</span> · <span>最近更新: {event.last_updated}</span>
                      </div>
                      <ul class="event-papers">
                        {event.papers.map((p) => {
                          const priority = priorityPill(p.priority);
                          const dailyAnchor = `/arxiv-daily/${p.date}/#card-${p.arxiv_id}-v${p.revision || 1}`;
                          return (
                            <li>
                              <span class={`priority-badge ${priority.cls}`}>{priority.label}</span>
                              <a href={dailyAnchor} class="paper-arxiv-id font-mono">arXiv:{p.arxiv_id}</a>
                              <span class="p-title">{p.title}</span>
                            </li>
                          );
                        })}
                      </ul>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </details>
        </section>

        <!-- VIEW 1: Follow-up Timeline Spine (Real Chronological Axis) -->
        <section class="timeline-followup-container" aria-label="批次跟踪时间轴">
          <div class="timeline-axis-header">
            <span class="axis-kicker">CHRONOLOGICAL SPINE</span>
            <h2>按 arXiv 批次日期排列的研读时间轴</h2>
            <p>发光轨道清晰展示从最新批次到历史批次的演进时间站（Timeline Stations），与上方月历网格精准联动。</p>
          </div>

          <div class="timeline-track">
            {sortedFollowUpDates.map((dateStr) => {
              const eventsOnDate = dateMap[dateStr] || [];
              const firstEvent = eventsOnDate[0];
              const bjtWeekday = firstEvent?.bjtWeekday || "";
              const usDate = firstEvent?.usDate || "";

              return (
                <section class="timeline-station" id={`station-${dateStr}`}>
                  <!-- Station Indicator & Anchor -->
                  <div class="station-marker-row">
                    <div class="station-pulse-node" />
                    <div class="station-badge">
                      <span class="station-bjt-date font-mono">📅 {dateStr}（{bjtWeekday}）</span>
                      <span class="station-us-date font-mono">arXiv 美东批次：{usDate}</span>
                      <span class="station-count-pill">共研读 {eventsOnDate.length} 个高能事件</span>
                    </div>
                  </div>

                  <!-- Station Event Cards -->
                  <div class="station-cards-stream">
                    {eventsOnDate.map((event) => {
                      const epoch = parseTransientEpoch(event.event_id);
                      return (
                        <article class="timeline-event-card" data-type={event.event_type} id={`event-${event.event_id.toLowerCase().replace(/[\s+]+/g, "-")}`}>
                          <div class="card-top-bar">
                            <div class="card-id-cluster">
                              <span class={`event-type-badge ${typeBadgeColor(event.event_type)}`}>{event.event_type}</span>
                              <h3 class="card-event-name">{event.event_id}</h3>
                              {epoch && (
                                <span class="card-epoch-pill" title="天体物理爆发/探测时刻">
                                  ⚡ 物理爆发：{epoch}
                                </span>
                              )}
                            </div>
                            <div class="card-metrics-cluster">
                              <span class="metric-heat-chip" title="基于7天半衰期模型计算的热度指数">
                                🔥 热度 <strong>{event.heat_score}</strong>
                              </span>
                              <span class="metric-papers-chip">
                                📚 <strong>{event.paper_count}</strong> 篇研读
                              </span>
                            </div>
                          </div>

                          <div class="card-narrative-block">
                            <h4 class="card-headline">{event.headline}</h4>
                            <p class="card-narrative-text">
                              <ReaderText text={event.narrative} />
                            </p>
                          </div>

                          <div class="card-papers-stream">
                            <div class="stream-label">📄 当期研读论文与物理结论：</div>
                            <ul class="station-paper-list">
                              {event.papers.map((paper) => {
                                const priority = priorityPill(paper.priority);
                                const dailyAnchor = `/arxiv-daily/${paper.date}/#card-${paper.arxiv_id}-v${paper.revision || 1}`;
                                return (
                                  <li class="station-paper-item">
                                    <div class="paper-item-top">
                                      <span class={`priority-badge ${priority.cls}`}>{priority.label}</span>
                                      <a href={dailyAnchor} class="paper-title-anchor">
                                        <span class="paper-arxiv-id font-mono">[{paper.arxiv_id}]</span> {paper.title}
                                      </a>
                                    </div>
                                    {paper.bluf_result && (
                                      <p class="paper-bluf-row">
                                        <strong class="bluf-key">突破：</strong>
                                        <span class="bluf-val">{paper.bluf_result}</span>
                                      </p>
                                    )}
                                    <div class="paper-links-bar">
                                      <a href={dailyAnchor} class="link-radar-deep">进入每日雷达深度解析 →</a>
                                      <a href={`https://arxiv.org/abs/${paper.arxiv_id}`} target="_blank" rel="noopener noreferrer" class="link-arxiv-origin">arXiv 原文 ↗</a>
                                    </div>
                                  </li>
                                );
                              })}
                            </ul>
                          </div>
                        </article>
                      );
                    })}
                  </div>
                </section>
              );
            })}
          </div>
        </section>

        <!-- VIEW 2: Cosmic Outburst Epoch Timeline (Universe Epoch: 2026 ➔ 1987) -->
        <section class="timeline-epoch-container" aria-label="宇宙物理爆发年代史">
          <div class="timeline-axis-header">
            <span class="axis-kicker">COSMIC OUTBURST EPOCH</span>
            <h2>沿宇宙时间回溯的高能瞬变物理年代史</h2>
            <p>按爆发/发现年代自 2026 回溯至 1987，呈现不同生命周期瞬变源（从早期激波到数十年晚期演化）的学术图景。</p>
          </div>

          <div class="timeline-track">
            {epochGroups.map((group) => {
              const matchedEvents = allEvents.filter((e) => group.filter(getEventOutburstYear(e.event_id)));
              if (matchedEvents.length === 0) return null;

              return (
                <section class="timeline-station epoch-station" id={group.id}>
                  <div class="station-marker-row">
                    <div class="station-pulse-node node-epoch" />
                    <div class="station-badge badge-epoch">
                      <span class="station-epoch-title">{group.title}</span>
                      <span class="epoch-badge-pill">{group.badge}</span>
                      <span class="station-count-pill">共 {matchedEvents.length} 个天体事件</span>
                    </div>
                  </div>
                  <p class="epoch-desc-lead">{group.desc}</p>

                  <div class="station-cards-stream">
                    {matchedEvents.map((event) => {
                      const epoch = parseTransientEpoch(event.event_id);
                      return (
                        <article class="timeline-event-card" data-type={event.event_type} id={`epoch-event-${event.event_id.toLowerCase().replace(/[\s+]+/g, "-")}`}>
                          <div class="card-top-bar">
                            <div class="card-id-cluster">
                              <span class={`event-type-badge ${typeBadgeColor(event.event_type)}`}>{event.event_type}</span>
                              <h3 class="card-event-name">{event.event_id}</h3>
                              {epoch && (
                                <span class="card-epoch-pill" title="天体物理爆发/探测时刻">
