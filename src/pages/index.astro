---
import ProductBoundary from "../copy/product-boundary.md";
import { loadCanonicalContent } from "../../scripts/content-loader.mjs";
import { projectBaselineSnapshot, projectVisibleSnapshot } from "../../scripts/reader-projection.mjs";
import { learningPathReaderPath, researchLineReaderPath } from "../lib/reader-routes";
import {
  localizedLineTitle,
  localizedPathTitle,
} from "../lib/reader-localization";
import { loadSiteConfig } from "../lib/site-config";
import SiteNav from "../components/SiteNav.astro";
import ReaderText from "../components/ReaderText.astro";
import weeklyData from "../data/arxiv-weekly.json";
import dailyRadar from "../data/daily-radar.json";
import dailyFeed from "../data/arxiv-daily.json";
import archiveManifest from "../data/arxiv-archives/manifest.json";
import ScientificEventTimeline from "../components/ScientificEventTimeline.astro";
import { radarCardAnchor } from "../../scripts/daily-radar.mjs";
import { parseStructuredExecutiveSummary, formatAnnouncementInBeijing, formatWeekIdZh } from "../domain/academic-domain.mjs";
import { resolvePaperTitleZhSync } from "../domain/paper-translation.mjs";
import "../styles/global.css";

const dailyArchiveModules = import.meta.glob<{ default: any }>("../data/arxiv-archives/daily/*.json", { eager: true });
const paperDailyDateMap = new Map<string, string>();
for (const mod of Object.values(dailyArchiveModules)) {
  const data = (mod as any).default || mod;
  const date = data.date;
  for (const entry of data.feed?.entries ?? []) {
    if (entry.arxiv_id && date) paperDailyDateMap.set(entry.arxiv_id, date);
  }
  for (const a of data.radar?.analyses ?? []) {
    if (a.arxiv_id && date && !paperDailyDateMap.has(a.arxiv_id)) {
      paperDailyDateMap.set(a.arxiv_id, date);
    }
  }
}

const paperAuthorsMap = new Map<string, string>();
for (const p of (weeklyData as any).papers ?? []) {
  if (p.arxiv_id && Array.isArray(p.authors) && p.authors.length > 0) {
    const formatted = p.authors.length > 2 ? `${p.authors[0]} et al.` : p.authors.join(", ");
    paperAuthorsMap.set(p.arxiv_id, formatted);
  }
}
for (const mod of Object.values(dailyArchiveModules)) {
  const data = (mod as any).default || mod;
  for (const entry of data.feed?.entries ?? []) {
    if (entry.arxiv_id && Array.isArray(entry.authors) && entry.authors.length > 0 && !paperAuthorsMap.has(entry.arxiv_id)) {
      const formatted = entry.authors.length > 2 ? `${entry.authors[0]} et al.` : entry.authors.join(", ");
      paperAuthorsMap.set(entry.arxiv_id, formatted);
    }
  }
}

type AnyRecord = Record<string, any>;

const site = loadSiteConfig();
const snapshot = await loadCanonicalContent("content");
const visibleReader = projectVisibleSnapshot(snapshot) as Record<string, any>;
const baselineReader = projectBaselineSnapshot(snapshot) as Record<string, any>;
const learningPaths = (visibleReader.learning_paths ?? []) as AnyRecord[];
const scientificEdges = (visibleReader.scientific_edges ?? []) as AnyRecord[];
const baselineWorks = (baselineReader.works ?? []) as AnyRecord[];
const baselineLines = (baselineReader.research_lines ?? []) as AnyRecord[];
const baselinePaths = (baselineReader.learning_paths ?? []) as AnyRecord[];
const startPath = learningPaths[0] ?? null;

// Intelligence Dashboard Data Preparation
const weeklyStats = (weeklyData as any).statistics ?? {
  total_analyzed: (weeklyData as any).papers?.length ?? 0,
  must_read_count: (weeklyData as any).top_picks?.filter((p: any) => p.priority === "must_read").length ?? 0,
  worth_knowing_count: (weeklyData as any).top_picks?.filter((p: any) => p.priority === "worth_knowing").length ?? 0,
  skip_count: 0,
};
const weeklyStructured = parseStructuredExecutiveSummary((weeklyData as any).executive_summary || "");
const weeklyLeadSummary = weeklyStructured.lead
  ? weeklyStructured.lead.replace(/[：:]$/, "。")
  : "Synthesizing causal dynamics and observational frontiers in high-energy astrophysics.";
const weeklyTopPicks = (weeklyData as any).top_picks ?? [];
const thematicHighlights = (weeklyData as any).thematic_highlights ?? [];

const dailyEntries = (dailyFeed as any).entries ?? [];
const feedMap = new Map(dailyEntries.map((entry: any) => [entry.arxiv_id, entry]));
const radarAnalyses = (dailyRadar as any).analyses ?? [];
const dailyMustReads = radarAnalyses
  .filter((a: any) => a.priority === "must_read")
  .map((a: any) => ({
    ...a,
    entry: feedMap.get(a.arxiv_id) ?? null,
  }));
const dailyWorthKnowing = radarAnalyses.filter((a: any) => a.priority === "worth_knowing");
const dailySkip = radarAnalyses.filter((a: any) => a.priority === "skip");

const dailyStats = {
  total_papers: dailyEntries.length || radarAnalyses.length,
  must_read_count: dailyMustReads.length,
  worth_knowing_count: dailyWorthKnowing.length,
  skip_count: dailySkip.length,
};

const filterNoiseReductionRate = dailyStats.total_papers > 0
  ? Math.round((dailyStats.skip_count / dailyStats.total_papers) * 100)
  : 0;

const latestDate = (dailyFeed as any).window?.announcement_date ?? "2026-09-21";
const radarWeekday = (dailyFeed as any).window?.announcement_weekday ?? "Mon";
const bjtDailyInfo = formatAnnouncementInBeijing(latestDate, radarWeekday);

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="A curated scientific reading map for high-energy transient astrophysics."
    />
    <title>{site.title}</title>
  </head>
  <body>
    <main class="site-shell home-page">
      <SiteNav />

      <header class="home-header" aria-labelledby="home-title">
        <div class="home-title-line">
          <h1 id="home-title">{site.title}</h1>
        </div>
        <p class="home-lead">Understand how ideas in high-energy astrophysics evolve.</p>
      </header>

      <!-- Primary Feature Section: Daily & Weekly arXiv Papers -->
      <section class="intelligence-hero-section" aria-label="arXiv Tracking & Academic Lineage">

        <div class="intelligence-grid asymmetric-hero-grid">
          <!-- Daily Radar Card (Lightweight Portal — first) -->
          <article class="intel-card intel-card-daily intel-daily-portal">
            <div class="intel-card-top">
              <div class="intel-meta-group">
                <span class="intel-meta-kicker">Daily Radar · {bjtDailyInfo.beijingDate}</span>
                <span class="intel-meta-batch">{(bjtDailyInfo as any).englishWeekday ?? bjtDailyInfo.chineseWeekday} Batch</span>
              </div>
              <a class="intel-view-all-link" href="/arxiv-daily/">Open Daily Radar →</a>
            </div>

            <h3 class="intel-card-title">
              <a href="/arxiv-daily/">
                <span class="intel-title-prefix">{bjtDailyInfo.beijingDate}</span> Daily Paper Radar
              </a>
            </h3>

            <!-- Quick batch switch -->
            <div class="intel-daily-date-pills">
              <span class="pills-label">Batches:</span>
              <div class="pills-scroll">
                {(archiveManifest.weeks || []).flatMap((w: any) => w.days || []).slice(0, 5).map((d: any) => {
                  const dInfo = formatAnnouncementInBeijing(d.date, d.weekday);
                  return (
                    <a
                      class={`daily-date-chip ${d.date === latestDate ? "active" : ""}`}
                      href={d.date === latestDate ? `/arxiv-daily/` : `/arxiv-daily/${d.date}/`}
                      title={`View Daily Radar for ${dInfo.beijingDate}`}
                    >
                      {dInfo.shortDate} {(dInfo as any).englishWeekday ?? dInfo.chineseWeekday}
                    </a>
                  );
                })}
              </div>
            </div>

            <!-- Executive brief -->
            <div class="intel-daily-summary-lead">
              <p class="intel-daily-one-liner">
                Monitored <strong>{dailyStats.total_papers}</strong> high-energy transient papers, curating <strong>{dailyStats.must_read_count}</strong> must-read works with physical mechanisms and evidence citations.
              </p>
            </div>

            <!-- Direct must-read links -->
            <div class="intel-daily-quick-box">
              <p class="intel-quick-label">Today's Key Highlights:</p>
              {dailyMustReads.length > 0 ? (
                <ul class="intel-daily-quick-list">
                  {dailyMustReads.map((paper: any) => {
                    const paperDate = paperDailyDateMap.get(paper.arxiv_id) || latestDate;
                    const paperTargetUrl = `/arxiv-daily/${paperDate}/#${radarCardAnchor(paper.arxiv_id, paper.revision || 1)}`;
                    const authorStr = paperAuthorsMap.get(paper.arxiv_id) || (Array.isArray(paper.entry?.authors) && paper.entry.authors.length > 0 ? (paper.entry.authors.length > 2 ? `${paper.entry.authors[0]} et al.` : paper.entry.authors.join(", ")) : "");
                    const analysis = paper.analysis?.analysis || paper.analysis || {};
                    const result = analysis.result;
                    return (
                      <li class="intel-daily-quick-item">
                        <div class="quick-item-top">
                          <span class="quick-tier-pill">⭐ Must Read</span>
                          <span class="quick-arxiv-id">arXiv:{paper.arxiv_id}</span>
                          {authorStr && <span class="quick-authors">Authors: {authorStr}</span>}
                        </div>
                        <h4 class="quick-paper-title">
                          <a href={paperTargetUrl} class="intel-paper-title-link" title="Click to view full reading guide">
                            <ReaderText text={paper.entry?.title || paper.arxiv_id} />
                          </a>
                        </h4>
                        {result && result !== "unknown" && !result.startsWith("\u672a\u80fd\u4ece\u5df2\u68c0\u67e5\u6750\u6599") && !result.startsWith("Could not be derived") && (
                          <p class="quick-paper-result">
                            <strong class="quick-res-lead">Result: </strong>
                            <span class="quick-res-text"><ReaderText text={result} /></span>
                          </p>
                        )}
                      </li>
                    );
                  })}
                </ul>
              ) : (
                <div class="intel-radar-empty">
                  <p>No Must-Read papers in today's batch. See full radar for followed papers.</p>
                </div>
              )}
            </div>

            <div class="intel-card-footer intel-daily-footer">
              <a class="btn-primary" href="/arxiv-daily/">
                <span>View Full Daily Radar ({dailyStats.total_papers} papers)</span>
                <span aria-hidden="true">→</span>
              </a>
              <div class="intel-daily-portal-meta">
                <span class="telemetry-pill">Noise Filtered {filterNoiseReductionRate}%</span>
                <a class="archive-sub-link" href="/arxiv-archives/">Archives →</a>
              </div>
            </div>
          </article>

          <!-- Weekly Synthesis Card (Full-width below daily) -->
          <article class="intel-card intel-card-weekly flagship-stage">
            <div class="intel-card-top">
              <div class="intel-meta-group">
                <span class="intel-meta-kicker">Weekly Synthesis · {(weeklyData as any).week_id}</span>
                <span class="intel-meta-date">{(weeklyData as any).date_range}</span>
              </div>
              <div class="intel-card-top-actions">
                <a class="intel-view-all-link" href="/arxiv-weekly/">View Weekly Synthesis →</a>
              </div>
            </div>

            <h3 class="intel-card-title">
              <a href="/arxiv-weekly/">
                <span class="intel-title-prefix">{(weeklyData as any).week_id}</span> Weekly Academic Lineage
              </a>
            </h3>

            <div class="intel-summary-box">
              <p class="intel-summary-lead">
                <ReaderText text={weeklyLeadSummary} />
              </p>
              {weeklyStructured.items.length > 0 && (
                <ul class="intel-summary-hl-list">
                  {weeklyStructured.items.slice(0, 3).map((item: any) => (
                    <li class="intel-summary-hl-item">
                      <strong class="hl-topic-lead">{item.topic}:</strong>
                      <span class="hl-body-text"><ReaderText text={item.body} /></span>
                    </li>
                  ))}
                </ul>
              )}
            </div>

            <div class="intel-metrics-strip">
              <div class="intel-metric-item">
                <span class="intel-metric-val">{weeklyStats.total_analyzed}</span>
                <span class="intel-metric-lbl">Papers</span>
              </div>
              <div class="intel-metric-item highlight-must-read">
                <span class="intel-metric-val">{weeklyStats.must_read_count}</span>
                <span class="intel-metric-lbl">Must Read</span>
              </div>
              <div class="intel-metric-item highlight-worth-knowing">
                <span class="intel-metric-val">{weeklyStats.worth_knowing_count}</span>
                <span class="intel-metric-lbl">Follow</span>
              </div>
              <div class="intel-metric-item highlight-topics">
                <span class="intel-metric-val">{thematicHighlights.length}</span>
                <span class="intel-metric-lbl">Themes</span>
              </div>
            </div>

            {weeklyTopPicks.length > 0 && (
              <div class="intel-picks-box">
                <p class="intel-picks-label">Weekly Top Picks ({Math.min(weeklyTopPicks.length, 4)}/{weeklyTopPicks.length}):</p>
                <ul class="intel-picks-list">
                  {weeklyTopPicks.slice(0, 4).map((pick: any) => {
                    const dailyDate = paperDailyDateMap.get(pick.arxiv_id) || latestDate;
                    const pickTargetUrl = `/arxiv-daily/${dailyDate}/#${radarCardAnchor(pick.arxiv_id, pick.revision || 1)}`;
                    const authorStr = paperAuthorsMap.get(pick.arxiv_id);
                    return (
                      <li class="intel-pick-item">
                        <div class="intel-pick-header">
                          <span class={`intel-pick-badge ${pick.priority === "must_read" ? "badge-must-read" : "badge-worth-knowing"}`}>
                            {pick.priority === "must_read" ? "⭐ Must Read" : "📌 Follow"}
                          </span>
                          <div class="intel-pick-links">
                            <a class="intel-pick-daily-link" href={pickTargetUrl} title="View daily brief and scientific evidence">
                              📖 Deep Read ({dailyDate}) →
                            </a>
                            <a class="intel-pick-id" href={`https://arxiv.org/abs/${pick.arxiv_id}`} target="_blank" rel="noopener noreferrer">
                              arXiv:{pick.arxiv_id} ↗
                            </a>
                            <a class="intel-pick-pdf" href={`https://arxiv.org/pdf/${pick.arxiv_id}`} target="_blank" rel="noopener noreferrer" title="Read official PDF directly">
                              📄 PDF
                            </a>
                          </div>
                        </div>
                        <h4 class="intel-pick-title">
                          <a href={pickTargetUrl} class="intel-paper-title-link" title="Open deep reading brief">
                            <ReaderText text={pick.title} />
                          </a>
                        </h4>
                        {authorStr && (
                          <p class="intel-pick-authors">Authors: {authorStr}</p>
                        )}
                        <div class="intel-pick-bluf">
                          <p class="intel-bluf-row">
                            <strong class="bluf-lead result-lead">Result: </strong>
                            <span class="bluf-text"><ReaderText text={pick.core_insight} /></span>
                          </p>
                          {pick.recommendation_reason ? (
                            <p class="intel-bluf-row">
                              <strong class="bluf-lead reason-lead">Reason: </strong>
                              <span class="bluf-text"><ReaderText text={pick.recommendation_reason} /></span>
                            </p>
                          ) : null}
                        </div>
                      </li>
                    );
                  })}
                </ul>
              </div>
            )}

            <div class="intel-card-footer">
              <a class="btn-primary" href="/arxiv-weekly/">
                <span>View Full Weekly Synthesis ({weeklyTopPicks.length} selected works)</span>
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        </div>

        <!-- Full-width Archives Portal Banner -->
        <div class="intel-archives-portal-banner">
          <div class="portal-banner-left">
            <span class="portal-kicker">📚 Archives</span>
            <h4 class="portal-title">Daily &amp; Weekly Archives</h4>
            <p class="portal-desc">
              Indexed {(archiveManifest as any).total_weeks} weekly digests and {(archiveManifest as any).total_daily_editions} daily editions, each with dedicated permalinks.
            </p>
          </div>
          <div class="portal-banner-right">
            <a class="portal-btn" href="/arxiv-archives/">
              <span>Browse Archives ({(archiveManifest as any).total_weeks} weeks · {(archiveManifest as any).total_daily_editions} editions)</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </section>

      <!-- Transient Event Clustering Timeline Radar -->
      <ScientificEventTimeline maxEvents={4} />

      <!-- Baseline Literature & Scientific Lines Overview Card (Single Bottom Card) -->
      <section class="panel baseline-overview" aria-labelledby="baseline-heading">
        <p class="section-kicker">Start Here · Foundational Papers &amp; Academic Lineage</p>
        <h2 id="baseline-heading">Foundational Papers, Scientific Connections &amp; Learning Paths</h2>
        <p class="baseline-overview-lead"><a href="/papers/">{baselineWorks.length} Foundational Papers</a>, <a href="/research-lines/">{baselineLines.length} Research Lines</a>, <a href="/learning-paths/">{baselinePaths.length} Learning Paths</a>, and {scientificEdges.length} Scientific Connections.</p>
        <p class="baseline-representative-links">
          <span>Key Papers: <a href="/papers/arnett-1982/">Arnett (1982)</a>, <a href="/papers/blandford-mckee-1976/">Blandford &amp; McKee (1976)</a></span>
        </p>

        {!startPath && <p class="empty-state">No verified learning paths available.</p>}

        <div class="baseline-columns">
          <section aria-labelledby="baseline-lines-heading">
            <h3 id="baseline-lines-heading">🔭 Research Lines <a class="baseline-col-more" href="/research-lines/">All →</a></h3>
            <ul class="compact-list baseline-links">
              {baselineLines.map((line) => (
                <li>
                  <a href={researchLineReaderPath(snapshot, line.line_id)}>{localizedLineTitle(line.line_id, line.title ?? line.line_id)}</a>
                  {line.reader_status === "candidate" && <span class="tag candidate-tag">Candidate</span>}
                </li>
              ))}
            </ul>
          </section>
          <section aria-labelledby="baseline-paths-heading">
            <h3 id="baseline-paths-heading">🗺️ Learning Paths <a class="baseline-col-more" href="/learning-paths/">All →</a></h3>
            <ul class="compact-list baseline-links">
              {baselinePaths.map((path) => (
                <li>
                  <a href={learningPathReaderPath(snapshot, path.path_id)}>{localizedPathTitle(path.path_id, path.title ?? path.path_id)}</a>
                  {path.reader_status === "candidate" && <span class="tag candidate-tag">Candidate</span>}
                </li>
              ))}
            </ul>
          </section>
        </div>
      </section>

      <!-- Global Site Footer & Feedback Bar -->
      <footer class="site-global-footer">
        <div class="footer-inner">
          <div class="footer-left">
            <span class="footer-brand">AstroLineage</span>
            <span class="footer-desc">Automated literature intelligence and lineage tracking for high-energy astrophysics.</span>
            <ProductBoundary />
          </div>
          <div class="footer-links">
            <a href="https://github.com/dnwb/astro-lineage/issues" target="_blank" rel="noopener noreferrer" class="footer-feedback-link">
              <span>💬 Feedback &amp; Bug Reports (GitHub Issues)</span>
              <span aria-hidden="true">↗</span>
            </a>
            <span class="footer-sep">·</span>
            <a href="https://pd.qq.com/s/d4lw4zl0g" target="_blank" rel="noopener noreferrer">Tencent Channel</a>
            <span class="footer-sep">·</span>
            <a href="/agent/">Agent Integration</a>
            <span class="footer-sep">·</span>
            <a href="/events/">Transient Events</a>
          </div>
        </div>
      </footer>
    </main>

    <style is:global>
      .home-header {
        margin-top: 1rem;
        margin-bottom: 1.25rem;
      }
      .intel-pick-header,
      .intel-radar-item-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 0.45rem;
        margin-bottom: 0.35rem;
      }
      .intel-meta-group {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        flex-wrap: wrap;
      }
      .intel-meta-kicker {
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.02em;
        color: #2563eb;
      }
      :global(:is([data-theme="dark"], body:has(#site-theme-toggle:checked))) .intel-meta-kicker {
        color: #60a5fa;
      }
      .intel-meta-date,
      .intel-meta-batch {
        font-size: 0.78rem;
        color: #64748b;
        font-family: ui-monospace, monospace;
      }
      :global(:is([data-theme="dark"], body:has(#site-theme-toggle:checked))) .intel-meta-date,
      :global(:is([data-theme="dark"], body:has(#site-theme-toggle:checked))) .intel-meta-batch {
        color: #94a3b8;
      }
      .hl-topic-lead {
        font-size: 0.88rem;
        font-weight: 700;
        color: #1e3a8a;
        word-break: break-word;
      }
      :global(:is([data-theme="dark"], body:has(#site-theme-toggle:checked))) .hl-topic-lead {
        color: #93c5fd;
      }
      .intel-pick-links {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        font-size: 0.82rem;
        flex-wrap: wrap;
      }
      .intel-pick-daily-link {
        color: #166534;
        font-weight: 600;
        text-decoration: none;
      }
      .intel-pick-daily-link:hover {
        text-decoration: underline;
      }
      :global(:is([data-theme="dark"], body:has(#site-theme-toggle:checked))) .intel-pick-daily-link {
        color: #86efac;
      }
      .intel-pick-id {
        color: #2563eb;
        text-decoration: none;
        font-family: ui-monospace, monospace;
        font-size: 0.8rem;
      }
      .intel-pick-id:hover {
        text-decoration: underline;
      }
      :global(:is([data-theme="dark"], body:has(#site-theme-toggle:checked))) .intel-pick-id {
        color: #60a5fa;
      }
      .intel-pick-pdf {
        color: #dc2626;
        text-decoration: none;
        font-size: 0.8rem;
        font-weight: 600;
      }
      .intel-pick-pdf:hover {
        text-decoration: underline;
      }
      :global(:is([data-theme="dark"], body:has(#site-theme-toggle:checked))) .intel-pick-pdf {
        color: #fca5a5;
      }
      .home-paper-title-bilingual {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
        min-width: 0;
        max-width: 100%;
        word-break: break-word;
        overflow-wrap: break-word;
      }
      .home-paper-title-en {
        display: block;
        line-height: 1.4;
        word-break: break-word;
        overflow-wrap: break-word;
      }
      .home-paper-title-zh {
        display: block;
        font-size: 0.9rem;
        font-weight: 500;
        color: var(--text-secondary, #475569);
        line-height: 1.4;
        word-break: break-word;
        overflow-wrap: break-word;
      }
      :global(:is([data-theme="dark"], body:has(#site-theme-toggle:checked))) .home-paper-title-zh {
        color: #94a3b8;
      }
      .intel-bluf-stream,
      .intel-pick-bluf {
        margin-top: 0.45rem;
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
      }
      .intel-bluf-row {
        display: flex;
        align-items: baseline;
        gap: 0.35rem;
        margin: 0;
        font-size: 0.88rem;
        line-height: 1.55;
        min-width: 0;
        max-width: 100%;
      }
      .bluf-text {
        min-width: 0;
        max-width: 100%;
        flex: 1;
        word-break: break-word;
        overflow-wrap: break-word;
      }
      .quick-paper-result {
        display: flex;
        align-items: baseline;
        gap: 0.35rem;
        margin: 0.35rem 0 0;
        min-width: 0;
        max-width: 100%;
      }
      .quick-res-text {
        min-width: 0;
        max-width: 100%;
        flex: 1;
        word-break: break-word;
        overflow-wrap: break-word;
      }
      .bluf-lead {
        font-weight: 700;
        font-size: 0.85rem;
        white-space: nowrap;
        flex-shrink: 0;
      }
      .result-lead,
      .quick-res-lead {
        color: #1d4ed8;
      }
      :global(:is([data-theme="dark"], body:has(#site-theme-toggle:checked))) .result-lead,
      :global(:is([data-theme="dark"], body:has(#site-theme-toggle:checked))) .quick-res-lead {
