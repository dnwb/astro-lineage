---
import archiveManifest from "../../data/arxiv-archives/manifest.json";

interface Props {
  currentWeek: string;
}

const { currentWeek } = Astro.props;

const allWeeks = (archiveManifest as any).weeks || [];
const latestWeekId = (archiveManifest as any).latest_week_id || (allWeeks[0]?.week_id ?? "");

// allWeeks is ordered from newest to oldest
const currentIndex = allWeeks.findIndex((w: any) => w.week_id === currentWeek);
const newerWeek = currentIndex > 0 ? allWeeks[currentIndex - 1] : null;
const olderWeek = currentIndex >= 0 && currentIndex < allWeeks.length - 1 ? allWeeks[currentIndex + 1] : null;
---

<nav class="weekly-nav-bar" aria-label="周报周次导航">
  <div class="weekly-nav-inner">
    <div class="nav-prev">
      {olderWeek ? (
        <a
          class="nav-step-btn"
          href={`/arxiv-weekly/${olderWeek.week_id}/`}
          title={`切换至上一周 (${olderWeek.week_id})`}
        >
          ← 上一周 ({olderWeek.week_id})
        </a>
      ) : (
        <span class="nav-step-btn disabled" aria-disabled="true">← 上一周 (已是最早)</span>
      )}
    </div>

    <div class="nav-center">
      <details class="weekly-archive-details">
        <summary class="weekly-archive-summary" title="展开全部历史周报">
          <span class="summary-current">当前周：<strong>{currentWeek}</strong></span>
          <span class="summary-badge">全部往期 ({allWeeks.length})</span>
          <span class="summary-caret">▾</span>
        </summary>
        <div class="weekly-archive-dropdown-menu">
          <div class="dropdown-header">
            <span>历史自然周学术脉络归档</span>
            <a class="dropdown-all-link" href="/arxiv-archives/">查看全局存档库 →</a>
          </div>
          <div class="dropdown-grid">
            {allWeeks.map((w: any) => {
              const isCurrent = w.week_id === currentWeek;
              const isLatest = w.week_id === latestWeekId;
              const targetUrl = isLatest ? "/arxiv-weekly/" : `/arxiv-weekly/${w.week_id}/`;
              const mustCount = w.statistics?.must_read_count ?? 0;
              const totalCount = w.statistics?.total_analyzed ?? 0;
              return (
                <a
                  class={`dropdown-day-item ${isCurrent ? "active" : ""}`}
                  href={targetUrl}
                  aria-current={isCurrent ? "page" : undefined}
                >
                  <div class="day-item-left">
                    <span class="day-item-date">{w.week_id}</span>
                    <span class="day-item-weekday">{w.date_range}</span>
                  </div>
                  <div class="day-item-right">
                    {mustCount > 0 && <span class="badge-must">{mustCount}必读</span>}
                    <span class="badge-total">{totalCount}篇</span>
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      </details>
    </div>

    <div class="nav-next">
      {newerWeek ? (
        <a
          class="nav-step-btn"
          href={newerWeek.week_id === latestWeekId ? "/arxiv-weekly/" : `/arxiv-weekly/${newerWeek.week_id}/`}
          title={`切换至下一周 (${newerWeek.week_id})`}
        >
          下一周 ({newerWeek.week_id}) →
        </a>
      ) : (
        <span class="nav-step-btn disabled" aria-disabled="true">下一周 (已是最新) →</span>
      )}
    </div>
  </div>
</nav>

<style>
  .weekly-nav-bar {
    margin: 1rem 0 1.5rem 0;
    padding: 0.5rem 0.75rem;
    background: var(--bg-card, #f8fafc);
    border: 1px solid var(--border-color, #e2e8f0);
    border-radius: 8px;
  }
  :global(:is([data-theme="dark"], body:has(#site-theme-toggle:checked))) .weekly-nav-bar {
    background: #0f172a;
    border-color: #334155;
  }
  .weekly-nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .nav-step-btn {
    display: inline-flex;
    align-items: center;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-primary, #0f172a);
    text-decoration: none;
    padding: 0.3rem 0.6rem;
    border-radius: 6px;
    background: var(--bg-surface, #ffffff);
    border: 1px solid var(--border-color, #cbd5e1);
    transition: all 0.15s ease;
  }
  :global(:is([data-theme="dark"], body:has(#site-theme-toggle:checked))) .nav-step-btn {
    background: #1e293b;
    border-color: #475569;
    color: #f1f5f9;
  }
  .nav-step-btn:hover:not(.disabled) {
    color: #2563eb;
    border-color: #93c5fd;
    background: #eff6ff;
  }
  :global(:is([data-theme="dark"], body:has(#site-theme-toggle:checked))) .nav-step-btn:hover:not(.disabled) {
    color: #60a5fa;
    border-color: #3b82f6;
    background: #1e3a8a;
  }
  .nav-step-btn.disabled {
    opacity: 0.45;
    cursor: not-allowed;
    pointer-events: none;
  }
  .weekly-archive-details {
    position: relative;
  }
  .weekly-archive-summary {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.65rem;
    background: var(--bg-surface, #ffffff);
    border: 1px solid var(--border-color, #cbd5e1);
    border-radius: 6px;
    font-size: 0.85rem;
    cursor: pointer;
    user-select: none;
    color: var(--text-primary, #0f172a);
    list-style: none;
  }
  :global(:is([data-theme="dark"], body:has(#site-theme-toggle:checked))) .weekly-archive-summary {
    background: #1e293b;
    border-color: #475569;
    color: #f1f5f9;
  }
  .weekly-archive-summary::-webkit-details-marker {
    display: none;
  }
  .summary-badge {
    font-size: 0.72rem;
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    background: #e2e8f0;
    color: #475569;
  }
  :global(:is([data-theme="dark"], body:has(#site-theme-toggle:checked))) .summary-badge {
    background: #334155;
    color: #94a3b8;
  }
  .summary-caret {
    font-size: 0.7rem;
    color: #64748b;
  }
  .weekly-archive-dropdown-menu {
    position: absolute;
    top: calc(100% + 0.4rem);
    left: 50%;
    transform: translateX(-50%);
    width: 380px;
    max-width: 90vw;
    max-height: 400px;
    overflow-y: auto;
    background: var(--bg-surface, #ffffff);
    border: 1px solid var(--border-color, #cbd5e1);
    border-radius: 8px;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.15);
    z-index: 100;
    padding: 0.75rem;
  }
  :global(:is([data-theme="dark"], body:has(#site-theme-toggle:checked))) .weekly-archive-dropdown-menu {
    background: #0f172a;
    border-color: #334155;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5);
  }
  .dropdown-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-secondary, #64748b);
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border-color, #e2e8f0);
    margin-bottom: 0.5rem;
  }
  .dropdown-all-link {
    color: #2563eb;
    text-decoration: none;
  }
  .dropdown-all-link:hover {
    text-decoration: underline;
  }
  .dropdown-grid {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .dropdown-day-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.4rem 0.5rem;
    border-radius: 6px;
    text-decoration: none;
    color: var(--text-primary, #0f172a);
    font-size: 0.8rem;
    transition: background 0.15s;
  }
  :global(:is([data-theme="dark"], body:has(#site-theme-toggle:checked))) .dropdown-day-item {
    color: #f1f5f9;
  }
  .dropdown-day-item:hover, .dropdown-day-item.active {
    background: #eff6ff;
  }
  :global(:is([data-theme="dark"], body:has(#site-theme-toggle:checked))) .dropdown-day-item:hover,
  :global(:is([data-theme="dark"], body:has(#site-theme-toggle:checked))) .dropdown-day-item.active {
    background: #1e3a8a;
  }
  .dropdown-day-item.active {
    font-weight: 600;
  }
  .day-item-left {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }
  .day-item-date {
    font-family: ui-monospace, SFMono-Regular, monospace;
    font-size: 0.85rem;
  }
  .day-item-weekday {
    font-size: 0.72rem;
    color: var(--text-secondary, #64748b);
  }
  .day-item-right {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }
  .badge-must {
    font-size: 0.7rem;
    padding: 0.05rem 0.3rem;
    border-radius: 4px;
    background: #fee2e2;
    color: #b91c1c;
    font-weight: 600;
  }
  :global(:is([data-theme="dark"], body:has(#site-theme-toggle:checked))) .badge-must {
    background: #7f1d1d;
    color: #fca5a5;
  }
  .badge-total {
    font-size: 0.7rem;
    color: var(--text-secondary, #64748b);
  }
</style>
