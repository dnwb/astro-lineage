{
  "name": "astro-lineage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "dev": "node scripts/validate.mjs && astro dev",
    "arxiv:refresh": "node scripts/arxiv-daily.mjs",
    "arxiv:replay": "node scripts/arxiv-daily.mjs --replay",
    "arxiv:schedule": "node scripts/arxiv-daily-scheduler.mjs",
    "arxiv:analyze": "node scripts/arxiv-ai-analyzer.mjs",
    "arxiv:weekly": "node scripts/arxiv-weekly-summary.mjs",
    "arxiv:cascade": "node scripts/arxiv-weekly-summary.mjs --cascade",
    "arxiv:archive": "node scripts/arxiv-archive.mjs",
    "arxiv:quick": "bash scripts/cron-runner.sh daily",
    "notebooklm:sync": "node scripts/notebooklm-sync.mjs",
    "notebooklm:login": "node scripts/notebooklm-sync.mjs --login",
    "bot:doctor": "node scripts/qq-official-bot.mjs --doctor",
    "bot:probe": "node scripts/probe-models.mjs",
    "test:bot": "node --test tests/agent-core.test.mjs tests/qq-official-bot.test.mjs tests/qq-users.test.mjs tests/tencent-channel-publisher.test.mjs",
    "test:fast": "node --test tests/agent-core.test.mjs tests/qq-official-bot.test.mjs tests/qq-users.test.mjs tests/tencent-channel-publisher.test.mjs tests/arxiv-scheduler.test.mjs",
    "validate": "node scripts/validate.mjs",
    "pretest": "node scripts/cleanup-test-tmp.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "posttest": "node scripts/cleanup-test-tmp.mjs",
    "check": "astro check",
    "build": "npm run validate && node scripts/editorial-index.mjs && astro build",
    "verify": "npm run validate && npm run test && npm run check && npm run build"
  },
  "dependencies": {
    "astro": "6.4.8",
    "katex": "0.16.25",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "6.0.3"
  }
}
