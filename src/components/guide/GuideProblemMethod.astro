---
import ReaderText from "../ReaderText.astro";
import { normalizeStructuredClaim } from "../../domain/academic-domain.mjs";

interface Props {
  problem?: string;
  method?: string | null;
  readingEntry?: string;
}

const { problem, method, readingEntry } = Astro.props;
const hasProblem = Boolean(problem && problem !== "unknown" && !problem.startsWith("未能从已检查材料"));
const hasMethod = Boolean(method && method.trim() !== "" && method !== "unknown");
const hasEntry = Boolean(readingEntry && readingEntry.trim() !== "");

const problemClaim = normalizeStructuredClaim(problem, "研究课题");
const methodClaim = normalizeStructuredClaim(method, "方法机制");
---

<div class="guide-module-panel guide-problem-method">
  <div class="module-header">
    <span class="module-icon">🎯</span>
    <h4 class="module-title">
      <span class="language-primary">核心课题、机制与切入建议</span>
      <span class="language-english" lang="en">Problem, Method & Entry</span>
    </h4>
  </div>

  <div class="module-content">
    {hasProblem && (
      <div class="guide-field-block">
        <div class="guide-lead-row">
          <span class="guide-tag tag-problem">🎯 课题目标</span>
          <strong class="claim-headline">{problemClaim.headline}</strong>
        </div>
        {problemClaim.detailed_text && problemClaim.detailed_text !== problemClaim.headline && (
          <div class="claim-body-text">
            <ReaderText text={problemClaim.detailed_text} />
          </div>
        )}
      </div>
    )}

    {hasMethod && (
      <div class="guide-field-block">
        <div class="guide-lead-row">
          <span class="guide-tag tag-method">⚙️ 方法与机制</span>
          <strong class="claim-headline">{methodClaim.headline}</strong>
        </div>
        {methodClaim.detailed_text && methodClaim.detailed_text !== methodClaim.headline && (
          <div class="claim-body-text">
            <ReaderText text={methodClaim.detailed_text} />
          </div>
        )}
      </div>
    )}

    {hasEntry && (
      <div class="guide-field-block">
        <div class="guide-lead-row">
          <span class="guide-tag tag-entry">💡 建议入口</span>
          <span class="entry-lead-text"><ReaderText text={readingEntry!} /></span>
        </div>
      </div>
    )}
  </div>
</div>

<style>
  .guide-module-panel {
    background: var(--bg-surface, #ffffff);
    border: 1px solid var(--border-color, #e2e8f0);
    border-radius: 0.45rem;
    overflow: hidden;
  }
  :global([data-theme="dark"]) .guide-module-panel {
    background: #1e293b;
    border-color: #334155;
  }
  .module-header {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.75rem;
    background: #f8fafc;
    border-bottom: 1px solid var(--border-color, #e2e8f0);
  }
  :global([data-theme="dark"]) .module-header {
    background: #0f172a;
    border-bottom-color: #334155;
  }
  .module-icon {
    font-size: 0.95rem;
  }
  .module-title {
    margin: 0;
    font-size: 0.86rem;
    font-weight: 700;
    color: var(--text-heading, #0f172a);
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }
  :global([data-theme="dark"]) .module-title {
    color: #f8fafc;
  }
  .module-content {
    padding: 0.55rem 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .guide-field-block {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .guide-lead-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.45rem;
    line-height: 1.45;
  }
  .guide-tag {
    display: inline-flex;
    align-items: center;
    padding: 0.08rem 0.4rem;
    font-size: 0.72rem;
    font-weight: 700;
    border-radius: 0.25rem;
    letter-spacing: 0.02em;
    flex-shrink: 0;
  }
  .tag-problem {
    background: #ecfdf5;
    color: #065f46;
    border: 1px solid #a7f3d0;
  }
  .tag-method {
    background: #f0fdf4;
    color: #15803d;
    border: 1px solid #bbf7d0;
  }
  .tag-entry {
    background: #fefce8;
    color: #854d0e;
    border: 1px solid #fef08a;
  }
  :global([data-theme="dark"]) .tag-problem {
    background: #064e3b;
    color: #6ee7b7;
    border-color: #047857;
  }
  :global([data-theme="dark"]) .tag-method {
    background: #14532d;
    color: #86efac;
    border-color: #16a34a;
  }
  :global([data-theme="dark"]) .tag-entry {
    background: #713f12;
    color: #fef08a;
    border-color: #a16207;
  }
  .claim-headline {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-heading, #0f172a);
    line-height: 1.45;
  }
  :global([data-theme="dark"]) .claim-headline {
    color: #f1f5f9;
  }
  .entry-lead-text {
    font-size: 0.86rem;
    color: var(--text-body, #334155);
    line-height: 1.45;
  }
  :global([data-theme="dark"]) .entry-lead-text {
    color: #cbd5e1;
  }
  .claim-body-text {
    font-size: 0.84rem;
    line-height: 1.55;
    color: var(--text-body, #475569);
    padding-left: 0.5rem;
    border-left: 2px solid var(--border-color, #e2e8f0);
    margin-top: 0.15rem;
  }
  :global([data-theme="dark"]) .claim-body-text {
    color: #94a3b8;
    border-left-color: #334155;
  }
</style>
