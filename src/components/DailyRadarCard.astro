---
import ReaderText from "./ReaderText.astro";
import DailyRadarGuide from "./DailyRadarGuide.astro";
import DailyRadarSource from "./DailyRadarSource.astro";
import { projectPotentialLineage, radarCardAnchor, radarCoverageDescription } from "../../scripts/daily-radar.mjs";
import {
  matchScientificTags,
  extractTransientIdentifiers,
  normalizeStructuredClaim,
  formatAuthorList,
  deriveFigurePhysicalCore,
  hasVerifiedFigureAsset,
} from "../domain/academic-domain.mjs";
import { formatSourceBadge, formatPaperCitation } from "../domain/journal-adapter.mjs";
import { resolvePaperTitleZhSync } from "../domain/paper-translation.mjs";

type AnyRecord = Record<string, any>;
type CoverageLevel = "abstract_only" | "body_partial" | "full_body";

interface Props {
  item: AnyRecord;
  visibleWorkLinks: Record<string, { href: string; title: string }>;
}

const { item, visibleWorkLinks } = Astro.props;
const record = item.analysis as AnyRecord;
const coverage = record.coverage as AnyRecord;
const coverageLevel = coverage.level as CoverageLevel;
const guide = record.analysis as AnyRecord;
const lineage = projectPotentialLineage(guide.potential_lineage, Object.keys(visibleWorkLinks)) as AnyRecord;
const lineageCandidates = Array.isArray(lineage.candidates) ? lineage.candidates : [];
const prerequisiteWorks = Array.isArray(guide.prerequisite_works)
  ? guide.prerequisite_works.filter((prerequisite: AnyRecord) => visibleWorkLinks[prerequisite.work_id])
  : [];
const coverageDescription = radarCoverageDescription(coverage);
const resultLabel = coverageLevel === "abstract_only" ? "Abstract Lead" : priorityLabel(item.analysis.priority);
const isMustRead = item.analysis.priority === "must_read";
const isSkim = item.analysis.priority === "skip";
const isWorthKnowing = !isMustRead && !isSkim;
const cardVariant = isSkim
  ? "skim"
  : isMustRead
    ? "must-read"
    : "worth-knowing";

const resultClaim = normalizeStructuredClaim(record.analysis.result || guide.result, "Main Finding");
const problemClaim = normalizeStructuredClaim(guide.problem, "Objective");
const reasonClaim = normalizeStructuredClaim(guide.reason, "Why Read");

const rawFigures = guide.figures || record.figures || [];
const cardFigures = Array.isArray(rawFigures) ? rawFigures.filter(hasVerifiedFigureAsset) : [];
const primaryFigure = cardFigures.length > 0 ? cardFigures[0] : null;
const cleanFigPath = typeof primaryFigure?.url === "string" ? primaryFigure.url.replace(/^\/arxiv-figures\//u, "") : "";
const arxivFigFallback = cleanFigPath ? `https://arxiv.org/html/${cleanFigPath}` : (primaryFigure?.url || "");
const primaryFigureCore = primaryFigure
  ? deriveFigurePhysicalCore(
      primaryFigure,
      { result: record.analysis.result || guide.result, problem: guide.problem },
      { lang: "en" }
    )
  : "";
const BADGE_MAP: Record<string, string> = {
  "数据拟合与模型对比": "Model vs Data Fitting",
  "物理模型示意图": "Physical Model Schematic",
  "核心物理演化图": "Physical Evolution",
  "核心物理结果": "Physical Result",
  "核心观测结果": "Observational Evidence",
  "观测总体曲线/能谱": "Observational Light Curve / SED",
};
const primaryFigureBadge = primaryFigure
  ? (BADGE_MAP[primaryFigure.category_badge || primaryFigure.categoryBadge || ""] || primaryFigure.category_badge || primaryFigure.categoryBadge || primaryFigure.label || "Key Figure")
  : "";

const titleZh = resolvePaperTitleZhSync(item);
const scientificTags = matchScientificTags(item);
const transientIds = extractTransientIdentifiers(
  `${item.title} ${titleZh || ""} ${guide.problem || ""} ${record.analysis.result || ""} ${guide.reason || ""}`
);
const isArxiv = !item.source || item.source === "arxiv";
const sourceLabel = formatSourceBadge(item.source);
const citationText = formatPaperCitation(item);
const pdfLink = item.pdf_url || (item.arxiv_id ? `https://arxiv.org/pdf/${item.arxiv_id}` : null);
const searchIndex = `${item.title} ${titleZh || ""} ${item.arxiv_id || item.doi || ""} ${(item.authors || []).join(" ")} ${guide.problem || ""} ${record.analysis.result || ""} ${guide.reason || ""} ${scientificTags.join(" ")} ${transientIds.join(" ")}`.toLowerCase();

const relationLabels: Record<string, string> = {
  builds_on: "builds on",
  extends: "extends",
  tests: "tests",
  constrains: "constrains",
  challenges: "challenges",
  replaces_assumption: "replaces assumption",
  corrects: "corrects",
};

function priorityLabel(priority: string) {
  return priority === "must_read" ? "Reported Results & Boundaries" : "Key Progress & Limits";
}
---

<li
  class="radar-list-item"
  id={`paper-${item.arxiv_id}`}
  data-arxiv-id={item.arxiv_id}
  data-priority={item.analysis.priority}
  data-tags={scientificTags.join(",")}
  data-topics={scientificTags.join(" ")}
  data-transients={transientIds.join(",")}
  data-search={searchIndex}
>
  <span id={`arxiv-${item.arxiv_id}`} class="paper-anchor-target"></span>
  <span id={`card-${item.arxiv_id}-v${item.revision || 1}`} class="paper-anchor-target"></span>
  <span id={`card-${item.arxiv_id}`} class="paper-anchor-target"></span>
  <span id={`guide-${item.arxiv_id}`} class="paper-anchor-target"></span>
  <span id={`guide-${item.arxiv_id.replace(/\./g, "-")}`} class="paper-anchor-target"></span>
  <article class={`radar-card radar-card-${cardVariant}`} id={radarCardAnchor(item.arxiv_id, item.revision)}>
    {isMustRead && (
      <>
        <div class="radar-card-header-row">
          <div class="header-left-badges">
            <span class="tier-pill priority-pill-must-read">⭐ Must Read</span>
            {isArxiv ? (
              <a class="radar-arxiv-badge" href={item.url} target="_blank" rel="noopener">arXiv:{item.arxiv_id}</a>
            ) : (
              <span class={`radar-source-badge radar-source-${item.source}`}>{sourceLabel}</span>
              <a class="radar-citation-badge" href={item.url} target="_blank" rel="noopener">{citationText}</a>
            )}
            {pdfLink && (
              <a class="radar-pdf-badge" href={pdfLink} target="_blank" rel="noopener" title="Read or download official PDF">📄 PDF</a>
            )}
            {coverageLevel === "full_body" && (
              <span class="radar-coverage-badge">Full Body</span>
            )}
            {transientIds.map((tid: string) => (
              <span class="radar-transient-tag" title="Observational Target">🔭 {tid}</span>
            ))}
            {scientificTags.map((tag: string) => (
              <span class="radar-category-tag">{tag}</span>
            ))}
          </div>
          {Array.isArray(item.authors) && item.authors.length > 0 ? (
            <span class="radar-author-preview">
              <span>{formatAuthorList(item.authors)}</span>
            </span>
          ) : null}
        </div>

        <div class={primaryFigure ? "radar-must-split" : "radar-must-single"}>
          <div class="radar-must-main">
            <h3 class="radar-card-title">
              <a class="paper-title" href={item.url}>
                <span class="paper-title-en"><ReaderText text={item.title} /></span>
              </a>
            </h3>

            <!-- Full Rich BLUF Grid for Must Read -->
            <div class="radar-bluf-brief must-read-bluf">
              {guide.problem && guide.problem !== "unknown" && !guide.problem.startsWith("未能从已检查材料") && !guide.problem.startsWith("Could not be derived") ? (
                <div class="bluf-item bluf-item-problem">
                  <span class="bluf-mark bluf-tag bluf-label problem-mark problem-tag">Problem</span>
                  <div class="bluf-content-wrapper">
                    {problemClaim.headline && !problemClaim.detailed_text.startsWith(problemClaim.headline.replace(/\.\.\.$/, "")) && (
                      <span class="bluf-headline">{problemClaim.headline}</span>
                    )}
                    <span class="bluf-text"><ReaderText text={problemClaim.detailed_text} /></span>
                  </div>
                </div>
              ) : null}
              <div class="bluf-item bluf-item-result">
                <span class="bluf-mark bluf-tag bluf-label result-mark result-tag" title={resultLabel}>Result</span>
                <div class="bluf-content-wrapper">
                  {resultClaim.headline && !resultClaim.detailed_text.startsWith(resultClaim.headline.replace(/\.\.\.$/, "")) && (
                    <span class="bluf-headline">{resultClaim.headline}</span>
                  )}
                  <span class="bluf-text"><ReaderText text={resultClaim.detailed_text} /></span>
                </div>
              </div>
              {guide.reason ? (
                <div class="bluf-item bluf-item-reason">
                  <span class="bluf-mark bluf-tag bluf-label reason-mark reason-tag">Reason</span>
                  <div class="bluf-content-wrapper">
                    {reasonClaim.headline && !reasonClaim.detailed_text.startsWith(reasonClaim.headline.replace(/\.\.\.$/, "")) && (
                      <span class="bluf-headline">{reasonClaim.headline}</span>
                    )}
                    <span class="bluf-text"><ReaderText text={reasonClaim.detailed_text} /></span>
                  </div>
                </div>
              ) : null}
            </div>
          </div>

          {primaryFigure && (
            <figure class="radar-inline-figure">
              <div class="radar-figure-frame">
                <a href={primaryFigure.url} target="_blank" rel="noopener noreferrer" class="radar-figure-link" title="Click to inspect full-resolution figure">
                  <img
                    src={primaryFigure.url}
                    alt={primaryFigure.caption || `${item.title} key figure`}
                    loading="lazy"
                    onerror={`this.onerror=null;this.src='${arxivFigFallback}';if(this.parentElement&&this.parentElement.tagName==='A')this.parentElement.href='${arxivFigFallback}';`}
                  />
                </a>
                {cardFigures.length > 1 && (
                  <span class="radar-figure-count-badge" title={`${cardFigures.length} key figures in guide`}>
                    +{cardFigures.length - 1} more
                  </span>
                )}
              </div>
              <figcaption class="radar-figure-caption">
                <span class={`radar-fig-badge radar-fig-${primaryFigure.category || "theoretical"}`}>
                  {primaryFigure.label ? `${primaryFigure.label} · ${primaryFigureBadge}` : primaryFigureBadge}
                </span>
                {primaryFigureCore && (
                  <p class="radar-figure-core">
                    <ReaderText text={primaryFigureCore} />
                  </p>
                )}
              </figcaption>
            </figure>
          )}
        </div>

        {(prerequisiteWorks.length > 0 || lineageCandidates.length > 0) && (
          <div class="must-read-connections-bar">
            {prerequisiteWorks.length > 0 && (
              <div class="must-read-connections">
                <span class="connection-label">📚 Prerequisites:</span>
                <span class="connection-items">
                  {prerequisiteWorks.map((p: AnyRecord) => (
                    <a href={visibleWorkLinks[p.work_id]?.href} class="connection-link">{visibleWorkLinks[p.work_id]?.title}</a>
                  ))}
                </span>
              </div>
            )}
            {lineageCandidates.length > 0 && (
              <div class="must-read-connections">
                <span class="connection-label">🔗 Lineage:</span>
                <span class="connection-items">
                  {lineageCandidates.map((c: AnyRecord) => (
                    <span class="connection-pill">{relationLabels[c.relation] || c.relation} {visibleWorkLinks[c.target_work_id]?.title || ""}</span>
                  ))}
                </span>
              </div>
            )}
          </div>
        )}

        <!-- Deep Reading Modal Trigger Bar -->
        <div class="radar-deep-dive-bar">
          <button
            type="button"
            class="radar-open-modal-btn"
            popovertarget={`modal-${item.arxiv_id.replace(/\./g, "-")}-v${item.revision || 1}`}
            aria-haspopup="dialog"
          >
            <span class="btn-left">
              <span class="btn-icon">🔬</span>
              <span class="btn-title">Read Guide</span>
            </span>
            <span class="btn-right">
              <span class="btn-arrow" aria-hidden="true">↗</span>
            </span>
          </button>
        </div>
      </>
    )}

    {isWorthKnowing && (
      <>
        <div class="radar-card-header-row worth-knowing-header-row">
          <div class="header-left-badges">
            <span class="tier-pill priority-pill-worth-knowing">📌 Follow</span>
            {isArxiv ? (
              <a class="radar-arxiv-badge" href={item.url} target="_blank" rel="noopener">arXiv:{item.arxiv_id}</a>
            ) : (
              <span class={`radar-source-badge radar-source-${item.source}`}>{sourceLabel}</span>
              <a class="radar-citation-badge" href={item.url} target="_blank" rel="noopener">{citationText}</a>
            )}
            {pdfLink && (
              <a class="radar-pdf-badge" href={pdfLink} target="_blank" rel="noopener" title="Read or download official PDF">📄 PDF</a>
            )}
            {transientIds.map((tid: string) => (
              <span class="radar-transient-tag" title="Observational Target">🔭 {tid}</span>
            ))}
            {scientificTags.map((tag: string) => (
              <span class="radar-category-tag">{tag}</span>
            ))}
          </div>
          <div class="header-right-actions">
            {Array.isArray(item.authors) && item.authors.length > 0 ? (
              <span class="radar-author-preview">
                <span>{formatAuthorList(item.authors)}</span>
              </span>
            ) : null}
            <button
              type="button"
              class="radar-open-modal-btn compact-guide-btn"
              popovertarget={`modal-${item.arxiv_id.replace(/\./g, "-")}-v${item.revision || 1}`}
              aria-haspopup="dialog"
              title="Quick reading guide"
            >
              <span class="btn-left">
                <span class="btn-icon">🔬</span>
                <span class="btn-title">Quick Guide</span>
              </span>
              <span class="btn-right">
                <span class="btn-arrow" aria-hidden="true">↗</span>
              </span>
            </button>
          </div>
        </div>

        <h3 class="radar-card-title worth-knowing-title">
          <a class="paper-title" href={item.url}>
            <span class="paper-title-en">{item.title}</span>
          </a>
        </h3>

        <!-- Compact 2-row Summary (Result & Reason) -->
        <div class="radar-bluf-brief worth-knowing-bluf">
          <div class="bluf-item bluf-item-result">
            <span class="bluf-mark bluf-tag bluf-label result-mark result-tag" title={resultLabel}>Result</span>
            <div class="bluf-content-wrapper">
              <span class="bluf-text"><ReaderText text={resultClaim.detailed_text} /></span>
            </div>
          </div>
          {guide.reason ? (
            <div class="bluf-item bluf-item-reason">
              <span class="bluf-mark bluf-tag bluf-label reason-mark reason-tag">Reason</span>
              <div class="bluf-content-wrapper">
                <span class="bluf-text"><ReaderText text={reasonClaim.detailed_text} /></span>
              </div>
            </div>
          ) : null}
        </div>
      </>
    )}

    {isSkim && (
      <>
        <div class="radar-skim-row single-row-layout">
          <div class="skim-meta-leading">
            <span class="tier-pill priority-pill-skim">⚡ Skim</span>
            {isArxiv ? (
              <a class="radar-arxiv-badge" href={item.url} target="_blank" rel="noopener">arXiv:{item.arxiv_id}</a>
            ) : (
              <span class={`radar-source-badge radar-source-${item.source}`}>{sourceLabel}</span>
              <a class="radar-citation-badge" href={item.url} target="_blank" rel="noopener">{citationText}</a>
            )}
            {pdfLink && (
              <a class="radar-pdf-badge" href={pdfLink} target="_blank" rel="noopener" title="Read or download official PDF">📄 PDF</a>
            )}
          </div>
          <div class="skim-main-col">
            <h4 class="radar-card-title skim-card-title">
              <a class="paper-title" href={item.url} title={item.title}>
                <span class="paper-title-en">{item.title}</span>
              </a>
            </h4>
            <p class="skim-result-preview"><ReaderText text={resultClaim?.detailed_text || guide.reason || guide.result || ""} /></p>
          </div>
          <div class="skim-meta-trailing">
            {scientificTags.map((tag: string) => (
              <span class="radar-category-tag">{tag}</span>
            ))}
            {transientIds.map((tid: string) => (
              <span class="radar-transient-tag" title="Observational Target">🔭 {tid}</span>
            ))}
            <button
              type="button"
              class="radar-open-modal-btn skim-modal-btn"
              popovertarget={`modal-${item.arxiv_id.replace(/\./g, "-")}-v${item.revision || 1}`}
              aria-haspopup="dialog"
              title="Quick reading summary and details"
            >
              Details ↗
            </button>
          </div>
        </div>

        <details class="skim-expandable-drawer">
          <summary class="skim-drawer-toggle" title="Toggle quick summary">
            <span class="toggle-text">Summary</span>
            <span class="toggle-icon" aria-hidden="true">▾</span>
          </summary>
          <div class="skim-drawer-content">
            <div class="bluf-item bluf-item-skim">
              <span class="bluf-mark bluf-tag bluf-label skim-mark skim-tag">Skim</span>
              <div class="bluf-content-wrapper">
                <span class="bluf-text"><ReaderText text={guide.reason || record.analysis.result || guide.result} /></span>
              </div>
            </div>
          </div>
        </details>
      </>
    )}

    <!-- Deep Dive Modal Popover (Native HTML5 Popover, No Script, Top Layer, In-Page Overlay) -->
    <div
      class="radar-modal-dialog"
      id={`modal-${item.arxiv_id.replace(/\./g, "-")}-v${item.revision || 1}`}
      popover="auto"
      role="dialog"
      aria-labelledby={`modal-title-${item.arxiv_id.replace(/\./g, "-")}-v${item.revision || 1}`}
    >
      <div class="radar-modal-container">
        <header class="radar-modal-header">
          <div class="modal-meta-row">
            <div class="modal-badges">
              <span class={`tier-pill priority-pill-${cardVariant}`}>
                {item.analysis.priority === "must_read" ? "⭐ Must Read" : isSkim ? "⚡ Skim" : "📌 Follow"}
              </span>
              {isArxiv ? (
                <span class="radar-arxiv-badge">arXiv:{item.arxiv_id}v{item.revision || 1}</span>
              ) : (
                <span class={`radar-source-badge radar-source-${item.source}`}>{sourceLabel}</span>
                <span class="radar-citation-badge">{citationText}</span>
              )}
              {scientificTags.map((tag: string) => (
                <span class="radar-category-tag">{tag}</span>
              ))}
            </div>
            <button
              type="button"
              class="radar-modal-close-btn"
              popovertarget={`modal-${item.arxiv_id.replace(/\./g, "-")}-v${item.revision || 1}`}
              popovertargetaction="hide"
              aria-label="Close reading modal (ESC)"
            >✕</button>
          </div>
          <h2 class="radar-modal-title" id={`modal-title-${item.arxiv_id.replace(/\./g, "-")}-v${item.revision || 1}`}>
            <ReaderText text={item.title} />
          </h2>
          {Array.isArray(item.authors) && item.authors.length > 0 && (
            <p class="radar-modal-authors">Authors: {formatAuthorList(item.authors)}</p>
          )}
        </header>

        <div class="radar-modal-body">
          {isSkim ? (
            <div class="radar-skim-box">
              <p class="radar-field-row"><strong>Reported Results & Boundaries: </strong><ReaderText text={record.analysis.result || guide.result} /></p>
              {guide.problem && guide.problem !== "unknown" ? (
                <p class="radar-field-row"><strong>Problem & Objective: </strong><ReaderText text={guide.problem} /></p>
              ) : null}
              {prerequisiteWorks.length > 0 && (
                <p class="radar-field-row"><strong>Prerequisites: </strong>{prerequisiteWorks.map((p: AnyRecord) => visibleWorkLinks[p.work_id]?.title).filter(Boolean).join(", ")}</p>
              )}
              {lineageCandidates.length > 0 && (
                <p class="radar-field-row"><strong>Potential Lineage: </strong>{lineageCandidates.map((c: AnyRecord) => `${relationLabels[c.relation] || c.relation} ${visibleWorkLinks[c.target_work_id]?.title || ""}`).filter(Boolean).join("; ")}</p>
              )}
              <p class="radar-skim-coverage">{coverageDescription.english}</p>
            </div>
          ) : (
            <DailyRadarGuide item={item} visibleWorkLinks={visibleWorkLinks} />
          )}

          <DailyRadarSource item={item} />
        </div>

        <footer class="radar-modal-footer">
          <div class="radar-modal-ext-links">
            <a class="modal-ext-link" href={item.url} target="_blank" rel="noopener">arXiv ↗</a>
            <a class="modal-ext-link" href={`https://arxiv.org/pdf/${item.arxiv_id}`} target="_blank" rel="noopener">PDF ↗</a>
          </div>
          <button
            type="button"
            class="radar-modal-btn-done"
            popovertarget={`modal-${item.arxiv_id.replace(/\./g, "-")}-v${item.revision || 1}`}
            popovertargetaction="hide"
          >
            Back to list
          </button>
        </footer>
      </div>
    </div>
  </article>
</li>

<style>
  .radar-card-header-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.45rem;
    margin-bottom: 0.35rem;
  }
  .header-left-badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }
  .radar-author-preview {
    font-size: 0.78rem;
    color: var(--text-secondary, #64748b);
    font-weight: 500;
  }
  :global([data-theme="dark"]) .radar-author-preview {
    color: #94a3b8;
  }
  .paper-anchor-target {
    display: block;
    position: relative;
    top: -80px;
    visibility: hidden;
    height: 0;
  }
  .radar-card:target,
  .radar-list-item:has(:target) .radar-card {
    outline: 2px solid #ea580c;
    box-shadow: 0 0 0 4px rgba(234, 88, 12, 0.2), 0 10px 15px -3px rgba(0, 0, 0, 0.1);
  }
  .tier-pill {
    display: inline-block;
    padding: 0.15rem 0.5rem;
    font-size: 0.72rem;
    font-weight: 700;
    border-radius: 9999px;
    letter-spacing: 0.02em;
  }
  .priority-pill-must-read {
    background: #fed7aa;
    color: #9a3412;
    border: 1px solid #f97316;
  }
  .priority-pill-worth-knowing {
    background: #e0e7ff;
    color: #3730a3;
    border: 1px solid #818cf8;
  }
  .priority-pill-skim {
    background: #f1f5f9;
    color: #475569;
    border: 1px solid #cbd5e1;
  }
  .radar-transient-tag {
    display: inline-flex;
    align-items: center;
    padding: 0.12rem 0.4rem;
    font-size: 0.72rem;
    font-weight: 700;
    font-family: ui-monospace, monospace;
    background: #fef08a;
    color: #854d0e;
    border: 1px solid #eab308;
    border-radius: 0.25rem;
  }
  .radar-category-tag {
    display: inline-block;
    padding: 0.12rem 0.4rem;
    font-size: 0.72rem;
    font-weight: 600;
    background: #f1f5f9;
    color: #334155;
    border: 1px solid #cbd5e1;
    border-radius: 0.25rem;
  }
  :global(:is([data-theme="dark"], body:has(#site-theme-toggle:checked))) .priority-pill-must-read {
    background: rgba(234, 88, 12, 0.18);
    color: #fdba74;
    border-color: rgba(234, 88, 12, 0.35);
  }
  :global(:is([data-theme="dark"], body:has(#site-theme-toggle:checked))) .priority-pill-worth-knowing {
    background: rgba(99, 102, 241, 0.18);
    color: #c7d2fe;
    border-color: rgba(99, 102, 241, 0.35);
  }
  :global(:is([data-theme="dark"], body:has(#site-theme-toggle:checked))) .priority-pill-skim {
    background: rgba(51, 65, 85, 0.3);
    color: #94a3b8;
    border-color: rgba(71, 85, 105, 0.4);
  }
