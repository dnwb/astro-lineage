    color: #94a3b8;
  }
  :global(:is([data-theme="dark"], body:has(#site-theme-toggle:checked))) .month-selector-bar {
    background: #0f172a;
    border-color: #334155;
  }
  :global(:is([data-theme="dark"], body:has(#site-theme-toggle:checked))) .month-selector-label {
    color: #cbd5e1;
  }
  :global(:is([data-theme="dark"], body:has(#site-theme-toggle:checked))) .month-tab-pill {
    background: #1e293b;
    border-color: #334155;
    color: #cbd5e1;
  }
  :global(:is([data-theme="dark"], body:has(#site-theme-toggle:checked))) .month-tab-pill:hover {
    background: #1e3a8a;
    color: #60a5fa;
