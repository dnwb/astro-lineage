---
import ReaderText from "../ReaderText.astro";
import DailyRadarGuide from "../DailyRadarGuide.astro";
import DailyRadarSource from "../DailyRadarSource.astro";
import { radarCardAnchor } from "../../../scripts/daily-radar.mjs";
import {
  matchScientificTags,
  extractTransientIdentifiers,
  formatAnnouncementInBeijing,
  TOPIC_FILTER_SPECS,
  getBibliographicUrl,
  getBibliographicSourceName,
  formatAuthorList,
  deriveFigurePhysicalCore,
  hasVerifiedFigureAsset,
  groupPicksByTheme,
} from "../../domain/academic-domain.mjs";
import { resolvePaperTitleZhSync } from "../../domain/paper-translation.mjs";

interface Props {
  topPicks: any[];
  paperMap?: Map<string, any>;
  paperDailyDateMap?: Map<string, string>;
  authorMap?: Map<string, string[]>;
  dailyAnalysisMap?: Map<string, any>;
  dailyItemMap?: Map<string, any>;
  weekId?: string;
  weeklyData?: any;
}

const {
  topPicks,
  paperMap = new Map(),
  paperDailyDateMap = new Map(),
  authorMap = new Map(),
  dailyAnalysisMap = new Map(),
  dailyItemMap = new Map(),
  weekId = "",
  weeklyData = {},
} = Astro.props;

const priorityLabels: Record<string, { zh: string; en: string; class: string }> = {
  must_read: { zh: "Must Read", en: "Must Read", class: "badge-must-read" },
  worth_knowing: { zh: "Followed", en: "Followed", class: "badge-worth-knowing" },
  skip: { zh: "Skim", en: "Skim", class: "badge-skip" },
};

function resolveAuthors(id: string, direct?: any): string[] {
  if (Array.isArray(direct?.authors) && direct.authors.length > 0) return direct.authors;
  const inMap = paperMap.get(id) as any;
  if (Array.isArray(inMap?.authors) && inMap.authors.length > 0) return inMap.authors;
  return authorMap.get(id) || [];
}

function getDailyItem(arxivId: string, pickObj?: any) {
  const existing = dailyItemMap.get(arxivId);
  if (existing) return existing;
  const analysis = dailyAnalysisMap.get(arxivId);
  const paper = paperMap.get(arxivId) || pickObj;
  if (analysis && paper) {
    return {
      arxiv_id: arxivId,
      revision: paper.revision || 1,
      title: paper.title || "",
      abstract: paper.abstract || "",
      published: paper.published || "",
      updated: paper.updated || "",
      authors: resolveAuthors(arxivId, paper),
      url: paper.url || `https://arxiv.org/abs/${arxivId}`,
      categories: paper.categories || ["astro-ph.HE"],
      primary_category: paper.primary_category || "astro-ph.HE",
      analysis,
      dailyDate: paperDailyDateMap.get(arxivId),
    };
  }
  return null;
}

function formatBibtex(paper: any) {
  const cleanId = String(paper.arxiv_id || "").trim();
  const resolved = resolveAuthors(cleanId, paper);
  const authors = resolved.length > 0
    ? resolved.join(" and ")
    : "Author, A.";
  const year = paper.published ? new Date(paper.published).getFullYear() : (weekId?.slice(0, 4) || new Date().getFullYear());
  const title = String(paper.title || "").trim();
  return `@article{arxiv_${cleanId.replace(/[^a-zA-Z0-9]/g, "_")},
  author = {${authors}},
  title = {{${title}}},
  journal = {arXiv preprint arXiv:${cleanId}},
  year = {${year}},
  eprint = {${cleanId}},
  archivePrefix = {arXiv},
  primaryClass = {astro-ph.HE}
}`;
}

function formatCitation(paper: any) {
  const cleanId = String(paper.arxiv_id || "").trim();
  const resolved = resolveAuthors(cleanId, paper);
  const firstAuthor = resolved.length > 0
    ? resolved[0]
    : "Author";
  const year = paper.published ? new Date(paper.published).getFullYear() : (weekId?.slice(0, 4) || new Date().getFullYear());
  return `${firstAuthor} et al. (${year}), arXiv:${cleanId}`;
}

const topicCounts: Record<string, number> = {};
const totalCount = topPicks?.length ?? 0;
const mustCount = (topPicks ?? []).filter((p: any) => p.priority === "must_read").length;
const worthCount = (topPicks ?? []).filter((p: any) => p.priority === "worth_knowing").length;

const BADGE_MAP: Record<string, string> = {
  "数据拟合与模型对比": "Model vs Data Fitting",
  "物理模型示意图": "Physical Model Schematic",
  "核心物理演化图": "Physical Evolution",
  "核心物理结果": "Physical Result",
  "核心观测结果": "Observational Evidence",
  "观测总体曲线/能谱": "Observational Light Curve / SED",
};

function resolveFigureBadge(fig: any): string {
  const raw = fig?.category_badge || fig?.categoryBadge || "";
  return BADGE_MAP[raw] || raw || fig?.label || "Key Figure";
}

const enrichedPicks = (topPicks ?? []).map((pick: any) => {
  const paperObj = paperMap.get(pick.arxiv_id);
  const dailyDate = paperDailyDateMap.get(pick.arxiv_id);
  const dailyItem = getDailyItem(pick.arxiv_id, pick);
  const dailyRec = dailyAnalysisMap.get(pick.arxiv_id);
  const rawFigures = pick.figures || dailyRec?.analysis?.analysis?.figures || dailyRec?.analysis?.figures || dailyRec?.figures || [];
  const figures = Array.isArray(rawFigures) ? rawFigures.filter(hasVerifiedFigureAsset) : [];
  const primaryFigure = figures.length > 0 ? figures[0] : null;
  const primaryFigureCore = primaryFigure
    ? deriveFigurePhysicalCore(
        primaryFigure,
        {
          result: pick.core_insight || dailyRec?.analysis?.analysis?.result,
          problem: pick.recommendation_reason || dailyRec?.analysis?.analysis?.problem,
        },
        { lang: "en" }
      )
    : "";
  const primaryFigureBadge = primaryFigure ? resolveFigureBadge(primaryFigure) : "";

  const fullText = [
    pick.title || "",
    pick.recommendation_reason || "",
    pick.core_insight || "",
    pick.reading_guide || "",
    dailyRec?.analysis?.analysis?.problem || "",
    dailyRec?.analysis?.analysis?.reason || "",
    dailyRec?.analysis?.analysis?.result || "",
  ].join(" ");

  const matchingItem = {
    title: pick.title,
    analysis: {
      analysis: {
        problem: `${pick.recommendation_reason || ""} ${dailyRec?.analysis?.analysis?.problem || ""}`,
        reason: `${pick.reading_guide || ""} ${dailyRec?.analysis?.analysis?.reason || ""}`,
        result: `${pick.core_insight || ""} ${dailyRec?.analysis?.analysis?.result || ""}`,
      }
    }
  };

  const tags = matchScientificTags(matchingItem);
  const transientIds = extractTransientIdentifiers(fullText);

  for (const t of tags) {
    topicCounts[t] = (topicCounts[t] || 0) + 1;
  }

  return {
    pick,
    paperObj,
    dailyDate,
    dailyItem,
    figures,
    primaryFigure,
    primaryFigureCore,
    primaryFigureBadge,
    modalId: `modal-pick-${pick.arxiv_id.replace(/\./g, "-")}`,
    badge: priorityLabels[pick.priority] ?? priorityLabels.worth_knowing,
    tags,
    transientIds,
  };
});

const activeTopicFilters = TOPIC_FILTER_SPECS
  .map((spec) => ({ ...spec, count: topicCounts[spec.id] || 0 }))
  .filter((spec) => spec.count > 0);

// Group picks by theme for thematic ordering while retaining default index
const rawThemeGroups = groupPicksByTheme(
  enrichedPicks.map((ep) => ({
    ...ep.pick,
    keywords: ep.tags,
    categories: ep.paperObj?.categories || ep.pick.categories || [],
    key_insight: ep.pick.core_insight || "",
    _enriched: ep,
  })),
  weeklyData
);

let themeSlotCursor = 1;
const themeGroups = rawThemeGroups.map((group, gIdx) => {
  const headerOrder = themeSlotCursor++;
  const items = group.picks.map((wrapped: any) => {
    const ep = wrapped._enriched;
    const themeOrder = themeSlotCursor++;
    return { ...ep, themeOrder };
  });
  return {
    themeIndex: gIdx + 1,
    theme: group.theme,
    description: group.description,
    headerOrder,
    items,
  };
});

const enrichedWithOrder = enrichedPicks.map((ep, idx) => {
  let matchedThemeOrder = idx + 1;
  let matchedThemeName = "";
  for (const g of themeGroups) {
    const found = g.items.find((it: any) => it.pick.arxiv_id === ep.pick.arxiv_id);
    if (found) {
      matchedThemeOrder = found.themeOrder;
      matchedThemeName = g.theme;
      break;
    }
  }
  return {
    ...ep,
    defaultOrder: idx + 1,
    themeOrder: matchedThemeOrder,
    themeName: matchedThemeName,
  };
});
---

<section class="weekly-section picks-section" id="top-picks">
  <div class="section-heading">
    <p class="section-kicker">Curated Selection</p>
    <h2>Weekly Top Picks</h2>
  </div>

  <!-- At-a-Glance Visual Triage Matrix (retained from previous version) -->
  {enrichedWithOrder.length > 0 && (
    <details class="web-triage-details" open>
      <summary class="web-triage-summary">
        <div class="web-triage-summary-left">
          <span class="web-triage-kicker">★ AT-A-GLANCE VISUAL TRIAGE</span>
          <span class="web-triage-title">Weekly Top Picks Overview ({mustCount} Must Read · {worthCount} Followed)</span>
        </div>
        <span class="web-triage-toggle-hint">Click to collapse / expand ▾</span>
      </summary>
      <div class="web-triage-grid">
        {enrichedWithOrder.map(({ pick, primaryFigure, primaryFigureBadge, badge, tags }) => {
          const cleanFigPath = typeof primaryFigure?.url === "string" ? primaryFigure.url.replace(/^\/arxiv-figures\//u, "") : "";
          const arxivFigFallback = cleanFigPath ? `https://arxiv.org/html/${cleanFigPath}` : (primaryFigure?.url || "");
          return (
            <div class={`web-triage-card ${pick.priority === "must_read" ? "web-triage-must" : "web-triage-worth"}`}>
              <div class="web-triage-main">
                <div class="web-triage-meta">
                  <span class={`pick-badge ${badge.class}`}>{badge.en}</span>
                  <a href={`#paper-${pick.arxiv_id}`} class="web-triage-id-jump" title="Jump to detailed review below">
                    arXiv:{pick.arxiv_id} ↓
                  </a>
                  {tags.slice(0, 3).map((tag: string) => (
                    <span class="pick-category-tag">{tag}</span>
                  ))}
                </div>
                <h4 class="web-triage-card-title">
                  <a href={`#paper-${pick.arxiv_id}`}>
                    <ReaderText text={pick.title} />
                  </a>
                </h4>
                {pick.core_insight && (
                  <p class="web-triage-insight">
                    <strong>Key Insight: </strong>
                    <ReaderText text={pick.core_insight} />
                  </p>
                )}
                <div class="web-triage-links">
                  <a href={`#paper-${pick.arxiv_id}`} class="triage-jump-pill">📖 Jump to Detail ↓</a>
                  <a href={`https://arxiv.org/abs/${pick.arxiv_id}`} target="_blank" rel="noopener noreferrer" class="triage-ext-pill">arXiv ↗</a>
                  <a href={`https://arxiv.org/pdf/${pick.arxiv_id}`} target="_blank" rel="noopener noreferrer" class="triage-ext-pill">PDF ↗</a>
                </div>
              </div>
              {primaryFigure && (
                <a href={`#paper-${pick.arxiv_id}`} class="web-triage-thumb" title="Jump to detailed review and figure">
                  <img
                    src={primaryFigure.url}
                    alt={primaryFigure.caption || `${pick.title} figure`}
                    loading="lazy"
                    onerror={`this.onerror=null;this.src='${arxivFigFallback}';`}
                  />
                  <span class="web-triage-fig-label">{primaryFigure.label || primaryFigureBadge || "Key Fig"}</span>
                </a>
              )}
            </div>
          );
        })}
      </div>
    </details>
  )}

  <!-- Pure CSS Topic, Priority & Order Mode Bar -->
  {totalCount > 0 && (
    <div class="weekly-filter-bar" role="tablist" aria-label="Filter and sort weekly picks">
      <span class="filter-bar-title">🗂️ Order:</span>
      <input type="radio" name="top-pick-order" id="order-theme" class="topic-radio" checked />
      <label for="order-theme" class="topic-filter-pill order-pill">By Theme (分专题)</label>
      <input type="radio" name="top-pick-order" id="order-default" class="topic-radio" />
      <label for="order-default" class="topic-filter-pill order-pill">Default Order (默认顺序)</label>

      <span class="filter-bar-divider" aria-hidden="true">|</span>

      <span class="filter-bar-title">🏷️ Filter:</span>
      <input type="radio" name="top-pick-filter" id="filter-all" class="topic-radio" checked />
      <label for="filter-all" class="topic-filter-pill">All ({totalCount})</label>

      {mustCount > 0 && (
        <>
          <input type="radio" name="top-pick-filter" id="filter-must" class="topic-radio" />
          <label for="filter-must" class="topic-filter-pill pill-must">⭐ Must Read ({mustCount})</label>
        </>
      )}

      {worthCount > 0 && (
        <>
          <input type="radio" name="top-pick-filter" id="filter-worth" class="topic-radio" />
          <label for="filter-worth" class="topic-filter-pill pill-worth">📌 Followed ({worthCount})</label>
        </>
      )}

      {activeTopicFilters.map((t) => (
        <>
          <input type="radio" name="top-pick-filter" id={`filter-${t.id.toLowerCase()}`} class="topic-radio" />
          <label for={`filter-${t.id.toLowerCase()}`} class="topic-filter-pill pill-topic">
            {t.short} ({t.count})
          </label>
        </>
      ))}
    </div>
  )}

  <div class="picks-list">
    {themeGroups.map((g) => (
      <div
        class="pick-theme-group-header"
        style={`--theme-order: ${g.headerOrder};`}
      >
        <div class="pick-theme-group-title-row">
          <span class="pick-theme-kicker">Theme 0{g.themeIndex}</span>
          <h3 class="pick-theme-title">{g.theme}</h3>
          <span class="pick-theme-count">{g.items.length} {g.items.length === 1 ? "paper" : "papers"}</span>
        </div>
        {g.description && (
          <p class="pick-theme-desc"><ReaderText text={g.description} linkArxivToAnchorPrefix="#paper-" /></p>
        )}
      </div>
    ))}
    {enrichedWithOrder && enrichedWithOrder.length > 0 ? (
      enrichedWithOrder.map(({ pick, paperObj, dailyDate, dailyItem, figures, primaryFigure, primaryFigureCore, primaryFigureBadge, modalId, badge, tags, transientIds, defaultOrder, themeOrder, themeName }) => {
        const cleanFigPath = typeof primaryFigure?.url === "string" ? primaryFigure.url.replace(/^\/arxiv-figures\//u, "") : "";
        const arxivFigFallback = cleanFigPath ? `https://arxiv.org/html/${cleanFigPath}` : (primaryFigure?.url || "");
        return (
          <article
            id={`paper-${pick.arxiv_id}`}
            class={`pick-card ${pick.priority === "must_read" ? "pick-card-must" : "pick-card-worth"} ${primaryFigure ? "pick-card-has-figure" : ""}`}
            data-priority={pick.priority}
            data-topics={tags.join(" ")}
            style={`--default-order: ${defaultOrder}; --theme-order: ${themeOrder};`}
          >
            <div class="pick-header">
              <div class="pick-header-badges">
                <span class={`pick-badge ${badge.class}`}>{badge.en}</span>
                {themeName && (
                  <span class="pick-theme-pill" title="Thematic Group">🧭 {themeName}</span>
                )}
                {transientIds.map((tid: string) => (
                  <span class="pick-transient-tag" title="Transient Target">🔭 {tid}</span>
                ))}
                {tags.map((tag: string) => (
                  <span class="pick-category-tag">{tag}</span>
                ))}
              </div>
              <div class="pick-action-links">
                <a class="pick-arxiv-id" href={`https://arxiv.org/abs/${pick.arxiv_id}`} target="_blank" rel="noopener noreferrer">
                  arXiv:{pick.arxiv_id} ↗
                </a>
                <a class="pick-pdf-link" href={`https://arxiv.org/pdf/${pick.arxiv_id}`} target="_blank" rel="noopener noreferrer" title="Direct official PDF">
                  📄 PDF ↗
                </a>
                <a class="pick-ads-link" href={getBibliographicUrl(pick.arxiv_id)} target="_blank" rel="noopener noreferrer" title={`View on ${getBibliographicSourceName()}`}>
                  {getBibliographicSourceName({ short: true })} ↗
                </a>
                {dailyItem ? (
                  <button
                    type="button"
                    class="pick-action-modal-btn"
                    popovertarget={modalId}
                    title="Quickly view deep reading and physical model"
                  >
                    🔬 Deep Reading ↗
                  </button>
                ) : null}
                {dailyDate ? (
                  <a class="pick-daily-link" href={`/arxiv-daily/${dailyDate}/#${radarCardAnchor(pick.arxiv_id, pick.revision || 1)}`} title="Jump to full daily archive">
                    📅 {dailyDate} Daily →
                  </a>
                ) : null}
              </div>
            </div>

            <div class={primaryFigure ? "pick-content-split" : "pick-content-single"}>
              <div class="pick-main-col">
                <h3 class="pick-title">
                  {dailyItem ? (
                    <button
                      type="button"
                      class="pick-title-btn"
                      popovertarget={modalId}
                      title="Click to read this paper"
                    >
                      <span class="pick-title-en"><ReaderText text={pick.title} /></span>
                    </button>
                  ) : dailyDate ? (
                    <a href={`/arxiv-daily/${dailyDate}/#${radarCardAnchor(pick.arxiv_id, pick.revision || 1)}`} class="pick-title-link" title="Click to read daily guide">
                      <span class="pick-title-en"><ReaderText text={pick.title} /></span>
                    </a>
                  ) : (
                    <span class="pick-title-plain">
                      <span class="pick-title-en"><ReaderText text={pick.title} /></span>
                    </span>
                  )}
                </h3>
                {resolveAuthors(pick.arxiv_id, pick).length > 0 ? (
                  <p class="pick-authors">Authors: {formatAuthorList(resolveAuthors(pick.arxiv_id, pick))}</p>
                ) : null}

                <div class="pick-details">
                  <div class="detail-row highlight-row">
                    <span class="detail-label">Key Insight:</span>
                    <span class="detail-text"><ReaderText text={pick.core_insight} /></span>
                  </div>
                  <div class="detail-row">
                    <span class="detail-label">Reason:</span>
                    <span class="detail-text"><ReaderText text={pick.recommendation_reason} /></span>
                  </div>
                  <div class="detail-row guide-row">
                    <span class="detail-label">Reading Guide:</span>
                    <span class="detail-text"><ReaderText text={pick.reading_guide} /></span>
                  </div>
                </div>
              </div>

              {primaryFigure && (
                <figure class="pick-inline-figure">
                  <div class="pick-figure-frame">
                    <a href={primaryFigure.url} target="_blank" rel="noopener noreferrer" class="pick-figure-link" title="Click to inspect full-resolution figure">
                      <img
                        src={primaryFigure.url}
                        alt={primaryFigure.caption || `${pick.title} key figure`}
                        loading="lazy"
                        onerror={`this.onerror=null;this.src='${arxivFigFallback}';if(this.parentElement&&this.parentElement.tagName==='A')this.parentElement.href='${arxivFigFallback}';`}
                      />
                    </a>
                    {figures.length > 1 && (
                      <span class="pick-figure-count-badge" title={`${figures.length} key figures in Deep Reading`}>
                        +{figures.length - 1} more
                      </span>
                    )}
                  </div>
                  <figcaption class="pick-figure-caption">
                    <div class="pick-figure-meta-row">
                      <span class={`pick-fig-badge pick-fig-${primaryFigure.category || "theoretical"}`}>
                        {primaryFigure.label ? `${primaryFigure.label} · ${primaryFigureBadge}` : primaryFigureBadge}
                      </span>
                    </div>
                    {primaryFigureCore && (
                      <p class="pick-figure-core">
                        <ReaderText text={primaryFigureCore} />
                      </p>
                    )}
                  </figcaption>
                </figure>
              )}
            </div>

            {dailyItem && (
              <div class="pick-deep-dive-bar">
                <button
                  type="button"
                  class="pick-open-modal-btn"
                  popovertarget={modalId}
                  aria-haspopup="dialog"
                >
                  <span class="btn-left">
                    <span class="btn-icon">🔬</span>
                    <span class="btn-title">Deep Reading & Evidence (assumptions / formulas / figures / citations)</span>
                  </span>
                  <span class="btn-right">
                    <span class="btn-arrow" aria-hidden="true">↗</span>
                  </span>
                </button>
              </div>
            )}

            <details class="paper-citation-details">
              <summary class="citation-summary">BibTeX & Citation</summary>
              <div class="citation-box">
                <div class="citation-short-row">
                  <span class="citation-label">Citation:</span>
                  <code class="citation-short">{formatCitation(paperObj || pick)}</code>
                </div>
                <pre class="citation-pre" tabindex="0" title="Click to copy">{formatBibtex(paperObj || pick)}</pre>
              </div>
            </details>

            {dailyItem && (
              <div
                class="radar-modal-dialog"
                id={modalId}
                popover="auto"
                role="dialog"
                aria-labelledby={`modal-title-${modalId}`}
              >
                <div class="radar-modal-container">
                  <header class="radar-modal-header">
                    <div class="modal-meta-row">
                      <div class="modal-badges">
                        <span class={`tier-pill priority-pill-${pick.priority === "must_read" ? "must-read" : "worth-knowing"}`}>
                          {badge.en}
                        </span>
                        <span class="radar-arxiv-badge">arXiv:{pick.arxiv_id}</span>
                        {dailyDate && <span class="radar-date-badge">📅 {formatAnnouncementInBeijing(dailyDate).beijingDate} Batch</span>}
                      </div>
                      <button
                        type="button"
                        class="radar-modal-close-btn"
                        popovertarget={modalId}
                        popovertargetaction="hide"
                        aria-label="Close dialog (ESC)"
                      >✕</button>
                    </div>
                    <h2 class="radar-modal-title" id={`modal-title-${modalId}`}>
                      <ReaderText text={pick.title} />
                    </h2>
                    {resolveAuthors(pick.arxiv_id, pick).length > 0 && (
                      <p class="radar-modal-authors">Authors: {formatAuthorList(resolveAuthors(pick.arxiv_id, pick))}</p>
                    )}
                  </header>

                  <div class="radar-modal-body">
                    <DailyRadarGuide item={dailyItem} visibleWorkLinks={{}} />
                    <DailyRadarSource item={dailyItem} />
                  </div>

                  <footer class="radar-modal-footer">
                    <div class="radar-modal-ext-links">
                      <a class="modal-ext-link" href={`https://arxiv.org/abs/${pick.arxiv_id}`} target="_blank" rel="noopener">arXiv Page ↗</a>
                      <a class="modal-ext-link" href={`https://arxiv.org/pdf/${pick.arxiv_id}`} target="_blank" rel="noopener">Official PDF ↗</a>
                      <a class="modal-ext-link" href={getBibliographicUrl(pick.arxiv_id)} target="_blank" rel="noopener">{getBibliographicSourceName({ short: true })} ↗</a>
                      {dailyDate && (
                        <a class="modal-ext-link modal-daily-link" href={`/arxiv-daily/${dailyDate}/#${radarCardAnchor(pick.arxiv_id, pick.revision || 1)}`}>
                          Go to {dailyDate} Daily Archive →
                        </a>
                      )}
                    </div>
                    <button
                      type="button"
                      class="radar-modal-btn-done"
                      popovertarget={modalId}
                      popovertargetaction="hide"
                    >
                      Done · Back to Weekly
                    </button>
                  </footer>
                </div>
              </div>
            )}
          </article>
        );
      })
    ) : (
      <div class="empty-picks-notice">
        <p class="empty-picks-title">No Must-Read Recommendations for Core Outbursts This Week</p>
        <p class="empty-picks-desc">All arXiv papers for this week were screened; no breakthrough directly advancing causal chains in R1–R7 research lines was identified. Other papers are archived in the catalog below.</p>
      </div>
    )}
  </div>
</section>

<style>
  .picks-section {
    margin: 2.5rem 0;
  }
  .section-heading {
    margin-bottom: 1.5rem;
  }
  .section-kicker {
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #2563eb;
    margin: 0 0 0.25rem 0;
    display: flex;
    gap: 0.5rem;
  }
  :global(:is([data-theme="dark"], body:has(#site-theme-toggle:checked))) .section-kicker {
    color: #60a5fa;
  }
  .language-english {
    color: #94a3b8;
    font-weight: 500;
  }
  /* Topic & Priority Filter Bar (Zero-Script Pure CSS) */
  .weekly-filter-bar {
    display: flex;
