---
import { loadCanonicalContent } from "../../../scripts/content-loader.mjs";
import { projectBaselineSnapshot } from "../../../scripts/reader-projection.mjs";
import { researchLineReaderPath } from "../../lib/reader-routes";
import { localizedLineQuestion, localizedLineTitle } from "../../lib/reader-localization";
import { loadSiteConfig } from "../../lib/site-config";
import SiteNav from "../../components/SiteNav.astro";
import "../../styles/global.css";

type AnyRecord = Record<string, any>;

const site = loadSiteConfig();
const snapshot = await loadCanonicalContent(new URL("../../../content/", import.meta.url));
const reader = projectBaselineSnapshot(snapshot) as Record<string, any>;
const researchLines = (reader.research_lines ?? []) as AnyRecord[];
const baselineWorks = (reader.works ?? []) as AnyRecord[];
const publishedCount = researchLines.filter((line) => line.reader_status === "published").length;
const candidateCount = researchLines.filter((line) => line.reader_status === "candidate").length;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content={`The visible Research Lines in ${site.title}.`}
    />
    <title>Research Lines · {site.title}</title>
  </head>
  <body>
    <main class="site-shell index-page">
      <SiteNav />
      <p class="eyebrow"><a href="/">{site.title}</a> · Research Lines</p>
      <h1>Research Lines</h1>
      <p class="layer-intro">{researchLines.length} research lines: {publishedCount} verified, {candidateCount} candidates</p>
      <p class="reader-note">Research lines organize {baselineWorks.length} foundational papers into cohesive inquiry directions.</p>
      {
        researchLines.length === 0 ? (
          <p class="empty-state">No research lines available.</p>
        ) : (
          <ol class="paper-index">
            {researchLines.map((line) => (
              <li class="paper-index-item">
                <article>
                  <h2>
                    <a class="paper-title" href={researchLineReaderPath(snapshot, line.line_id)}>
                      {line.title ?? line.line_id}
                    </a>
                  </h2>
                  <p><span class="tag">{line.reader_status === "candidate" ? "Candidate" : "Verified"}</span></p>
                  <p>{line.scientific_question}</p>
                  <p>
                    <a class="browse-link" href={researchLineReaderPath(snapshot, line.line_id)}>
                      Explore Research Line →
                    </a>
                  </p>
                </article>
              </li>
            ))}
          </ol>
        )
      }
    </main>
  </body>
</html>
