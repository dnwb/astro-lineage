  :global(.daily-radar-content-wrap:has(#filter-daily-multi:checked) .radar-list-item:not([data-tags*="MULTI"])) {
    display: none !important;
  }
  :global(.daily-radar-content-wrap:has(#filter-daily-multi:checked) #must-read:not(:has(.radar-list-item[data-tags*="MULTI"]))) {
