---
import { loadCanonicalContent } from "../../../scripts/content-loader.mjs";
import { projectBaselineSnapshot } from "../../../scripts/reader-projection.mjs";
import { learningPathReaderPath } from "../../lib/reader-routes";
import { localizedPathTitle } from "../../lib/reader-localization";
import { loadSiteConfig } from "../../lib/site-config";
import SiteNav from "../../components/SiteNav.astro";
import "../../styles/global.css";

type AnyRecord = Record<string, any>;

const site = loadSiteConfig();
const snapshot = await loadCanonicalContent(new URL("../../../content/", import.meta.url));
const reader = projectBaselineSnapshot(snapshot) as Record<string, any>;
const learningPaths = (reader.learning_paths ?? []) as AnyRecord[];
const publishedCount = learningPaths.filter((path) => path.reader_status === "published").length;
const candidateCount = learningPaths.filter((path) => path.reader_status === "candidate").length;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content={`The reviewed Learning Paths in ${site.title}.`}
    />
    <title>Learning Paths · {site.title}</title>
  </head>
  <body>
    <main class="site-shell index-page">
      <SiteNav />
      <p class="eyebrow"><a href="/">{site.title}</a> · Learning Paths</p>
      <h1>Learning Paths</h1>
      <p class="layer-intro">{learningPaths.length} learning paths: {publishedCount} verified, {candidateCount} candidates</p>
      <p class="reader-note">Learning paths organize structured reading sequences across foundational papers.</p>
      {
        learningPaths.length === 0 ? (
          <p class="empty-state">No learning paths available.</p>
        ) : (
          <ol class="paper-index">
            {learningPaths.map((path) => (
              <li class="paper-index-item">
                <article>
                  <h2>
                    <a class="paper-title" href={learningPathReaderPath(snapshot, path.path_id)}>
                      {path.title ?? path.path_id}
                    </a>
                  </h2>
                  <p><span class="tag">{path.reader_status === "candidate" ? "Candidate" : "Verified"}</span></p>
                  <p class="paper-meta">{path.entries?.length ?? 0} papers · {path.transitions?.length ?? 0} transitions</p>
                  <p><a class="browse-link" href={learningPathReaderPath(snapshot, path.path_id)}>Explore Learning Path →</a></p>
                </article>
              </li>
            ))}
          </ol>
        )
      }
    </main>
  </body>
</html>
