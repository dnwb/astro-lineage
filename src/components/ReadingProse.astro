---
import { parseReadingMarkdown } from "../../scripts/reader-markdown.mjs";
import { selectBilingualBlocks, type ReaderBlock } from "../lib/reader-localization";
import ReadingBlocks from "./ReadingBlocks.astro";

interface Props {
  source?: string;
  blocks?: ReaderBlock[];
  class?: string;
  localizationKey?: string;
  localizationSection?: string;
}

const {
  source = "",
  blocks: suppliedBlocks,
  class: className = "reading-prose",
} = Astro.props;
const blocks = selectBilingualBlocks(
  (suppliedBlocks ?? parseReadingMarkdown(source)) as ReaderBlock[],
  "english",
);
---

<div class={className}>
  <div class="reading-language" lang="en">
    <ReadingBlocks blocks={blocks} />
  </div>
</div>
