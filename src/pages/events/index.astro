  }
  :global(:is([data-theme="dark"], body:has(#site-theme-toggle:checked))) .station-badge {
    background: #0f172a;
    border-color: #334155;
  }
  :global(:is([data-theme="dark"], body:has(#site-theme-toggle:checked))) .station-bjt-date {
