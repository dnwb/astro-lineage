---
import dailyFeedFallback from "../../data/arxiv-daily.json";
import radarDataFallback from "../../data/daily-radar.json";
import { validateDailyRadarPayload } from "../../../scripts/daily-radar.mjs";
import { loadCanonicalContent } from "../../../scripts/content-loader.mjs";
import { projectVisibleSnapshot } from "../../../scripts/reader-projection.mjs";
import { readArxivRunState, readPublishedArxivEdition } from "../../../scripts/arxiv-daily.mjs";
import { workReaderPath } from "../../lib/reader-routes";
import SiteNav from "../../components/SiteNav.astro";
import DailyRadarBrief from "../../components/DailyRadarBrief.astro";
import DailyRadarPendingCard from "../../components/DailyRadarPendingCard.astro";
import DailyRadarPrioritySection from "../../components/DailyRadarPrioritySection.astro";
import DailyKnowledgePoint from "../../components/DailyKnowledgePoint.astro";
import archiveManifest from "../../data/arxiv-archives/manifest.json";
import { loadSiteConfig } from "../../lib/site-config";
import "../../styles/global.css";

type AnyRecord = Record<string, any>;

const site = loadSiteConfig();
const runtimeCwd = (globalThis as { process?: { cwd?: () => string } }).process?.cwd?.() ?? ".";
const projectPath = (...parts: string[]) => [runtimeCwd, ...parts].join("/");
const publishedEdition = await readPublishedArxivEdition({
  output: projectPath("src", "data", "arxiv-daily.json"),
  radarOutput: projectPath("src", "data", "daily-radar.json"),
  artifactRoot: projectPath(".cache", "arxiv-daily"),
  fallbackFeed: dailyFeedFallback,
  fallbackRadar: radarDataFallback,
} as any);
const dailyFeed = publishedEdition.feed;
const radarData = publishedEdition.radar;
const snapshot = await loadCanonicalContent(new URL("../../../content/", import.meta.url));
const visibleReader = projectVisibleSnapshot(snapshot) as AnyRecord;
function preferredVersion(work: AnyRecord) {
  const preferredVersionId = work.preferred_version_id ?? work.preferred_version?.version_id;
  return Array.isArray(work.versions)
    ? work.versions.find((version: AnyRecord) => version.id === preferredVersionId)
    : null;
}

const visibleWorkLinks = Object.fromEntries(
  (visibleReader.works ?? [])
    .map((work: AnyRecord): readonly [string, { href: string; title: string }] | null => {
      const version = preferredVersion(work);
      if (typeof work.work_id !== "string" || typeof version?.title !== "string" || version.title.trim() === "") return null;
      return [work.work_id, { href: workReaderPath(snapshot, work.work_id), title: version.title }] as const;
    })
    .filter((entry: readonly [string, { href: string; title: string }] | null): entry is readonly [string, { href: string; title: string }] => entry !== null),
);
const radarValidation = validateDailyRadarPayload(dailyFeed, radarData, { visibleWorkIds: Object.keys(visibleWorkLinks) });
if (radarValidation.fatalDiagnostics?.length > 0 || (!radarValidation.fatalDiagnostics && !radarValidation.valid)) {
  throw new Error(`Daily Radar payload is invalid: ${radarValidation.diagnostics.join(", ")}`);
}
const model = radarValidation.model;
const runState = await readArxivRunState();

const generatedAt = new Date(model.edition.generated_at ?? "");
const generatedLabel = Number.isNaN(generatedAt.valueOf())
  ? "尚未刷新"
  : generatedAt.toLocaleString("zh-CN", { timeZone: "Asia/Shanghai" });

function stateTime(value: string | undefined) {
  const date = new Date(value ?? "");
  return Number.isNaN(date.valueOf()) ? "时间未记录" : date.toLocaleString("zh-CN", { timeZone: "Asia/Shanghai" });
}

const runStateLabel = runState.read_error
  ? `运行状态不可读：${runState.read_error.message}`
  : runState.status === "running"
    ? "正在刷新，当前页面继续展示上一次缓存。"
    : runState.status === "success"
      ? `最近一次刷新成功于 ${stateTime(runState.last_success?.finished_at)}`
      : runState.status === "failed"
        ? `最近一次刷新失败于 ${stateTime(runState.last_failure?.finished_at)}：${runState.last_failure?.error?.message ?? "原因未记录"}${runState.last_failure?.output_published ? "；当前缓存已发布，本次状态收尾仍待修复。" : "；当前缓存保留上一次成功版本。"}`
        : "此环境尚未运行刷新，当前页面使用随站点发布的缓存。";

const englishRunStateLabel = runState.read_error
  ? `Run state unavailable: ${runState.read_error.message}`
  : runState.status === "running"
    ? "A refresh is running; this page continues to show the last cached edition."
    : runState.status === "success"
      ? `Last refresh succeeded at ${stateTime(runState.last_success?.finished_at)}`
      : runState.status === "failed"
        ? `Last refresh failed at ${stateTime(runState.last_failure?.finished_at)}: ${runState.last_failure?.error?.message ?? "reason not recorded"}${runState.last_failure?.output_published ? "; the new cache was published, but state finalization needs repair." : "; the previous successful cache remains active."}`
        : "This environment has not run a refresh; the page uses the cache shipped with the site.";

function pendingLabel(reason: string) {
  return {
    analysis_missing: "尚未分析",
    analysis_failed: "分析失败",
    analysis_invalid: "分析记录无效",
    analysis_pending: "分析尚未完成",
    source_changed: "来源已变化，旧导读失效",
    analysis_revision_mismatch: "版本不匹配，旧导读失效",
    coverage_insufficient_must_read: "全文分析不足，暂不推荐",
    coverage_insufficient_worth_knowing: "正文证据不足，暂不归入本组",
  }[reason] ?? "待核查";
}

const priorityGroups = model.groups as AnyRecord;
const isAnnouncementDay = ["announcement_day", "announcement_batch"].includes(model.edition.coverage_kind);
const announcementWindow = model.edition.window as AnyRecord | undefined;
const coverageLabel = isAnnouncementDay
  ? `公告批次窗口 ${announcementWindow?.announcement_date ?? "未记录"}（${announcementWindow?.time_zone ?? "America/New_York"}，截止 ${announcementWindow?.cutoff_local_time ?? "14:00"}）`
  : "最近提交样本";

const dailyArchiveModules = import.meta.glob<{ default: AnyRecord }>("../../data/arxiv-archives/daily/*.json", { eager: true });
const allDailyArchives = Object.values(dailyArchiveModules).map((mod) => (mod as any).default || mod);
const currentDate = announcementWindow?.announcement_date ?? "2026-09-16";

const currentWeekId = archiveManifest.latest_week_id ?? "2026-W39";

const pastDailyArchives = allDailyArchives
  .filter((item) => item.date !== currentDate)
  .sort((a, b) => b.date.localeCompare(a.date));

// Hierarchical separation: only fold current-week past editions in-page; prior weeks are archived standalone
const currentWeekPastArchives = pastDailyArchives.filter(
  (item) => (item.week_id ?? "") === currentWeekId
);

const currentWeekValidatedModels = currentWeekPastArchives.map((pastDay) => {
  const val = validateDailyRadarPayload(pastDay.feed, pastDay.radar, { visibleWorkIds: Object.keys(visibleWorkLinks) });
  return {
    dayInfo: pastDay,
    model: val.model,
    priorityGroups: val.model.groups as AnyRecord,
  };
});
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Daily Radar 首期缓存版：按阅读优先级整理的 arXiv 论文和有证据边界的科学导读。" />
    <title>Daily Radar · {site.title}</title>
  </head>
  <body>
    <main class="site-shell index-page reader-page radar-page">
      <SiteNav />
      <p class="eyebrow"><a href="/">{site.title}</a> · Daily Radar</p>
      <header class="reader-header">
        <h1><span class="language-primary">每日 arXiv 导读</span><span class="language-english" lang="en">Daily arXiv reading guide</span></h1>
        <p class="reader-deck language-primary">先决定今天读什么，再展开查看问题、假设、结果边界和实际阅读范围。</p>
        <p class="reader-deck language-english" lang="en">Choose what to read first, then open the guide for its problem, assumptions, limits, and actual reading coverage.</p>
        <p class="record-label language-primary">{coverageLabel} · 更新时间：{generatedLabel} · <a href="/arxiv-weekly/" style="color: #2563eb; font-weight: 500;">查看每周总结 →</a></p>
        <p class="record-label language-english" lang="en">{isAnnouncementDay ? `Announcement batch ending ${announcementWindow?.announcement_date ?? "unrecorded"} (${announcementWindow?.time_zone ?? "America/New_York"})` : "Recent-submission sample"} · refreshed {generatedLabel} · <a href="/arxiv-weekly/" style="color: #2563eb; font-weight: 500;">View Weekly Synthesis →</a></p>
      </header>

      <!-- Weekly Archive Navigator -->
      <nav class="archive-nav-card" aria-label="arXiv 历史归档导航">
        <div class="archive-nav-top">
          <div class="archive-nav-title-group">
            <span class="archive-nav-title"><span class="language-primary">🗓️ 历史日报归档 · 按周索引</span><span class="language-english" lang="en">Daily Archives (Grouped Weekly)</span></span>
            <span class="archive-nav-sub"><span class="language-primary">每日监测按周聚类，可查阅往期完整导读雷达：</span><span class="language-english" lang="en">Browse daily radar editions grouped by week:</span></span>
          </div>
          <a class="archive-jump-weekly-link" href="/arxiv-weekly/">
            <span class="language-primary">📖 查看本周学术脉络周报 →</span>
            <span class="language-english" lang="en">View Weekly Synthesis →</span>
          </a>
        </div>
        <div class="archive-nav-weeks">
          {archiveManifest.weeks.map((week) => (
            <div class="archive-week-row">
              <div class="archive-week-badge-wrap">
                <span class="archive-week-badge">{week.week_id}</span>
                <span class="archive-week-range">{week.date_range}</span>
              </div>
              <div class="archive-day-chips">
                {week.days.map((d) => (
                  d.date === currentDate ? (
                    <span class="archive-chip chip-active" id={`archive-${d.date}`} title="当前展示最新日报">
                      <span class="chip-status-tag">当前展示</span>
                      <strong class="chip-date">{d.date}</strong>
                      <span class="chip-meta">{d.weekday} · {d.total_papers}篇</span>
                    </span>
                  ) : week.week_id === currentWeekId ? (
                    <a class="archive-chip chip-link in-week-chip" id={`chip-${d.date}`} href={`#archive-${d.date}`} title="点击跳转并展开当周历史导读">
                      <span class="chip-past-tag">当周折叠</span>
                      <strong class="chip-date">{d.date}</strong>
                      <span class="chip-meta">{d.weekday} · {d.total_papers}篇 ↓</span>
                    </a>
                  ) : (
                    <a class="archive-chip chip-link standalone-chip" id={`chip-${d.date}`} href={`#archive-${d.date}`} title="点击跳转至该历史日期归档条目">
                      <span class="chip-past-tag">独立归档</span>
                      <strong class="chip-date">{d.date}</strong>
                      <span class="chip-meta">{d.weekday} · {d.total_papers}篇 ↓</span>
                    </a>
                  )
                ))}
              </div>
            </div>
          ))}
        </div>
      </nav>

      <DailyRadarBrief brief={model.opening_brief} visibleWorkLinks={visibleWorkLinks} groups={priorityGroups} />

      <DailyRadarPrioritySection
        id="must-read"
        items={priorityGroups.must_read}
        primaryLabel="今天先读"
        englishLabel="Must Read"
        visibleWorkLinks={visibleWorkLinks}
      />
      <DailyRadarPrioritySection
        id="worth-knowing"
        items={priorityGroups.worth_knowing}
        primaryLabel="值得知道"
        englishLabel="Worth Knowing"
        visibleWorkLinks={visibleWorkLinks}
      />

      <details class="radar-priority-section skip-section">
        <summary><span class="language-primary">快速浏览 · Skim（默认收起）</span><span class="language-english" lang="en">Skim (collapsed by default)</span></summary>
        <DailyRadarPrioritySection
          id="skim"
          items={priorityGroups.skip}
          primaryLabel="快速浏览"
          englishLabel="Skim"
          visibleWorkLinks={visibleWorkLinks}
        />
      </details>

      <section class="radar-section" id="knowledge-points">
        <p class="section-kicker"><span class="language-primary">学习补充</span><span class="language-english" lang="en">Learning supplement</span></p>
        <h2><span class="language-primary">今日知识点</span><span class="language-english" lang="en">Knowledge point</span></h2>
        {model.knowledge_points.length > 0 ? (
          model.knowledge_points.map((point) => (
            <>
              <div class="language-primary"><DailyKnowledgePoint point={point} /></div>
              <p class="language-english" lang="en">This knowledge point is written in Chinese and is bound to {point.source.source_version}. Open the original source: <a href={point.source_references[0].url}>arXiv source</a>.</p>
            </>
          ))
        ) : (
          <>
            <p class="empty-state language-primary">本期没有具备充分来源的知识点；不会用未核查材料填充。</p>
            <p class="empty-state language-english" lang="en">This edition has no knowledge point with sufficient source evidence; unverified material is not added.</p>
          </>
        )}
      </section>

      <details class="radar-status-disclosure">
        <summary><span class="language-primary">来源与运行状态（按需查看）</span><span class="language-english" lang="en">Sources and run status</span></summary>
        <div class="radar-status-body">
          <p class="language-primary">这是{isAnnouncementDay ? `公告批次 ${announcementWindow?.announcement_date ?? "日期未记录"}` : "现有 arXiv API 缓存中的最近提交样本"}，不是完整的当日新增集合。当前缓存包含 {model.counts.total} 篇，已形成有效导读 {model.counts.analyzed} 篇；其余条目保留在待核查状态。</p>
          <p class="language-english" lang="en">This is {isAnnouncementDay ? `the announcement batch ending ${announcementWindow?.announcement_date ?? "an unrecorded date"}` : "a recent-submission sample from the existing arXiv API cache"}, not a complete daily intake. The cache contains {model.counts.total} candidates; {model.counts.analyzed} have valid guides and the rest remain pending review.</p>
          <p class="record-label language-primary">运行状态：{runStateLabel}</p>
          <p class="record-label language-english" lang="en">Run state: {englishRunStateLabel}</p>
          <p class="record-label">Query: {model.edition.query ?? "未记录"}</p>
          <section class="radar-section" id="pending-analysis">
            <p class="section-kicker"><span class="language-primary">分析状态</span><span class="language-english" lang="en">Analysis status</span></p>
            <h2><span class="language-primary">待分析</span><span class="language-english" lang="en">Pending analysis</span></h2>
            <ol class="paper-index radar-list">
              {model.pending.map((item) => <DailyRadarPendingCard item={item} pendingLabel={pendingLabel(item.pending_reason)} />)}
            </ol>
          </section>
          {model.knowledge_points_pending.length > 0 ? (
            <>
              <p class="layer-intro language-primary">有 {model.knowledge_points_pending.length} 个知识点记录待核查。</p>
              <p class="layer-intro language-english" lang="en">{model.knowledge_points_pending.length} knowledge point record(s) remain pending review.</p>
            </>
          ) : null}
        </div>
      </details>

      <section class="radar-section archive-history-section" id="historical-archives">
        <p class="section-kicker"><span class="language-primary">往期归档</span><span class="language-english" lang="en">Past Editions</span></p>
        <h2><span class="language-primary">往期日报与历史归档</span><span class="language-english" lang="en">Historical Daily Guide Archives</span></h2>
        <p class="archive-history-intro"><span class="language-primary">按周分级归档：当周往期可就地展开查看；跨周历史批次沉淀为独立静态页面，保障轻快阅读体验：</span><span class="language-english" lang="en">Past editions are archived hierarchically: current-week editions fold in-place, while prior weeks are served as standalone pages.</span></p>

        {currentWeekValidatedModels.length > 0 && (
          <div class="current-week-history-wrap">
            <h3 class="history-subheading"><span class="language-primary">本周往期（就地折叠）</span><span class="language-english" lang="en">In-Week Editions</span></h3>
            <div class="archive-history-list">
              {currentWeekValidatedModels.map(({ dayInfo, model: pastModel, priorityGroups: pastGroups }) => (
                <details class="historical-edition-card" id={`archive-${dayInfo.date}`}>
                  <summary class="historical-edition-summary">
                    <div class="summary-left">
                      <span class="historical-date-tag">📅 {dayInfo.date}</span>
                      <span class="historical-weekday-tag">{dayInfo.weekday}</span>
                      <span class="historical-week-belong">所属周：{dayInfo.week_id}</span>
                    </div>
                    <div class="summary-right">
                      <span class="historical-stat-pill">总收录 {pastModel.counts.total} 篇</span>
                      <span class="historical-stat-pill">精读 {pastGroups.must_read?.length ?? 0}</span>
                      <span class="historical-stat-pill">了解 {pastGroups.worth_knowing?.length ?? 0}</span>
                      <span class="summary-toggle-prompt">展开导读 ▾</span>
                    </div>
                  </summary>
                  <div class="historical-edition-body">
                    <div class="historical-notice-bar">
                      <span>ℹ️ 正在查阅本周往期：<strong>{dayInfo.date}</strong>（{dayInfo.batch_id}）</span>
                      <div class="historical-notice-links">
                        <a href={`/arxiv-daily/${dayInfo.date}/`}>在新页面打开独立归档 ↗</a>
                        <a href="#opening-brief">↑ 返回最新日报（{currentDate}）</a>
                        <a href="/arxiv-weekly/">📖 查看所属周报综述（{dayInfo.week_id}）→</a>
                      </div>
                    </div>

                    <DailyRadarBrief brief={pastModel.opening_brief} visibleWorkLinks={visibleWorkLinks} groups={pastGroups} />

                    <DailyRadarPrioritySection
                      id={`must-read-${dayInfo.date}`}
                      items={pastGroups.must_read}
                      primaryLabel="今天先读"
                      englishLabel="Must Read"
                      visibleWorkLinks={visibleWorkLinks}
                    />
                    <DailyRadarPrioritySection
                      id={`worth-knowing-${dayInfo.date}`}
                      items={pastGroups.worth_knowing}
                      primaryLabel="值得知道"
                      englishLabel="Worth Knowing"
                      visibleWorkLinks={visibleWorkLinks}
                    />

                    {pastGroups.skip && pastGroups.skip.length > 0 && (
                      <details class="radar-priority-section skip-section">
                        <summary><span class="language-primary">快速浏览 · Skim（默认收起）</span><span class="language-english" lang="en">Skim (collapsed by default)</span></summary>
                        <DailyRadarPrioritySection
                          id={`skim-${dayInfo.date}`}
                          items={pastGroups.skip}
                          primaryLabel="快速浏览"
                          englishLabel="Skim"
                          visibleWorkLinks={visibleWorkLinks}
                        />
                      </details>
                    )}

                    <details class="radar-status-disclosure">
                      <summary><span class="language-primary">该历史批次来源与待分析（点击展开）</span><span class="language-english" lang="en">Historical Sources & Pending</span></summary>
                      <div class="radar-status-body">
                        <p>公告批次：{dayInfo.batch_id} · 生成于：{dayInfo.generated_at}</p>
                        <p>收录候选：{pastModel.counts.total} 篇，有效研判：{pastModel.counts.analyzed} 篇，待分析：{pastModel.pending?.length ?? 0} 篇。</p>
                        <ol class="paper-index radar-list">
                          {pastModel.pending.slice(0, 10).map((item: any) => (
                            <DailyRadarPendingCard item={item} pendingLabel={pendingLabel(item.pending_reason)} />
                          ))}
                        </ol>
                      </div>
                    </details>
                  </div>
                </details>
              ))}
            </div>
          </div>
        )}

        {archiveManifest.weeks.filter((w) => w.week_id !== currentWeekId).length > 0 && (
          <div class="prior-weeks-history-wrap">
            <h3 class="history-subheading"><span class="language-primary">跨周历史归档（已沉淀为独立静态页面）</span><span class="language-english" lang="en">Standalone Archive Directory</span></h3>
            <div class="past-weeks-directory-grid">
              {archiveManifest.weeks.filter((w) => w.week_id !== currentWeekId).map((w) => (
                <div class="past-week-card">
                  <div class="past-week-card-header">
                    <div class="past-week-title-wrap">
                      <span class="past-week-badge">{w.week_id}</span>
                      <strong class="past-week-range">{w.date_range}</strong>
                    </div>
                    <a class="past-week-link" href="/arxiv-weekly/">查看本周学术脉络周报 →</a>
                  </div>
                  {w.executive_summary && (
                    <p class="past-week-summary-snip">{w.executive_summary.slice(0, 110)}...</p>
                  )}
                  <div class="past-week-days-list">
                    {w.days.map((d) => (
                      <a class="past-day-entry-row" href={`/arxiv-daily/${d.date}/`} id={`archive-${d.date}`}>
                        <div class="entry-left">
                          <span class="entry-date">📅 {d.date}</span>
                          <span class="entry-weekday">({d.weekday})</span>
                          <span class="entry-batch">{d.batch_id}</span>
                        </div>
                        <div class="entry-stats">
                          <span class="stat-tag total">{d.total_papers} 篇</span>
                          {d.must_read_count > 0 && <span class="stat-tag must">精读 {d.must_read_count}</span>}
                          {d.worth_knowing_count > 0 && <span class="stat-tag worth">了解 {d.worth_knowing_count}</span>}
                          <span class="entry-arrow">阅读独立导读 ↗</span>
                        </div>
                      </a>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}
      </section>
    </main>
  </body>
</html>
