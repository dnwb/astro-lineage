---
import archiveManifest from "../../data/arxiv-archives/manifest.json";
import SiteNav from "../../components/SiteNav.astro";
import ReaderText from "../../components/ReaderText.astro";
import WeeklyDomainMatrix from "../../components/weekly/WeeklyDomainMatrix.astro";
import WeeklyDailyTable from "../../components/weekly/WeeklyDailyTable.astro";
import WeeklyTopPicks from "../../components/weekly/WeeklyTopPicks.astro";
import WeeklyWeekSwitcher from "../../components/weekly/WeeklyWeekSwitcher.astro";
import WeeklyExecutiveSummary from "../../components/weekly/WeeklyExecutiveSummary.astro";
import { loadSiteConfig } from "../../lib/site-config";
import { radarCardAnchor } from "../../../scripts/daily-radar.mjs";
import {
  parseStructuredExecutiveSummary,
  formatWeekIdZh,
  formatWeekIdEn,
  getBibliographicUrl,
  getBibliographicSourceName,
} from "../../domain/academic-domain.mjs";
import { isLegacyChineseDate } from "../../domain/language-cutover.mjs";
import "../../styles/global.css";
import "../../styles/weekly.css";

type AnyRecord = Record<string, any>;

export async function getStaticPaths() {
  const weeklyArchiveModules = import.meta.glob<{ default: AnyRecord }>(
    "../../data/arxiv-archives/weekly/*.json",
    { eager: true }
  );

  const allWeeks = Object.values(weeklyArchiveModules)
    .map((mod) => (mod as any).default || mod)
    .sort((a, b) => b.week_id.localeCompare(a.week_id));

  return allWeeks.map((weeklyData, index) => {
    const newerWeek = index > 0 ? allWeeks[index - 1] : null;
    const olderWeek = index < allWeeks.length - 1 ? allWeeks[index + 1] : null;
    return {
      params: { week: weeklyData.week_id },
      props: {
        weeklyData,
        newerWeekId: newerWeek ? newerWeek.week_id : null,
        olderWeekId: olderWeek ? olderWeek.week_id : null,
      },
    };
  });
}

const { weeklyData, newerWeekId, olderWeekId } = Astro.props as {
  weeklyData: AnyRecord;
  newerWeekId: string | null;
  olderWeekId: string | null;
};

const site = loadSiteConfig();

const currentWeekManifest = (archiveManifest.weeks as any[]).find((w: any) => w.week_id === weeklyData.week_id) || {
  week_id: weeklyData.week_id,
  date_range: weeklyData.date_range,
  days: [],
};
const weekDays = currentWeekManifest?.days || [];

const stats = weeklyData.statistics ?? {
  total_analyzed: weeklyData.papers?.length ?? 0,
  must_read_count: weeklyData.top_picks?.filter((p: any) => p.priority === "must_read").length ?? 0,
  worth_knowing_count: weeklyData.top_picks?.filter((p: any) => p.priority === "worth_knowing").length ?? 0,
  skip_count: 0,
};

const structuredExecutive = parseStructuredExecutiveSummary(weeklyData.executive_summary);

const generatedAt = new Date(weeklyData.generated_at ?? "");
const generatedLabel = Number.isNaN(generatedAt.valueOf())
  ? "Historical Archive"
  : generatedAt.toISOString().slice(0, 16).replace("T", " ") + " UTC";

const priorityLabels: Record<string, { zh: string; en: string; class: string }> = {
  must_read: { zh: "Must Read", en: "Must Read", class: "badge-must-read" },
  worth_knowing: { zh: "Followed", en: "Followed", class: "badge-worth-knowing" },
  skip: { zh: "Skim", en: "Skim", class: "badge-skip" },
};

const paperMap = new Map<string, any>((weeklyData.papers ?? []).map((p: any) => [p.arxiv_id, p]));

const dailyArchiveModules = import.meta.glob<{ default: any }>("../../data/arxiv-archives/daily/*.json", { eager: true });
const authorMap = new Map<string, string[]>();
const dailyAnalysisMap = new Map<string, any>();
const paperDailyDateMap = new Map<string, string>();
const dailyItemMap = new Map<string, any>();

for (const mod of Object.values(dailyArchiveModules)) {
  const data = (mod as any).default || mod;
  const date = data.date;
  const feedEntries = data.feed?.entries ?? [];
  const analyses = data.radar?.analyses ?? [];
  const aMap = new Map(analyses.map((a: any) => [a.arxiv_id, a]));
  for (const entry of feedEntries) {
    if (entry.arxiv_id) {
      if (Array.isArray(entry.authors) && entry.authors.length > 0) {
        authorMap.set(entry.arxiv_id, entry.authors);
      }
      if (date) paperDailyDateMap.set(entry.arxiv_id, date);
      const a = aMap.get(entry.arxiv_id);
      if (a) {
        dailyItemMap.set(entry.arxiv_id, {
          ...entry,
          analysis: a,
          dailyDate: date,
        });
      }
    }
  }
  for (const a of analyses) {
    if (a.arxiv_id) {
      dailyAnalysisMap.set(a.arxiv_id, a);
      if (date && !paperDailyDateMap.has(a.arxiv_id)) {
        paperDailyDateMap.set(a.arxiv_id, date);
      }
    }
  }
}

const matrixRows = (Array.isArray(weeklyData.overview_matrix) && weeklyData.overview_matrix.length > 0)
  ? weeklyData.overview_matrix
  : (weeklyData.thematic_highlights ?? []).map((t: any) => ({
      domain: t.theme_name,
      key_question: "Frontier physical mechanisms, model hypotheses, and observational signatures",
      core_findings: t.summary,
      representative_papers: t.paper_ids || [],
    }));

function resolveAuthors(id: string, direct?: any): string[] {
  if (Array.isArray(direct?.authors) && direct.authors.length > 0) return direct.authors;
  const inMap = paperMap.get(id) as any;
  if (Array.isArray(inMap?.authors) && inMap.authors.length > 0) return inMap.authors;
  return authorMap.get(id) || [];
}

const weekLabelZh = formatWeekIdEn(weeklyData.week_id);
const weekLabelEn = formatWeekIdEn(weeklyData.week_id);

const latestWeekId = (archiveManifest as any).latest_week_id || (archiveManifest.weeks as any[])[0]?.week_id;
const isInProgress = weekDays.length < 5;

// Find the most recent complete week before the current week
const currentWeekIndex = (archiveManifest.weeks as any[]).findIndex(
  (w: any) => w.week_id === weeklyData.week_id
);
const lastCompleteWeek = (archiveManifest.weeks as any[])
  .slice(currentWeekIndex >= 0 ? currentWeekIndex + 1 : 0)
  .find((w: any) => (w.days?.length ?? 0) >= 5);
const lastCompleteWeekId = lastCompleteWeek?.week_id;
const lastCompleteWeekLabel = lastCompleteWeekId ? formatWeekIdEn(lastCompleteWeekId) : "";
const lastCompleteWeekUrl = lastCompleteWeekId
  ? (lastCompleteWeekId === latestWeekId ? "/arxiv-weekly/" : `/arxiv-weekly/${lastCompleteWeekId}/`)
  : "";

const exportMarkdown = `# High-Energy Astrophysics arXiv Weekly Synthesis · ${weekLabelEn}
Period: ${weekLabelEn} | Date Span: ${weeklyData.date_range}
Generated: ${generatedLabel}

## Weekly Executive Summary
${weeklyData.executive_summary}

## Thematic Highlights & Developments
${(weeklyData.thematic_highlights ?? []).map((t: any, i: number) => `### Topic 0${i + 1}: ${t.theme_name}
${t.summary}

Related Papers: ${(t.paper_ids ?? []).map((id: string) => `arXiv:${id}`).join(", ")}`).join("\n\n")}

## Weekly Top Picks
${(weeklyData.top_picks ?? []).map((p: any) => `### [${p.priority === "must_read" ? "Must Read" : "Follow"}] arXiv:${p.arxiv_id} - ${p.title}
- **Recommendation**: ${p.recommendation_reason}
- **Key Insight**: ${p.core_insight}
- **Reading Guide**: ${p.reading_guide}
- **Links**: https://arxiv.org/abs/${p.arxiv_id} | ${getBibliographicUrl(p.arxiv_id)}`).join("\n\n")}`.trim();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Weekly Synthesis · {weekLabelEn} | {site.title}</title>
    <meta
      name="description"
      content={`Weekly synthesis of high-energy astrophysics arXiv papers: ${weekLabelEn} (${weeklyData.date_range}).`}
    />
  </head>
  <body>
    <main class="site-shell weekly-page">
      <SiteNav />

      <header class="page-header weekly-header">
        <p class="eyebrow"><a href="/">{site.title}</a> · <a href="/arxiv-daily/">arXiv Radar</a> · <a href="/arxiv-weekly/">Weekly Synthesis</a> · {weekLabelEn}</p>
        <h1 class="page-title">Weekly Synthesis · {weekLabelEn}</h1>
        {isLegacyChineseDate(weeklyData.week_id) && (
          <div class="legacy-archive-banner" role="note">
            <span class="legacy-badge">Legacy Archive</span>
            <span>This edition was generated prior to the English transition ({weeklyData.week_id}) and contains historical Chinese text.</span>
          </div>
        )}

        <div class="weekly-meta-bar">
          <span class="meta-item">📅 Period: {weeklyData.week_id}</span>
          <span class="meta-sep">·</span>
          <span class="meta-item">⏱ Span: {weeklyData.date_range}</span>
          <span class="meta-sep">·</span>
          <span class="meta-item">📊 Analyzed: <strong>{stats.total_analyzed}</strong></span>
          <span class="meta-sep">·</span>
          <span class="meta-item highlight-must">Must Read: <strong>{stats.must_read_count}</strong></span>
          <span class="meta-sep">·</span>
          <span class="meta-item highlight-worth">Followed: <strong>{stats.worth_knowing_count}</strong></span>
          {isInProgress ? (
            <>
              <span class="meta-sep">·</span>
              <span class="meta-item in-progress-badge">⏱️ In Progress ({weekDays.length}/5)</span>
              {lastCompleteWeekId && (
                <span class="meta-item in-progress-link">
                  <a href={lastCompleteWeekUrl}>Latest Complete ({lastCompleteWeekId}) →</a>
                </span>
              )}
            </>
          ) : null}
          <div class="meta-tools-wrap">
            <a class="meta-jump-btn" href="#audit-and-index" title="Jump to Index">
              <span>📑 Index ↓</span>
            </a>
            <details class="weekly-tools-details">
              <summary class="tools-summary-btn">
                <span>⚙️ Tools</span>
                <span class="tools-caret">▾</span>
              </summary>
              <div class="tools-dropdown-body">
                <a
                  class="meta-link pdf-download-link"
                  href={`/arxiv-weekly/${weeklyData.week_id}/weekly-${weeklyData.week_id}.pdf`}
                  download={`weekly-${weeklyData.week_id}.pdf`}
                  title="Download PDF"
                >
                  📥 Download PDF
                </a>
                <details class="weekly-markdown-export">
                  <summary class="export-summary-btn">
                    Export Weekly Markdown
                  </summary>
                  <div class="export-body">
                    <pre class="export-markdown-pre" tabindex="0" title="Click to copy">{exportMarkdown}</pre>
                  </div>
                </details>
              </div>
            </details>
          </div>
        </div>
      </header>

      <!-- Weekly Navigation Bar -->
      <WeeklyWeekSwitcher currentWeek={weeklyData.week_id} />

      <!-- 1. Executive Summary -->
      <WeeklyExecutiveSummary
        structuredExecutive={structuredExecutive}
        rawSummary={weeklyData.executive_summary}
      />

      <!-- 2. Top Picks -->
      <WeeklyTopPicks
        topPicks={weeklyData.top_picks}
        paperMap={paperMap}
        paperDailyDateMap={paperDailyDateMap}
        authorMap={authorMap}
        dailyItemMap={dailyItemMap}
        dailyAnalysisMap={dailyAnalysisMap}
        weekId={weeklyData.week_id}
      />

      <!-- 3. Thematic Highlights -->
      {weeklyData.thematic_highlights && weeklyData.thematic_highlights.length > 0 && (
        <section class="weekly-section thematic-section" id="thematic-highlights">
          <div class="section-heading">
            <p class="section-kicker">Focus Themes</p>
            <h2>Thematic Highlights</h2>
          </div>
          <div class="thematic-grid">
            {weeklyData.thematic_highlights?.map((theme: any, idx: number) => (
              <article class="thematic-card">
                <div class="thematic-header">
                  <span class="theme-index">Theme 0{idx + 1}</span>
                  <h3>{theme.theme_name}</h3>
                </div>
                <div class="thematic-body">
                  <ReaderText text={theme.summary} />
                </div>
                {theme.paper_ids && theme.paper_ids.length > 0 ? (
                  <div class="thematic-papers">
                    <span class="thematic-papers-label">Key Papers:</span>
                    <div class="paper-tag-list">
                      {theme.paper_ids.map((id: string) => {
                        const dailyDate = paperDailyDateMap.get(id);
                        return (
                          <span class="thematic-paper-entry">
                            <a class="paper-tag" href={`https://arxiv.org/abs/${id}`} target="_blank" rel="noopener noreferrer">
                              arXiv:{id}
                            </a>
                            {dailyDate && (
                              <a class="paper-daily-link" href={`/arxiv-daily/${dailyDate}/#${radarCardAnchor(id, 1)}`} title={`Go to ${dailyDate} daily brief for reading notes and model hypotheses`}>
                                📅 {dailyDate} →
                              </a>
                            )}
                          </span>
                        );
                      })}
                    </div>
                  </div>
                ) : null}
              </article>
            ))}
          </div>
        </section>
      )}

      <!-- 4. Collapsed Audit & Index Section -->
      <section class="weekly-section audit-section" id="audit-and-index">
        <details class="audit-details">
          <summary class="audit-summary-btn">
            Index & Audit Archive (Domain Matrix · Daily Index · Full Catalog, click to expand)
          </summary>
          <div class="audit-body">
            <!-- Domain Matrix -->
            <section class="weekly-section matrix-section" id="domain-matrix">
              <WeeklyDomainMatrix matrixRows={matrixRows} paperDailyDateMap={paperDailyDateMap} />
            </section>

            <!-- Daily Breakdown Table in this Week -->
            <WeeklyDailyTable weekDays={weekDays} latestDailyDate={archiveManifest.latest_daily_date} />

            <!-- Full Catalog -->
            <section class="weekly-section catalog-section" id="catalog">
              <details class="catalog-details">
                <summary>
                  Complete Weekly Paper Catalog ({weeklyData.papers?.length ?? 0} papers, click to expand)
                </summary>
                <div class="catalog-list">
                  {weeklyData.papers?.map((p: any) => {
                    const badge = priorityLabels[p.priority] ?? priorityLabels.skip;
                    const dailyRecord = dailyAnalysisMap.get(p.arxiv_id);
                    const guide = dailyRecord?.analysis?.analysis || dailyRecord?.analysis || {};
                    const result = p.result || guide.result || "";
                    const problem = p.problem || guide.problem || "";
                    const method = p.method || guide.method || "";
                    const announcementDate = p.announcement_date || dailyRecord?.historical_edition?.replace(/^announcement-/, "") || paperDailyDateMap.get(p.arxiv_id);
                    const paperTargetUrl = announcementDate ? `/arxiv-daily/${announcementDate}/#${radarCardAnchor(p.arxiv_id, p.revision || 1)}` : (p.url || `https://arxiv.org/abs/${p.arxiv_id}`);
                    return (
                      <div class="catalog-item">
                        <div class="catalog-item-header">
                          <span class={`catalog-badge ${badge.class}`}>{badge.en}</span>
                          <a class="catalog-arxiv-link" href={p.url || `https://arxiv.org/abs/${p.arxiv_id}v${p.revision || 1}`} target="_blank" rel="noopener noreferrer">
                            arXiv:{p.arxiv_id}v{p.revision || 1}
                          </a>
                          <a class="catalog-ads-link" href={getBibliographicUrl(p.arxiv_id)} target="_blank" rel="noopener noreferrer" title={`View on ${getBibliographicSourceName()}`}>
                            {getBibliographicSourceName({ short: true })} ↗
                          </a>
                          <h4 class="catalog-item-title">
                            <a href={paperTargetUrl} class="catalog-paper-title-link" title="Click to view daily guide">
                              {p.title}
                            </a>
                          </h4>
                        </div>
                        {resolveAuthors(p.arxiv_id, p).length > 0 && (
                          <p class="catalog-item-authors">Authors: {resolveAuthors(p.arxiv_id, p).join(", ")}</p>
                        )}
                        {problem && (
                          <p class="catalog-item-problem"><strong>Problem: </strong><ReaderText text={problem} /></p>
                        )}
                        {result && (
                          <p class="catalog-item-result"><strong>Result: </strong><ReaderText text={result} /></p>
                        )}
                        {method && (
                          <p class="catalog-item-method"><strong>Method: </strong><ReaderText text={method} /></p>
                        )}
                        {announcementDate && (
                          <p class="catalog-item-jump">
                            <a href={`/arxiv-daily/${announcementDate}/#card-${p.arxiv_id}-v${p.revision || 1}`}>
                              📖 View daily reading card & evidence →
                            </a>
                          </p>
                        )}
                      </div>
                    );
                  })}
                </div>
              </details>
            </section>
          </div>
        </details>
      </section>
    </main>
  </body>
</html>
