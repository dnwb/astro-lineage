---
import ProductBoundary from "../copy/product-boundary.md";
import { firstCompleteReadingItem, parseReadingDocument, whyThisWorkMatters } from "../../scripts/reader-markdown.mjs";
import { loadCanonicalContent } from "../../scripts/content-loader.mjs";
import { projectBaselineSnapshot, projectVisibleSnapshot } from "../../scripts/reader-projection.mjs";
import { learningPathReaderPath, researchLineReaderPath, workReaderPath } from "../lib/reader-routes";
import {
  localizedEdgeReason,
  localizedLineTitle,
  localizedBlocks,
  localizedPathTitle,
  localizedWorkTitle,
  selectBilingualBlocks,
} from "../lib/reader-localization";
import { loadSiteConfig } from "../lib/site-config";
import SiteNav from "../components/SiteNav.astro";
import ReaderText from "../components/ReaderText.astro";
import weeklyData from "../data/arxiv-weekly.json";
import dailyRadar from "../data/daily-radar.json";
import dailyFeed from "../data/arxiv-daily.json";
import archiveManifest from "../data/arxiv-archives/manifest.json";
import "../styles/global.css";

type AnyRecord = Record<string, any>;

const site = loadSiteConfig();
const snapshot = await loadCanonicalContent("content");
const visibleReader = projectVisibleSnapshot(snapshot) as Record<string, any>;
const baselineReader = projectBaselineSnapshot(snapshot) as Record<string, any>;
const learningPaths = (visibleReader.learning_paths ?? []) as AnyRecord[];
const scientificEdges = (visibleReader.scientific_edges ?? []) as AnyRecord[];
const baselineWorks = (baselineReader.works ?? []) as AnyRecord[];
const baselineLines = (baselineReader.research_lines ?? []) as AnyRecord[];
const baselinePaths = (baselineReader.learning_paths ?? []) as AnyRecord[];
const workById = new Map(baselineWorks.map((work) => [work.work_id, work]));
const startPath = learningPaths[0] ?? null;

// Intelligence Dashboard Data Preparation
const weeklyStats = (weeklyData as any).statistics ?? {
  total_analyzed: (weeklyData as any).papers?.length ?? 0,
  must_read_count: (weeklyData as any).top_picks?.filter((p: any) => p.priority === "must_read").length ?? 0,
  worth_knowing_count: (weeklyData as any).top_picks?.filter((p: any) => p.priority === "worth_knowing").length ?? 0,
  skip_count: 0,
};
const weeklyLeadSummary = (weeklyData as any).executive_summary
  ? (weeklyData as any).executive_summary.split("\n\n")[0]
  : "聚合高能天体物理最新因果动力学与观测前沿。";
const weeklyTopPicks = (weeklyData as any).top_picks ?? [];

const dailyEntries = (dailyFeed as any).entries ?? [];
const feedMap = new Map(dailyEntries.map((entry: any) => [entry.arxiv_id, entry]));
const radarAnalyses = (dailyRadar as any).analyses ?? [];
const dailyMustReads = radarAnalyses
  .filter((a: any) => a.priority === "must_read")
  .map((a: any) => ({
    ...a,
    entry: feedMap.get(a.arxiv_id) ?? null,
  }));
const dailyWorthKnowing = radarAnalyses.filter((a: any) => a.priority === "worth_knowing");
const dailySkip = radarAnalyses.filter((a: any) => a.priority === "skip");

const dailyStats = {
  total_papers: dailyEntries.length || radarAnalyses.length,
  must_read_count: dailyMustReads.length,
  worth_knowing_count: dailyWorthKnowing.length,
  skip_count: dailySkip.length,
};

const latestDate = (dailyFeed as any).window?.announcement_date ?? "2026-09-21";
const radarWeekday = (dailyFeed as any).window?.announcement_weekday ?? "Mon";
const radarBatchLabel = `${radarWeekday} 监测批次 · ${(dailyFeed as any).window?.cutoff_local_time ?? "14:00"} Cutoff`;

const relationLabels: Record<string, string> = {
  builds_on: "建立在其上",
  extends: "扩展",
  tests: "检验",
  constrains: "约束",
  challenges: "挑战",
  replaces_assumption: "替代假设",
  corrects: "修正",
};

function preferred(work: AnyRecord) {
  const version = work.versions?.find((candidate: AnyRecord) => candidate.id === work.preferred_version_id);
  if (!version) throw new Error(`Missing preferred Version for ${work.work_id}.`);
  return version;
}

function authors(work: AnyRecord, abbreviated = false) {
  const names = (preferred(work).authors ?? [])
    .map((author: AnyRecord) => author.display_name)
    .filter(Boolean);
  if (abbreviated && names.length > 2) return `${names[0]} et al.`;
  return names.join(", ");
}

function releaseYear(work: AnyRecord) {
  const value = preferred(work).release_date?.value;
  if (typeof value !== "string" || !/^\d{4}/u.test(value)) {
    throw new Error(`Missing preferred Version release year for ${work.work_id}.`);
  }
  return value.slice(0, 4);
}

function whyRead(work: AnyRecord) {
  const document = parseReadingDocument(String(work.reading ?? ""));
  return firstCompleteReadingItem(
    selectBilingualBlocks(
      localizedBlocks(work.work_id, "why", whyThisWorkMatters(document, work.work_id)),
      "primary",
    ),
    work.work_id,
  );
}

function originalWhyRead(work: AnyRecord) {
  const document = parseReadingDocument(String(work.reading ?? ""));
  return firstCompleteReadingItem(
    selectBilingualBlocks(whyThisWorkMatters(document, work.work_id), "english"),
    work.work_id,
  );
}

function projectedWork(workId: string) {
  const work = workById.get(workId);
  if (!work) throw new Error(`Scientific Edge endpoint is not visible: ${workId}.`);
  return work;
}

function edgeLabel(edge: AnyRecord) {
  const label = relationLabels[edge.relation];
  if (!label) throw new Error(`Unknown Scientific Edge relation: ${edge.relation}.`);
  return label;
}
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="A curated scientific reading map for high-energy transient astrophysics."
    />
    <title>{site.title}</title>
  </head>
  <body>
    <main class="site-shell home-page">
      <SiteNav />

      <header class="home-header" aria-labelledby="home-title">
        <p class="eyebrow">{site.eyebrow}</p>
        <h1 id="home-title">{site.title}</h1>
        <p class="home-lead language-primary">理解高能瞬变天体物理中的思想如何演化。</p>
        <p class="language-primary">围绕论文、物理关系与学习路径构建的科学阅读地图。</p>
        <div class="language-english" lang="en">
          <p class="home-lead">Understand how ideas in high-energy astrophysics evolve.</p>
          <p>A curated scientific reading map built around papers, their physical relationships, and learning paths.</p>
        </div>
        <ProductBoundary />
      </header>

      <!-- Primary Feature Section: Weekly Synthesis & Daily Radar -->
      <section class="intelligence-hero-section" aria-labelledby="intelligence-hero-heading">
        <div class="intelligence-hero-header">
          <div class="hero-badge-row">
            <span class="pulse-indicator"><span class="pulse-dot"></span> 实时前沿学术情报</span>
            <span class="hero-tag">AI 驱动 · 高能瞬变天体物理</span>
            <span class="hero-tag-muted">宁缺毋滥 · 严格因果动力学</span>
          </div>
          <h2 id="intelligence-hero-heading" class="intelligence-title">
            <span class="intelligence-title-main">前沿学术监测与周度研判</span>
            <span class="intelligence-title-sub">Frontier arXiv Intelligence & Weekly Synthesis</span>
          </h2>
          <p class="intelligence-desc">
            聚焦超新星、相对论喷流、磁星、FRB 及多信使高能瞬变现象。每日执行基于 R1～R7 核心主线的因果研判，每周提炼宏观科学脉络与重点精选。
          </p>
        </div>

        <div class="intelligence-grid">
          <!-- Card 1: 本周学术脉络周报 (Weekly Synthesis) -->
          <article class="intel-card intel-card-weekly">
            <div class="intel-card-top">
              <div class="intel-badge-group">
                <span class="intel-badge intel-badge-weekly">本周综述 · {(weeklyData as any).week_id}</span>
                <span class="intel-date">{(weeklyData as any).date_range}</span>
              </div>
              <a class="intel-view-all-link" href="/arxiv-weekly/">查看完整周报 →</a>
            </div>

            <h3 class="intel-card-title">
              <a href="/arxiv-weekly/">{(weeklyData as any).title || "高能天体物理 arXiv 每周学术脉络与前沿精选"}</a>
            </h3>

            <div class="intel-metrics-strip">
              <div class="intel-metric-item">
                <span class="intel-metric-val">{weeklyStats.total_analyzed}</span>
                <span class="intel-metric-lbl">已研判论文</span>
              </div>
              <div class="intel-metric-item highlight-must-read">
                <span class="intel-metric-val">{weeklyStats.must_read_count}</span>
                <span class="intel-metric-lbl">重点精读</span>
              </div>
              <div class="intel-metric-item highlight-worth-knowing">
                <span class="intel-metric-val">{weeklyStats.worth_knowing_count}</span>
                <span class="intel-metric-lbl">值得关注</span>
              </div>
              <div class="intel-metric-item">
                <span class="intel-metric-val">{(weeklyData as any).thematic_highlights?.length ?? 0}</span>
                <span class="intel-metric-lbl">前沿专题</span>
              </div>
            </div>

            <div class="intel-summary-box">
              <p class="intel-summary-label">宏观学术脉络导读：</p>
              <p class="intel-summary-text">
                <ReaderText text={weeklyLeadSummary} />
              </p>
            </div>

            {weeklyTopPicks.length > 0 && (
              <div class="intel-picks-box">
                <p class="intel-picks-label">本周精选 Top Picks 候选：</p>
                <ul class="intel-picks-list">
                  {weeklyTopPicks.slice(0, 2).map((pick: any) => (
                    <li class="intel-pick-item">
                      <div class="intel-pick-header">
                        <span class="intel-pick-badge">{pick.priority === "must_read" ? "今天先读" : "值得知道"}</span>
                        <a class="intel-pick-id" href={`https://arxiv.org/abs/${pick.arxiv_id}`} target="_blank" rel="noopener noreferrer">
                          arXiv:{pick.arxiv_id}
                        </a>
                      </div>
                      <h4 class="intel-pick-title">{pick.title}</h4>
                      <p class="intel-pick-insight">
                        <strong>核心突破：</strong><ReaderText text={pick.core_insight} />
                      </p>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            <div class="intel-card-footer">
              <a class="btn-primary" href="/arxiv-weekly/">
                <span>阅读本周完整周报与专题研讨</span>
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>

          <!-- Card 2: 今日高能研读雷达 (Daily Radar) -->
          <article class="intel-card intel-card-daily">
            <div class="intel-card-top">
              <div class="intel-badge-group">
                <span class="intel-badge intel-badge-daily">今日雷达 · {latestDate}</span>
                <span class="intel-batch">{radarBatchLabel}</span>
              </div>
              <a class="intel-view-all-link" href="/arxiv-daily/">查看今日雷达 →</a>
            </div>

            <h3 class="intel-card-title">
              <a href="/arxiv-daily/">今日高能瞬变学术研读雷达</a>
            </h3>

            <div class="intel-metrics-strip">
              <div class="intel-metric-item">
                <span class="intel-metric-val">{dailyStats.total_papers}</span>
                <span class="intel-metric-lbl">今日监测</span>
              </div>
              <div class="intel-metric-item highlight-must-read">
                <span class="intel-metric-val">{dailyStats.must_read_count}</span>
                <span class="intel-metric-lbl">今天先读</span>
              </div>
              <div class="intel-metric-item highlight-worth-knowing">
                <span class="intel-metric-val">{dailyStats.worth_knowing_count}</span>
                <span class="intel-metric-lbl">值得知道</span>
              </div>
              <div class="intel-metric-item highlight-skip">
                <span class="intel-metric-val">{dailyStats.skip_count}</span>
                <span class="intel-metric-lbl">快速浏览</span>
              </div>
            </div>

            <div class="intel-radar-highlights">
              <p class="intel-summary-label">今日高能瞬变重点研判候选：</p>
              {dailyMustReads.length > 0 ? (
                <ul class="intel-radar-list">
                  {dailyMustReads.map((paper: any) => (
                    <li class="intel-radar-item">
                      <div class="intel-radar-item-top">
                        <span class="intel-radar-tag tag-must-read">今天先读 (Must Read)</span>
                        <a class="intel-radar-id" href={`https://arxiv.org/abs/${paper.arxiv_id}`} target="_blank" rel="noopener noreferrer">
                          arXiv:{paper.arxiv_id}
                        </a>
                      </div>
                      <h4 class="intel-radar-paper-title">{paper.entry?.title || paper.arxiv_id}</h4>
                      <p class="intel-radar-reason">
                        <strong>分类理由：</strong><ReaderText text={paper.analysis?.reason || paper.analysis?.result || "重点高能爆发现象"} />
                      </p>
                      {paper.analysis?.result && (
                        <p class="intel-radar-result">
                          <strong>科学发现：</strong><ReaderText text={paper.analysis.result} />
                        </p>
                      )}
                    </li>
                  ))}
                </ul>
              ) : (
                <div class="intel-radar-empty">
                  <p>今日暂无符合严格爆发现象核心机制的“今天先读”候选（坚持“宁缺毋滥、严禁硬凑”原则），请浏览值得关注与背景列表。</p>
                </div>
              )}
            </div>

            <div class="intel-archives-bar">
              <span class="intel-archives-label">历史归档：</span>
              <span class="intel-archives-counts">已收录 {(archiveManifest as any).total_weeks} 周、{(archiveManifest as any).total_daily_editions} 个批次</span>
              <a class="intel-archives-link" href="/arxiv-daily/#historical-archives">浏览历史批次 →</a>
            </div>

            <div class="intel-card-footer">
              <a class="btn-secondary" href="/arxiv-daily/">
                <span>进入今日完整雷达列表 ({dailyStats.total_papers} 篇)</span>
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        </div>
      </section>

      <!-- Secondary Section Divider: Research Foundations & Causal Graph -->
      <div class="secondary-section-divider">
        <div class="secondary-divider-content">
          <span class="secondary-kicker">科研基准与因果图谱 · 长期知识库</span>
          <h2 class="secondary-title">基础文献、因果关联与学习路径</h2>
          <p class="secondary-subtitle">以 41 篇经过审核与整理的经典基准文献为基石，厘清高能天体物理思想演化的长程脉络。</p>
        </div>
      </div>

      <section class="panel home-section secondary-panel" aria-labelledby="start-here-heading">
        <p class="section-kicker">从经过审核的阅读顺序开始</p>
        <h2 id="start-here-heading">从这里开始</h2>
        {startPath ? (
          <>
            <h3><a href={learningPathReaderPath(snapshot, startPath.path_id)}>{localizedPathTitle(startPath.path_id, startPath.title ?? startPath.path_id)}</a></h3>
            <p class="original-title" lang="en">英文标题：{startPath.title ?? startPath.path_id}</p>
            <ol class="path-citations">
              {(startPath.entries ?? []).map((entry: AnyRecord, index: number) => (
                <li>
                  <span class="step-number">{index + 1}</span>
                  <a href={workReaderPath(snapshot, entry.work_id)}>{localizedWorkTitle(entry.work_id, entry.work?.title ?? entry.work_id)}</a>
                  <small>{(entry.work?.authors ?? []).map((author: AnyRecord) => author.display_name).filter(Boolean).join(", ")} · {entry.work?.release_date?.value?.slice(0, 4) ?? "年份未知"}</small>
                </li>
              ))}
            </ol>
            <p><a class="browse-link" href={learningPathReaderPath(snapshot, startPath.path_id)}>打开学习路径</a></p>
          </>
        ) : (
          <p class="empty-state">暂无经过审核的学习路径。</p>
        )}
      </section>

      <div class="home-grid">
        <section class="panel home-section" aria-labelledby="baseline-papers-heading">
          <p class="section-kicker">{baselineWorks.length} 篇基准论文</p>
          <h2 id="baseline-papers-heading">基准论文</h2>
          {baselineWorks.length === 0 ? (
            <p class="empty-state">基准文献库中暂时没有可显示论文。</p>
          ) : (
            <ol class="paper-index">
              {baselineWorks.map((work) => (
                <li class="paper-index-item">
                  <article>
                    <h3><a class="paper-title" href={workReaderPath(snapshot, work.work_id)}>{localizedWorkTitle(work.work_id, preferred(work).title)}</a></h3>
                    <p class="original-title" lang="en">英文原题：{preferred(work).title}</p>
                    <p class="paper-meta">{authors(work, true)} · {releaseYear(work)}</p>
                    <p><span class="tag">{work.reader_status === "candidate" ? "候选基准" : "已审核精选"}</span></p>
                    <p>{whyRead(work)}</p>
                    <p class="language-english" lang="en">{originalWhyRead(work)}</p>
                    <p><a class="browse-link" href={workReaderPath(snapshot, work.work_id)}>阅读论文</a></p>
                  </article>
                </li>
              ))}
            </ol>
          )}
        </section>

        <section class="panel home-section" aria-labelledby="scientific-connections-heading">
          <p class="section-kicker">{scientificEdges.length} 条科学关联</p>
          <h2 id="scientific-connections-heading">科学关联</h2>
          {scientificEdges.length === 0 ? (
            <p class="empty-state">暂无经过审核的科学关联。</p>
          ) : (
            <ul class="compact-list edge-list">
              {scientificEdges.map((edge) => {
                const source = projectedWork(edge.source_work_id);
                const target = projectedWork(edge.target_work_id);
                return (
                  <li>
                    <p>
                      <a href={workReaderPath(snapshot, edge.source_work_id)}>{localizedWorkTitle(edge.source_work_id, preferred(source).title)}</a>
                      <span class="tag">{edgeLabel(edge)}</span>
                      <a href={workReaderPath(snapshot, edge.target_work_id)}>{localizedWorkTitle(edge.target_work_id, preferred(target).title)}</a>
                      {edge.disposition === "contested" ? <strong class="dispute-indicator"> 有争议</strong> : null}
                    </p>
                    <p>{localizedEdgeReason(edge.id, edge.reason)}</p>
                    <p class="language-english" lang="en">{edge.reason}</p>
                  </li>
                );
              })}
            </ul>
          )}
        </section>
      </div>

      <section class="panel baseline-overview" aria-labelledby="baseline-heading">
        <p class="section-kicker">完整基准入口</p>
        <h2 id="baseline-heading">基准文献库</h2>
        <p>{baselineWorks.length} 篇论文、{baselineLines.length} 个研究方向、{baselinePaths.length} 条学习路径。</p>
        <p class="reader-note">其中 5 篇论文、3 个方向和 1 条路径已经审核；其余条目是本轮整理的候选基准，页面可读，等待组内审核发布。</p>
        <p>
          <a class="browse-link" href="/papers/">查看全部基准文献</a>
          <span class="inline-link"><a href="/research-lines/">浏览研究方向</a></span>
          <span class="inline-link"><a href="/learning-paths/">浏览学习路径</a></span>
        </p>
        <div class="baseline-columns">
          <section aria-labelledby="baseline-lines-heading">
            <h3 id="baseline-lines-heading">研究方向</h3>
            <ul class="compact-list baseline-links">
              {baselineLines.map((line) => (
                <li>
                  <a href={researchLineReaderPath(snapshot, line.line_id)}>{localizedLineTitle(line.line_id, line.title ?? line.line_id)}</a>
                  <span class="tag">{line.reader_status === "candidate" ? "候选基准" : "已审核"}</span>
                </li>
              ))}
            </ul>
          </section>
          <section aria-labelledby="baseline-paths-heading">
            <h3 id="baseline-paths-heading">学习路径</h3>
            <ul class="compact-list baseline-links">
              {baselinePaths.map((path) => (
                <li>
                  <a href={learningPathReaderPath(snapshot, path.path_id)}>{localizedPathTitle(path.path_id, path.title ?? path.path_id)}</a>
                  <span class="tag">{path.reader_status === "candidate" ? "候选基准" : "已审核"}</span>
                </li>
              ))}
            </ul>
          </section>
        </div>
      </section>
    </main>
  </body>
</html>
