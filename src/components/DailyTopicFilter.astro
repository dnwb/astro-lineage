  }
  :global(.daily-radar-content-wrap:has(#filter-daily-tde:checked) #worth-knowing:not(:has(.radar-list-item[data-tags*="TDE"]))) {
    display: none !important;
  }
  :global(.daily-radar-content-wrap:has(#filter-daily-tde:checked) .skip-section:not(:has(.radar-list-item[data-tags*="TDE"]))) {
