---
import dailyFeedFallback from "../../data/arxiv-daily.json";
import radarDataFallback from "../../data/daily-radar.json";
import { validateDailyRadarPayload } from "../../../scripts/daily-radar.mjs";
import { loadCanonicalContent } from "../../../scripts/content-loader.mjs";
import { projectVisibleSnapshot } from "../../../scripts/reader-projection.mjs";
import { readArxivRunState, readPublishedArxivEdition } from "../../../scripts/arxiv-daily.mjs";
import { workReaderPath } from "../../lib/reader-routes";
import SiteNav from "../../components/SiteNav.astro";
import DailyRadarPendingCard from "../../components/DailyRadarPendingCard.astro";
import DailyRadarPrioritySection from "../../components/DailyRadarPrioritySection.astro";
import DailyKnowledgePoint from "../../components/DailyKnowledgePoint.astro";
import { loadSiteConfig } from "../../lib/site-config";
import "../../styles/global.css";

type AnyRecord = Record<string, any>;

const site = loadSiteConfig();
const runtimeCwd = (globalThis as { process?: { cwd?: () => string } }).process?.cwd?.() ?? ".";
const projectPath = (...parts: string[]) => [runtimeCwd, ...parts].join("/");
const publishedEdition = await readPublishedArxivEdition({
  output: projectPath("src", "data", "arxiv-daily.json"),
  radarOutput: projectPath("src", "data", "daily-radar.json"),
  artifactRoot: projectPath(".cache", "arxiv-daily"),
  fallbackFeed: dailyFeedFallback,
  fallbackRadar: radarDataFallback,
} as any);
const dailyFeed = publishedEdition.feed;
const radarData = publishedEdition.radar;
const radarValidation = validateDailyRadarPayload(dailyFeed, radarData);
if (!radarValidation.valid) {
  throw new Error(`Daily Radar payload is invalid: ${radarValidation.diagnostics.join(", ")}`);
}
const model = radarValidation.model;
const runState = await readArxivRunState();
const snapshot = await loadCanonicalContent(new URL("../../../content/", import.meta.url));
const visibleReader = projectVisibleSnapshot(snapshot) as AnyRecord;
const visibleWorkLinks = Object.fromEntries(
  (visibleReader.works ?? []).map((work: AnyRecord) => [
    work.work_id,
    { href: workReaderPath(snapshot, work.work_id), title: work.preferred_version?.title ?? work.work_id },
  ]),
);

const generatedAt = new Date(model.edition.generated_at ?? "");
const generatedLabel = Number.isNaN(generatedAt.valueOf())
  ? "尚未刷新"
  : generatedAt.toLocaleString("zh-CN", { timeZone: "Asia/Shanghai" });

function stateTime(value: string | undefined) {
  const date = new Date(value ?? "");
  return Number.isNaN(date.valueOf()) ? "时间未记录" : date.toLocaleString("zh-CN", { timeZone: "Asia/Shanghai" });
}

const runStateLabel = runState.read_error
  ? `运行状态不可读：${runState.read_error.message}`
  : runState.status === "running"
    ? "正在刷新，当前页面继续展示上一次缓存。"
    : runState.status === "success"
      ? `最近一次刷新成功于 ${stateTime(runState.last_success?.finished_at)}`
      : runState.status === "failed"
        ? `最近一次刷新失败于 ${stateTime(runState.last_failure?.finished_at)}：${runState.last_failure?.error?.message ?? "原因未记录"}${runState.last_failure?.output_published ? "；当前缓存已发布，本次状态收尾仍待修复。" : "；当前缓存保留上一次成功版本。"}`
        : "此环境尚未运行刷新，当前页面使用随站点发布的缓存。";

const englishRunStateLabel = runState.read_error
  ? `Run state unavailable: ${runState.read_error.message}`
  : runState.status === "running"
    ? "A refresh is running; this page continues to show the last cached edition."
    : runState.status === "success"
      ? `Last refresh succeeded at ${stateTime(runState.last_success?.finished_at)}`
      : runState.status === "failed"
        ? `Last refresh failed at ${stateTime(runState.last_failure?.finished_at)}: ${runState.last_failure?.error?.message ?? "reason not recorded"}${runState.last_failure?.output_published ? "; the new cache was published, but state finalization needs repair." : "; the previous successful cache remains active."}`
        : "This environment has not run a refresh; the page uses the cache shipped with the site.";

function pendingLabel(reason: string) {
  return {
    analysis_missing: "尚未分析",
    analysis_failed: "分析失败",
    analysis_invalid: "分析记录无效",
    source_changed: "来源已变化，旧导读失效",
    analysis_revision_mismatch: "版本不匹配，旧导读失效",
  }[reason] ?? "待核查";
}

const priorityGroups = model.groups as AnyRecord;
const isAnnouncementDay = ["announcement_day", "announcement_batch"].includes(model.edition.coverage_kind);
const announcementWindow = model.edition.window as AnyRecord | undefined;
const coverageLabel = isAnnouncementDay
  ? `公告批次窗口 ${announcementWindow?.announcement_date ?? "未记录"}（${announcementWindow?.time_zone ?? "America/New_York"}，截止 ${announcementWindow?.cutoff_local_time ?? "14:00"}）`
  : "最近提交样本";

---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Daily Radar 首期缓存版：按阅读优先级整理的 arXiv 论文和有证据边界的科学导读。" />
    <title>Daily Radar · {site.title}</title>
  </head>
  <body>
    <main class="site-shell index-page reader-page radar-page">
      <SiteNav />
      <p class="eyebrow"><a href="/">{site.title}</a> · Daily Radar</p>
      <header class="reader-header">
        <h1><span class="language-primary">{isAnnouncementDay ? "Daily Radar 公告日导读" : "Daily Radar 首期导读"}</span><span class="language-english" lang="en">{isAnnouncementDay ? "Daily Radar: announcement-day edition" : "Daily Radar: first cached edition"}</span></h1>
        <p class="reader-deck language-primary">先决定今天读什么，再展开查看问题、假设、结果边界和实际阅读范围。</p>
        <p class="reader-deck language-english" lang="en">Choose what to read first, then open the guide for its problem, assumptions, limits, and actual reading coverage.</p>
        <p class="record-label language-primary">缓存范围：{coverageLabel} · 最近刷新：{generatedLabel} · 候选 {model.counts.total} 篇 · 已分析 {model.counts.analyzed} / {model.counts.total} · 待分析 {model.counts.pending}</p>
        <p class="record-label language-english" lang="en">Cache scope: {isAnnouncementDay ? `announcement batch ending ${announcementWindow?.announcement_date ?? "unrecorded"} (${announcementWindow?.time_zone ?? "America/New_York"})` : "recent-submission sample"} · refreshed {generatedLabel} · {model.counts.total} candidates · analyzed {model.counts.analyzed} / {model.counts.total} · pending {model.counts.pending}</p>
        <p class="record-label language-primary">运行状态：{runStateLabel}</p>
        <p class="record-label language-english" lang="en">Run state: {englishRunStateLabel}</p>
        <p class="record-label">Query: {model.edition.query ?? "未记录"}</p>
      </header>

      <section class="panel radar-overview">
        <p class="section-kicker">本期判断 / Edition note</p>
        {isAnnouncementDay ? (
          <>
            <p class="language-primary">这是按 America/New_York 公告批次截止点获取的 arXiv 提交窗口（公告日 {announcementWindow?.announcement_date ?? "日期未记录"}，{announcementWindow?.submission_start_date ?? "起点未记录"} 14:00 至 {announcementWindow?.submission_end_date ?? "终点未记录"} 14:00）。优先级是相对于当前组内阅读焦点的安排，不是论文质量评分；分析缺失单独显示为待分析。</p>
            <p class="language-english" lang="en">This edition covers the arXiv submission batch ending at the America/New_York cutoff for announcement date {announcementWindow?.announcement_date ?? "not recorded"}. Priorities are relative reading guidance, not paper-quality scores; missing analysis remains pending.</p>
          </>
        ) : (
          <>
            <p class="language-primary">这是现有 arXiv API 缓存中的最近提交样本，不是完整的当日新增集合。优先级是相对于当前组内阅读焦点的安排，不是论文质量评分；分析缺失单独显示为待分析。</p>
            <p class="language-english" lang="en">This is a recent-submission sample from the existing arXiv API cache, not a complete daily intake. Priorities are relative reading guidance, not paper-quality scores; missing analysis remains pending.</p>
          </>
        )}
      </section>

      <DailyRadarPrioritySection
        id="must-read"
        items={priorityGroups.must_read}
        primaryLabel="今天先读"
        englishLabel="Must Read"
        visibleWorkLinks={visibleWorkLinks}
      />
      <DailyRadarPrioritySection
        id="worth-knowing"
        items={priorityGroups.worth_knowing}
        primaryLabel="值得知道"
        englishLabel="Worth Knowing"
        visibleWorkLinks={visibleWorkLinks}
      />

      <section class="radar-section" id="knowledge-points">
        <p class="section-kicker">学习补充 / Learning supplement</p>
        <h2><span class="language-primary">今日知识点</span><span class="language-english" lang="en">Knowledge point</span></h2>
        {model.knowledge_points.length > 0 ? (
          model.knowledge_points.map((point) => (
            <>
              <div class="language-primary"><DailyKnowledgePoint point={point} /></div>
              <p class="language-english" lang="en">This knowledge point is written in Chinese and is bound to {point.source.source_version}. Open the original source: <a href={point.source_references[0].url}>arXiv source</a>.</p>
            </>
          ))
        ) : (
          <p class="empty-state">本期没有具备充分来源的知识点；不会用未核查材料填充。</p>
        )}
        {model.knowledge_points_pending.length > 0 ? (
          <p class="layer-intro">有 {model.knowledge_points_pending.length} 个知识点记录待核查。</p>
        ) : null}
      </section>

      <section class="radar-section" id="pending-analysis">
        <p class="section-kicker">分析状态 / Analysis status</p>
        <h2><span class="language-primary">待分析</span><span class="language-english" lang="en">Pending analysis</span></h2>
        <p class="layer-intro">未分析、失败、版本不匹配或来源变化不会被归入 Skip。</p>
        <ol class="paper-index radar-list">
          {model.pending.map((item) => <DailyRadarPendingCard item={item} pendingLabel={pendingLabel(item.pending_reason)} />)}
        </ol>
      </section>

      <details class="radar-priority-section skip-section">
        <summary><span class="language-primary">其余候选 · Skip（默认收起）</span><span class="language-english" lang="en">Remaining candidates · Skip (collapsed by default)</span></summary>
        <DailyRadarPrioritySection
          id="skip"
          items={priorityGroups.skip}
          primaryLabel="其余候选"
          englishLabel="Skip"
          visibleWorkLinks={visibleWorkLinks}
        />
      </details>
    </main>
  </body>
</html>
