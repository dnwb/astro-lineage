---
import ReaderText from "./ReaderText.astro";
import eventsData from "../data/scientific-events.json";
import { formatAnnouncementInBeijing, parseTransientEpoch } from "../domain/academic-domain.mjs";

interface Props {
  maxEvents?: number;
  title?: string;
  titleEnglish?: string;
  subtitle?: string;
}

const {
  maxEvents = 5,
  title = "瞬变源科学事件追踪与脉络聚簇",
  titleEnglish = "Transient Event Clustering & Timeline Radar",
  subtitle = "基于 arXiv 预印本自动识别引力波、超新星、伽马暴与快速射电暴等重大天文瞬变事件，按衰减热度聚簇多篇跟进论文并梳理演化脉络。",
} = Astro.props;

type ScientificEvent = (typeof eventsData.events)[number];

const events: ScientificEvent[] = (eventsData.events || []).slice(0, maxEvents);

function typeBadgeColor(type: string): string {
  switch (type.toUpperCase()) {
    case "GW":
      return "badge-gw";
    case "GRB":
      return "badge-grb";
    case "SN":
      return "badge-sn";
    case "FRB":
      return "badge-frb";
    case "AT":
      return "badge-at";
    default:
      return "badge-other";
  }
}

function priorityPill(priority: string) {
  if (priority === "must_read") return { label: "⭐ 必读", cls: "pill-must-read" };
  if (priority === "worth_knowing") return { label: "📌 关注", cls: "pill-worth-knowing" };
  return { label: "⚡ 略读", cls: "pill-skim" };
}
---

<section class="scientific-events-section" aria-labelledby="scientific-events-heading">
  <div class="events-section-header">
    <div class="events-badge-row">
      <div class="events-badge-left">
        <span class="events-kicker-tag">🔭 瞬变源追踪</span>
        <span class="events-kicker-sub">半衰期热度衰减算法 · 多篇聚簇</span>
      </div>
      <a href="/events/" class="events-explore-link">📅 浏览全部 68 个爆发事件日历 →</a>
    </div>
    <h2 id="scientific-events-heading" class="events-main-title">
      <span class="title-primary">{title}</span>
      <span class="title-english" lang="en">{titleEnglish}</span>
    </h2>
    <p class="events-subtitle">{subtitle}</p>
  </div>

  <div class="events-grid">
    {events.map((event) => {
      const topMustRead = event.papers.find((p) => p.priority === "must_read");
      const epoch = parseTransientEpoch(event.event_id);
      return (
        <article class="event-cluster-card" id={`event-${event.event_id.toLowerCase().replace(/\s+/g, "-")}`}>
          <!-- Card Header -->
          <div class="event-card-header">
            <div class="event-id-group">
              <span class={`event-type-badge ${typeBadgeColor(event.event_type)}`}>{event.event_type}</span>
              <h3 class="event-target-id">{event.event_id}</h3>
              {epoch && (
                <span class="event-epoch-tag" title="天体物理爆发/探测时间戳">
                  ⚡ 爆发：{epoch}
                </span>
              )}
            </div>
            <div class="event-metrics-group">
              <span class="metric-heat-badge" title="基于7天半衰期模型计算的时间衰减热度指数">
                🔥 热度 <strong>{event.heat_score}</strong>
              </span>
              <span class="metric-count-badge">
                📚 <strong>{event.paper_count}</strong> 篇研读
              </span>
            </div>
          </div>

          <!-- Structured Headline & Narrative -->
          <div class="event-synthesis-box">
            <h4 class="event-headline">{event.headline}</h4>
            <p class="event-narrative-text">
              <ReaderText text={event.narrative} />
            </p>
          </div>

          <!-- Chronological Papers Timeline -->
          <div class="event-timeline-container">
            <div class="timeline-header-row">
              <span class="timeline-title">📄 聚簇研读论文与学术演进：</span>
              <span class="timeline-span-badge">活跃：{event.first_seen} 至 {event.last_updated}</span>
            </div>

            <ul class="event-papers-list">
              {event.papers.map((paper) => {
                const priorityInfo = priorityPill(paper.priority);
                const dailyCardAnchor = `/arxiv-daily/${paper.date}/#card-${paper.arxiv_id}-v${paper.revision || 1}`;
                return (
                  <li class={`event-paper-node node-${paper.priority}`}>
                    <div class="node-meta-row">
                      <span class={`paper-priority-pill ${priorityInfo.cls}`}>{priorityInfo.label}</span>
                      <span class="paper-date-tag">📅 {formatAnnouncementInBeijing(paper.date).beijingDate}</span>
                      <div class="paper-links-cluster">
                        <a class="anchor-link-guide" href={dailyCardAnchor} title="直接跳转至当日精读学术卡片">
                          📖 精读导读 →
                        </a>
                        <a class="anchor-link-arxiv" href={`https://arxiv.org/abs/${paper.arxiv_id}`} target="_blank" rel="noopener noreferrer">
                          arXiv:{paper.arxiv_id} ↗
                        </a>
                        <a class="anchor-link-pdf" href={`https://arxiv.org/pdf/${paper.arxiv_id}`} target="_blank" rel="noopener noreferrer" title="下载官方 PDF">
                          📄 PDF
                        </a>
                      </div>
                    </div>

                    <h5 class="event-paper-title">
                      <a href={dailyCardAnchor}>
                        <ReaderText text={paper.title || paper.arxiv_id} />
                      </a>
                    </h5>

                    {paper.bluf_result && !paper.bluf_result.startsWith("未能从已检查材料") && paper.bluf_result !== "未记录" && (
                      <div class="paper-bluf-brief">
                        <span class="bluf-accent-mark">突破</span>
                        <p class="bluf-accent-body">
                          <ReaderText text={paper.bluf_result} />
                        </p>
                      </div>
                    )}
                  </li>
                );
              })}
            </ul>
          </div>
        </article>
      );
    })}
  </div>

  <div class="events-section-footer">
    <a href="/events/" class="events-calendar-btn">
      <span>进入完整爆发日历与演化时间轴 (共 68 个事件)</span>
      <span aria-hidden="true">→</span>
    </a>
  </div>
</section>

