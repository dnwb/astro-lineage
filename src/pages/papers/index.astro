---
import { loadCanonicalContent } from "../../../scripts/content-loader.mjs";
import "../../styles/global.css";

const snapshot = await loadCanonicalContent(new URL("../../../content/", import.meta.url));
const visibleWorks = snapshot.works.map((work) => {
  const files = work.files as Record<string, any>;
  const workRecord = files["work.yaml"] as { reader_state?: string; preferred_version?: { version_id?: string } };
  const versionsRecord = files["versions.yaml"] as { versions?: Array<{ id?: string; title?: string }> };
  const preferred = versionsRecord.versions?.find(
    (version) => version.id === workRecord.preferred_version?.version_id,
  );
  return { id: work.id, readerState: workRecord.reader_state, title: preferred?.title ?? work.id };
}).filter((work) => work.readerState === "visible");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="The visible Papers in the High-Energy Transient Reading Radar."
    />
    <title>Papers · High-Energy Transient Reading Radar</title>
  </head>
  <body>
    <main>
      <p class="eyebrow"><a href="/">High-Energy Transient Reading Radar</a></p>
      <h1>Papers</h1>
      {
        visibleWorks.length === 0 ? (
          <p class="empty-state">No Papers are visible in the curated reading radar yet.</p>
        ) : (
          <ul class="paper-list">
            {visibleWorks.map((work) => (
              <li><a href={`/papers/${work.id}/`}>{work.title}</a></li>
            ))}
          </ul>
        )
      }
    </main>
  </body>
</html>
