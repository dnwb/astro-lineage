{
  "name": "astro-lineage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "dev": "node scripts/validate.mjs && astro dev",
    "arxiv:refresh": "node scripts/arxiv-daily.mjs",
    "arxiv:replay": "node scripts/arxiv-daily.mjs --replay",
    "arxiv:schedule": "node scripts/arxiv-daily-scheduler.mjs",
    "arxiv:analyze": "node scripts/arxiv-ai-analyzer.mjs",
    "arxiv:weekly": "node scripts/arxiv-weekly-summary.mjs",
    "arxiv:archive": "node scripts/arxiv-archive.mjs",
    "validate": "node scripts/validate.mjs",
    "pretest": "node scripts/cleanup-test-tmp.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "posttest": "node scripts/cleanup-test-tmp.mjs",
    "check": "astro check",
    "build": "npm run validate && node scripts/editorial-index.mjs && astro build",
    "verify": "npm run validate && npm run test && npm run check && npm run build"
  },
  "dependencies": {
    "astro": "6.4.8",
    "katex": "0.16.25",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "qq-guild-bot": "^2.9.5",
    "typescript": "6.0.3"
  }
}
