---
import GuideProblemMethod from "./guide/GuideProblemMethod.astro";
import GuidePhysicsModel from "./guide/GuidePhysicsModel.astro";
import GuideAcademicLineage from "./guide/GuideAcademicLineage.astro";
import GuideEvidenceAudit from "./guide/GuideEvidenceAudit.astro";
import { projectPotentialLineage } from "../../scripts/daily-radar.mjs";

type AnyRecord = Record<string, any>;

interface Props {
  item: AnyRecord;
  visibleWorkLinks: Record<string, { href: string; title: string }>;
}

const { item, visibleWorkLinks } = Astro.props;
const record = item.analysis as AnyRecord;
const guide = record.analysis as AnyRecord;
const coverage = record.coverage as AnyRecord;
const lineage = projectPotentialLineage(guide.potential_lineage, Object.keys(visibleWorkLinks)) as AnyRecord;
const method = typeof guide.method === "string" && guide.method.trim() !== "" ? guide.method : null;
const figures = Array.isArray(guide.figures || record.figures) ? (guide.figures || record.figures) : [];

const coverageSummaryEnglish: Record<string, string> = {
  abstract_only: "abstract only",
  body_partial: "identified body sections",
  full_body: "full body",
};
const coverageSummary = coverageSummaryEnglish;
const resultSectionLabel = coverage.level === "abstract_only" ? "Abstract-reported results and limits" : "Author-reported results and limits";
const resultSectionLabelEnglish = resultSectionLabel;
---

<div class="radar-guide" id={`deep-dive-${item.arxiv_id.replace(/\./g, "-")}`}>
  <!-- Reading scope bar (compact single line, method and mechanism) -->
  <div class="radar-guide-summary-bar">
    <div class="summary-left">
      <span class="guide-summary-badge">📖 Deep Reading</span>
      <span class="guide-summary-focus">Core Problem · Method & Mechanism · Physical Model · Academic Lineage</span>
    </div>
    <span class="guide-summary-coverage">
      Coverage: <strong>{coverageSummary[coverage.level] ?? "recorded"}</strong> · {coverage.label}
    </span>
  </div>

  <!-- 3 Core Academic Modules: full-width stream layout -->
  <div class="radar-guide-modules-grid">
    <!-- Module 1: Core Problem, Method & Mechanism, Entry Suggestions -->
    <GuideProblemMethod
      problem={guide.problem}
      method={guide.method}
      readingEntry={guide.reading_entry}
    />

    <!-- Module 2: Physical Assumptions, Core Figures, and Reported Results -->
    <GuidePhysicsModel
      assumptions={guide.assumptions}
      figures={figures}
      result={record.analysis.result || guide.result}
      problem={guide.problem}
      limits={guide.limits}
      resultSectionLabel={resultSectionLabel}
      resultSectionLabelEnglish={resultSectionLabelEnglish}
    />

    <!-- Module 3: Lineage, Progress Comparison, and Prerequisites -->
    <GuideAcademicLineage
      arxivId={item.arxiv_id}
      revision={item.revision}
      lineage={lineage}
      visibleWorkLinks={visibleWorkLinks}
      prerequisites={guide.prerequisite_works}
      researchProgress={guide.research_progress}
      citationLeads={guide.citation_leads}
    />
  </div>

  <!-- Evidence Audit & Source Materials -->
  <div class="radar-guide-audit-tray">
    <GuideEvidenceAudit
      coverage={coverage}
      origin={guide.origin}
      analyzedAt={guide.analyzed_at}
      unresolvedChecks={guide.unresolved_checks}
    />
  </div>
</div>

<style>
  .radar-guide {
    margin-top: 0.35rem;
    padding-top: 0.2rem;
  }
  .radar-guide-summary-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem;
    padding: 0.3rem 0.65rem;
    background: #f1f5f9;
    border: 1px solid #cbd5e1;
    border-radius: 0.35rem;
    margin-bottom: 0.5rem;
    font-size: 0.78rem;
  }
  :global([data-theme="dark"]) .radar-guide-summary-bar {
    background: #1e293b;
    border-color: #334155;
    color: #e2e8f0;
  }
  .summary-left {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }
  .guide-summary-badge {
    font-weight: 700;
    color: #0f172a;
  }
  :global([data-theme="dark"]) .guide-summary-badge {
    color: #f8fafc;
  }
  .guide-summary-focus {
    color: #64748b;
    font-size: 0.74rem;
  }
  :global([data-theme="dark"]) .guide-summary-focus {
    color: #94a3b8;
  }
  .guide-summary-coverage {
    color: #475569;
    font-size: 0.74rem;
  }
  :global([data-theme="dark"]) .guide-summary-coverage {
    color: #94a3b8;
  }
  .guide-summary-coverage strong {
    color: #0f172a;
  }
  :global([data-theme="dark"]) .guide-summary-coverage strong {
    color: #f1f5f9;
  }
  /* Single-column streaming layout */
  .radar-guide-modules-grid {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    width: 100%;
  }
  .radar-guide-audit-tray {
    margin-top: 0.45rem;
  }
</style>
